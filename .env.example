# .env.example — the committed template. Copy to a gitignored .env and fill real values; never
# commit .env itself. (TBG-TRACKER-CONF: adds the tracker credential variables below.)

# --- Tracker credentials (TBG-TRACKER-CONF) ---------------------------------------------------
# Backend-neutral (Linear reuses these too, design §5). Credentials are ENV ONLY — never stamp
# them into .kit/tracker.conf, which carries no secret. See JIRA-SETUP.md (stamped into your
# project by `incept --backlog jira`; in the kit tree it is templates/JIRA-SETUP-TEMPLATE.md) and
# docs/architecture/2026-09-19-tracker-backed-governance-design.md §5.
# KIT_TRACKER_USER=you@example.com
# KIT_TRACKER_TOKEN=replace-me

# Legacy aliases honoured by conformance/tracker-contract.sh when the KIT_TRACKER_* pair above is
# unset (do not set both pairs to different values — KIT_TRACKER_* wins if present):
# JIRA_EMAIL=you@example.com
# JIRA_TOKEN=replace-me

# Read by the write verbs (sparkwright board ...) only, default basic; set bearer on Data Center
# (DS-5). The conf's own auth= key governs reads independently of this variable.
# KIT_TRACKER_AUTH=basic|bearer

# JIRA_BASE_URL is intentionally NOT read by the conf-backed path — the host is pinned in
# .kit/tracker.conf (base_url=), never in an env var (design §5: an unpinned env base URL would
# let a compromised environment repoint the SSRF-sensitive host silently).
