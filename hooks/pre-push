#!/bin/sh
# pre-push — kit runtime guard for git (any runtime + humans). Sources the shared
# deny-matrix core and blocks force-push / push-to-main BEFORE the network round-trip.
# Deliberate override: git push --no-verify. A SPEED BUMP, not a boundary
# (docs/enterprise/platform-safety-boundary.md). Run `sh hooks/pre-push --selftest` to test.
# Fails CLOSED if the core is missing, unreadable, or does not define the matrix: the
# push is REFUSED with recovery instructions, never allowed unprotected. A guard that
# can be disarmed by deleting one file is not a rung anything can be built on; the same
# core-resolution contract (KIT_GUARD_CORE + a default) in scripts/kit-guard:18-19 has
# always failed closed.
# RESIDUAL — arbitrary core CONTENT, including a core that exits during sourcing: that
# is not reachable by truncation, and it still exits 0 SILENTLY (measured). Core
# integrity is git's job (a tracked file + review), not this hook's.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ROOT=.
CORE="${KIT_GUARD_CORE:-$ROOT/.claude/hooks/guard-core.sh}"
refuse_no_core() { # reason — refuse the push and name the recovery (never a bypass)
  # printf, NEVER echo: on dash (Linux CI's /bin/sh) and bash-as-/bin/sh, echo expands
  # backslash escapes, so a crafted CORE path can INJECT lines into this fail-closed
  # refusal — including the one string this path must never carry (`--no-verify`) — and
  # a plain Windows path (C:\nfs\core.sh) mangles it with no attacker at all. Measured.
  # RESIDUAL, disclosed not hidden (review round 2): CORE is still echoed VERBATIM as
  # diagnostics — deliberately, since which path failed is the message's most useful fact —
  # so a caller who sets it may make that substring appear INSIDE the parentheses on the
  # reason line. What this path guarantees is narrower and is the property that matters:
  # no forged instruction LINE. Sanitizing CORE would trade the diagnostic for a cosmetic
  # win against an actor who already has --no-verify, one documented flag away.
  printf '%s\n' "kit pre-push: $1 ($CORE) — REFUSING the push." >&2
  printf '%s\n' "  recovery: the core is a tracked file — from the repo root, restore it with" >&2
  printf '%s\n' "            git checkout HEAD -- .claude/hooks/guard-core.sh" >&2
  printf '%s\n' "            (if .claude/ is sparse-excluded: git sparse-checkout add .claude)" >&2
  printf '%s\n' "  or, if this repo is meant to run without the kit guard, uninstall this hook deliberately." >&2
  exit 1
}
if [ ! -f "$CORE" ] || [ ! -r "$CORE" ]; then
  refuse_no_core "guard-core.sh not found or not readable"
fi
# shellcheck disable=SC1090  # dynamic source path; readability checked above
. "$CORE"
# `command -v guard_check_push >/dev/null` is ALSO satisfied by a PATH BINARY of that
# name — measured: an empty core + such a binary exiting 0 allowed a push to main. Match
# the OUTPUT instead: a shell function prints the bare name, a binary prints a path.
case "$(command -v guard_check_push 2>/dev/null)" in
  guard_check_push) : ;;
  *) refuse_no_core "guard-core.sh sourced but defines no guard_check_push function" ;;
esac

# _kit_dial "<DIAL_NAME>" — SETS `_kd_mode` to the word `enforce` or `observe` for this push, from
# guard-core's kit_dial_mode (repo-carried $ROOT/.kit/dials.conf; env may ESCALATE, never
# de-escalate — DIAL-DELIVERY Δ-A). All three legs below call it; the durable dial is the CONF.
#
# ⚠️ IT SETS A VARIABLE RATHER THAN PRINTING, AND THAT IS LOAD-BEARING (review round 1, measured).
# The call sites used to read it as `[ "$(_kit_dial X)" = enforce ]`, which runs the resolver in a
# SUBSHELL — so kit_dial_mode's own per-dial "already warned" memo could never propagate back, and a
# 3-ref-line push under a de-escalation attempt printed the identical anomaly line THREE times
# (measured: 3, then still 3 with the in-function memo alone). That is the same line-discipline
# defect go_relay's ONE-RELAY-PER-INVOCATION rule exists to prevent. Resolving into a variable keeps
# the resolver in THIS shell, so the per-invocation cache below actually holds. Same idiom as the GO
# leg's REV M6 `_go_memo`: the value depends only on tree state and the environment, neither of which
# changes between the ref-lines of one push. Timing is unchanged — a dial is still resolved lazily,
# on FIRST consult, never on a push where no leg fires.
# SKEW: a re-copied newer hook over an OLDER tree guard-core that predates kit_dial_mode must not
# spray "command not found" on every push. Probe it exactly as guard_check_push is probed at :42 —
# matching the OUTPUT, since `command -v` is also satisfied by a PATH BINARY of that name — and fall
# back QUIETLY to the bare env read, which is the pre-Δ-A behaviour: fail-open toward observe, the
# acceptable direction, now guarded and silent instead of noisy.
_kit_dial_resolve() { # <DIAL_NAME> — prints enforce|observe; the skew-guarded reader
  case "$(command -v kit_dial_mode 2>/dev/null)" in
    kit_dial_mode) kit_dial_mode "$1" ;;
    *)
      # The name is interpolated into an eval, so charset-guard it here exactly as kit_dial_mode
      # does on its own side — the fallback must not be the weaker of the two paths.
      case "$1" in ''|*[!A-Z0-9_]*) printf 'observe\n'; return 0 ;; esac
      _kd_env=$(eval "printf '%s' \"\${$1:-}\"")
      if [ "$_kd_env" = "enforce" ]; then printf 'enforce\n'; else printf 'observe\n'; fi ;;
  esac
}
_kit_dial() { # <DIAL_NAME> — sets _kd_mode; resolves each dial at most ONCE per push invocation
  case "$1" in
    KIT_PUSH_DECL)
      [ -n "${_kd_decl:-}" ] || _kd_decl=$(_kit_dial_resolve "$1")
      _kd_mode=$_kd_decl ;;
    KIT_PUSH_GO)
      [ -n "${_kd_go:-}" ] || _kd_go=$(_kit_dial_resolve "$1")
      _kd_mode=$_kd_go ;;
    KIT_PUSH_CITE)
      [ -n "${_kd_cite:-}" ] || _kd_cite=$(_kit_dial_resolve "$1")
      _kd_mode=$_kd_cite ;;
    KIT_PUSH_PRESENCE)
      [ -n "${_kd_pres:-}" ] || _kd_pres=$(_kit_dial_resolve "$1")
      _kd_mode=$_kd_pres ;;
    *) _kd_mode=$(_kit_dial_resolve "$1") ;;
  esac
}

# decl_check_ref — B1: the entry-declaration leg. Runs conformance/loop-state.sh --head against the
# HEAD of each pushed refs/heads/* line (design Δ1: head-of-ref, not per-commit — identical SHA to
# what CI grades as the PR head, so drift is impossible by construction). Defined ABOVE the
# --selftest marker as convention + future-proofing only — this file's path (hooks/pre-push) is NOT
# a `conformance/[a-z0-9-]+\.sh` token, so non-vacuity.sh's sweep CANNOT reach it regardless of
# placement (measured; see the row comment in conformance/verify.sh). This leg's real kill-coverage
# is the selftest's own positive control (a normal branch line must invoke the predicate) plus the
# discriminating negative cases (D1 skip rules, D2 degradation, D3 verdict handling) below the
# marker — not the sweep.
# THE DIAL IS REPO-CARRIED (DIAL-DELIVERY Δ-A): `KIT_PUSH_DECL=enforce` (exact string) in the tracked,
# control-plane, export-ignored .kit/dials.conf refuses instead of observing; an absent file — the
# adopter export's state — is observe. Read through _kit_dial -> guard-core's kit_dial_mode, whose
# precedence is ASYMMETRIC: an env var of the same name may ESCALATE observe->enforce, never
# de-escalate a conf enforce (it loses and says so). Changing the dial is a conf edit through the
# ratified ceremony: no hook edit, NO human re-copy — this hook reads tree state live. A speed
# bump, not a boundary — --no-verify, an absent/never-installed hook, a stale installed copy, or an
# absent predicate script all bypass this leg
# (docs/architecture/2026-08-05-b1-pre-push-entry-declaration-design.md §7).
decl_check_ref() { # local_ref local_sha remote_ref remote_sha
  _decl_local_sha=$2
  _decl_remote_ref=$3
  # D1 — dispatch: skip anything that is not a branch update this predicate can grade.
  case "$_decl_remote_ref" in
    refs/heads/*) : ;;
    *) return 0 ;;                                  # tags, notes, etc. — not a branch push
  esac
  case "$_decl_local_sha" in
    *[!0]*) : ;;
    *) return 0 ;;                                  # all-zero local_sha — a deletion, nothing to grade
  esac
  case "$_decl_remote_ref" in
    refs/heads/main | refs/heads/master) return 0 ;; # Δ2 — trunk squash commits carry no trailers
  esac
  # Defense-in-depth: a genuine push local_sha is always a hex object id. Reject (silently skip)
  # anything else so an option-like value (e.g. a string starting with "-") can never reach the
  # predicate's argv — belt-and-suspenders alongside D1's own dispatch narrowing above.
  case "$_decl_local_sha" in
    *[!0-9a-fA-F]*) return 0 ;;
  esac
  # D2 — degradation: an absent/unreadable predicate N/As silently (first-run-green on adopter trees).
  _decl_predicate="$ROOT/conformance/loop-state.sh"
  [ -f "$_decl_predicate" ] && [ -r "$_decl_predicate" ] || return 0
  # Capture stderr only (the predicate's reasons); its stdout success line is not this leg's business.
  # </dev/null: this runs inside the caller's stdin `while read` loop over the git push protocol
  # lines. Without isolating the child's stdin, a predicate that reads stdin (deliberately or by
  # accident) can consume the loop's remaining push-protocol lines before this leg ever returns —
  # fail-open past the guard leg for every ref-line after the one being graded (measured: SEC
  # MEDIUM-1, killed by the selftest's stdin-isolation case below).
  if _decl_out=$(sh "$_decl_predicate" --head "$_decl_local_sha" 2>&1 >/dev/null </dev/null); then
    # D3 — rc 0: PASS. [A2, B9 §10-A2] This path used to capture the predicate's stderr and drop it
    # on the floor, so a warning from a PASSING predicate was silently swallowed. Relay it and stay
    # rc 0. Conditional on non-empty: a clean pass must not print a bare prefix line.
    # THE PREFIX IS MODE-NEUTRAL `(note)`, NOT `(observe)` (review round 1). `(observe)` names the
    # DIAL's state, and on an enforcing tree this path is reached with the dial set to `enforce` —
    # so relaying a pass under `(observe)` would tell the operator the dial is off when it is on.
    # The nonzero branch below keeps `(observe)`, where it is true and load-bearing (the adopter
    # export's behavioural leg keys on that exact string).
    # Measured noise cost: zero (3 real passing heads, 0 stderr lines).
    if [ -n "$_decl_out" ]; then
      printf '%s\n' "$_decl_out" | while IFS= read -r _decl_line; do
        printf 'kit pre-push (note): %s\n' "$_decl_line" >&2
      done
    fi
    return 0
  fi
  # D3 — nonzero (rc 1 AND rc 2, fail-closed on could-not-evaluate): observe prints and allows;
  # enforce prints and refuses. Δ3 — the exact string "enforce"; anything else stays observe.
  # Δ-A: the dial is read from .kit/dials.conf via _kit_dial (env escalates only), not from bare env.
  _kit_dial KIT_PUSH_DECL
  if [ "$_kd_mode" = "enforce" ]; then
    # [-n check] a predicate that fails closed with no stderr (e.g. rc 2, could-not-evaluate,
    # with nothing printed) must not relay a bare "kit pre-push: " line with no reason on it.
    if [ -n "$_decl_out" ]; then
      printf '%s\n' "$_decl_out" | while IFS= read -r _decl_line; do
        printf 'kit pre-push: %s\n' "$_decl_line" >&2
      done
    fi
    printf 'kit pre-push:   remedy: fix the trailer block on the pushed head. WHAT IS REQUIRED\n' >&2
    printf 'kit pre-push:            DEPENDS ON THE CHANGE CLASS: ordinary -> Kit-Row + Kit-Class;\n' >&2
    printf 'kit pre-push:            sensitive/control-plane -> those two plus Kit-Stage + Kit-Skill.\n' >&2
    printf 'kit pre-push:            A field you volunteer is still validated. git commit --amend,\n' >&2
    printf 'kit pre-push:            then push again.\n' >&2
    printf '  override (deliberate): git push --no-verify\n' >&2
    return 1
  fi
  if [ -n "$_decl_out" ]; then
    printf '%s\n' "$_decl_out" | while IFS= read -r _decl_line; do
      printf 'kit pre-push (observe): %s\n' "$_decl_line" >&2
    done
  fi
  printf 'kit pre-push (observe):   dial: the DURABLE switch is KIT_PUSH_DECL=enforce in .kit/dials.conf\n' >&2
  printf 'kit pre-push (observe):         (tracked, control-plane, effective at merge — no hook re-copy). An env\n' >&2
  printf 'kit pre-push (observe):         var of the same name can only ESCALATE, for this session.\n' >&2
  return 0
}

# go_check_ref — B2: the design-GO leg. For a Sensitive/Control-plane push, runs the SAME predicate
# CI backstops — `conformance/ceremony-binding.sh --pre-push` — against the local GO ledger.
# Δ1′ (owner ruling D11): that predicate matches `^gate: design$` AND `scope: branch/<current>`,
# where the branch key is derived by the predicate's OWN prepush_scope_key(). ⚠️ THIS HOOK MUST NOT
# RE-DERIVE THE BRANCH. D11's trap warning is binding and ceremony-binding.sh already refused a
# sixth derivation site once (its header, "CLASS IS DERIVED BY A SINGLE AUTHORITY"): two copies of
# a key are defect-compatible only until they drift, and nothing locks them together. The hook
# passes no key and reads no branch — it relays the predicate's verdict, whose text names the exact
# `--scope branch/<name>` the operator must record.
# THE DIAL IS REPO-CARRIED, exactly as the decl leg's is (DIAL-DELIVERY Δ-A): `KIT_PUSH_GO=enforce`
# (exact string) in the tracked, control-plane, export-ignored .kit/dials.conf refuses; an absent
# file (the adopter export) is observe; an env var of the same name may only ESCALATE. Both of this
# leg's dial test sites — the first relay and the memoized one — read it through _kit_dial. No
# ordering claim, same as CI.
# Design: docs/architecture/2026-08-07-b2-go-records-prepush-design.md (§3a Δ1′, Δ2+Δ3).
# CEILING (bind-not-authenticate, restated where the leg lives): a git note BINDS, it does not
# AUTHENTICATE (scripts/promotion-verify.sh:38-44) — an agent under the owner's git identity can
# mint a front-door record and no local mechanism can distinguish it. PREVENTION IS NOT CLAIMED:
# the full D-240805-3 disposition is the subagent-brief ledger-write prohibition (process) + the
# guard's raw-ledger-write deny (the back door) + the record rendered VERBATIM at the CI judgment
# surface (visibility, D-240805-4). And this leg is a SPEED BUMP, not a boundary — --no-verify, a
# never-installed hook, or an absent predicate script all bypass it (B1's ceiling, unchanged).
# STALENESS: this leg never fetches (offline discipline). An absent local refs/notes/promotions is
# N/A-with-nudge (first-run-green — no default refspec fetches notes, design S4); a stale one can
# FALSE-REFUSE (same fetch remedy) but never weaken CI, which reads the fresh ledger. The class
# gate derives from the PUSHED sha's diff vs its origin merge-base via the same single authority
# (promotion-readiness.sh --class); the predicate re-derives from the AMBIENT tree — the B1-A2
# divergence is inherited and disclosed, and the measured-worst case (an empty/underivable
# change-set deriving control-plane, S5) is removed by the empty-changeset skip below.
# MULTI-BRANCH CEILING (disclosed, a consequence of D11's single-derivation rule): the scope key is
# the CHECKED-OUT branch, so `git push origin a b` grades BOTH lines against the checked-out
# branch's GO. CI keys on the PR and backstops each branch separately. The alternative — deriving a
# key per pushed ref-line — is the second derivation site D11 forbids. Because that verdict is
# invocation-wide, it is CONSULTED once (REV M6) and RELAYED once (round 2, reviewer Minor 3); the
# rc is still decided per ref-line.

# _push_class_listing <sha> — THE SHARED change-set derivation, used by the GO leg and by the
# board-presence leg below it. Both need the same two facts about a pushed sha (its change-class,
# and a newline-delimited listing of its changed paths), derived through the SAME single authority
# (promotion-readiness.sh --class) with the SAME hardening the five other derivation sites carry
# (--no-renames + core.quotePath=false + -z + the literal-newline fail-safe, v3.186.0).
#
# ⚠️ IT EMITS NOTHING, AND THAT IS THE POINT (presence design A1-4). Two legs grade the same push
# line; a helper that printed its own prose would print it twice, and would have to choose one leg's
# prefix for both. So it returns a STATUS WORD and the callers narrate:
#   _pc_status = newline      a changed path holds a literal newline — do NOT classify (fail-safe HIGH)
#              = empty        the change-set vs merge-base is measurably EMPTY
#              = classified   _pc_cls holds ordinary|sensitive|control-plane, _pc_lst the listing path
#              = underivable  no merge-base, no mktemp, no authority, or an unusable answer (HIGH)
# THE CALLER OWNS `_pc_lst` AND MUST rm IT ON EVERY RETURN PATH — the temp-file leg in the selftest
# counts what is left under the fixture's TMPDIR after a full run and reds if anything is.
_push_class_listing() {
  _pc_status=underivable; _pc_cls=""; _pc_lst=""
  _pcl_sha=$1
  _pcl_base=$(git merge-base "$_pcl_sha" refs/remotes/origin/main 2>/dev/null) \
    || _pcl_base=$(git merge-base "$_pcl_sha" refs/remotes/origin/master 2>/dev/null) \
    || _pcl_base=""
  [ -n "$_pcl_base" ] || return 0
  _pcl_z=$(mktemp 2>/dev/null) || _pcl_z=""
  [ -n "$_pcl_z" ] || return 0
  if git -c core.quotePath=false diff --name-only -z --no-renames "$_pcl_base" "$_pcl_sha" \
       > "$_pcl_z" 2>/dev/null </dev/null; then
    # A NUL stream carries a newline byte ONLY when a filename does: detect -> do not classify ->
    # leave the caller on its fail-safe HIGH path. The newline-delimited form would SPLIT such a path
    # into fragments that each classify as `ordinary` (measured), i.e. fail-OPEN dressed as fail-safe.
    if [ "$(LC_ALL=C tr -cd '\n' < "$_pcl_z" | wc -c | tr -d ' ')" != 0 ]; then
      _pc_status=newline
    elif [ ! -s "$_pcl_z" ]; then
      _pc_status=empty
    else
      _pcl_prs="$ROOT/conformance/promotion-readiness.sh"
      if [ -f "$_pcl_prs" ] && [ -r "$_pcl_prs" ]; then
        _pcl_lst=$(mktemp 2>/dev/null) || _pcl_lst=""
        if [ -n "$_pcl_lst" ]; then
          tr '\0' '\n' < "$_pcl_z" > "$_pcl_lst"
          _pcl_cls=$(sh "$_pcl_prs" --changed "$_pcl_lst" --class 2>/dev/null </dev/null | tail -1) \
            || _pcl_cls=""
          if [ -n "$_pcl_cls" ]; then
            _pc_status=classified; _pc_cls=$_pcl_cls; _pc_lst=$_pcl_lst
          else
            rm -f "$_pcl_lst"
          fi
        fi
      fi
    fi
  fi
  rm -f "$_pcl_z"
  return 0
}

# go_relay — the leg's ONE verdict surface (all three non-pass paths route through it): observe
# prints and ALLOWS, enforce prints and REFUSES. Δ3 — the EXACT string "enforce" and nothing else
# escalates; `KIT_PUSH_GO=1` is observe, which is what the selftest's dial case pins (a `[ -n "$X" ]`
# mutant of this test survived every other leg, reviewer M4).
go_relay() { # captured-reasons
  # [reviewer Minor 3, round 2] ONE RELAY PER PUSH INVOCATION. REV M6 memoized the predicate's COST;
  # the TEXT was still emitted per ref-line, so `git push origin a b` printed the identical verdict
  # block twice. The verdict is invocation-wide by construction (it depends on the ambient tree, the
  # local ledger and the CHECKED-OUT branch — none of which change between ref-lines), so the second
  # copy carries no information and buries the first. The RC is unchanged: it is still decided
  # per line, by the same exact-string dial test, so a mutant flipping the dial cannot hide on the
  # quiet path either.
  if [ "${_go_relayed:-0}" -eq 1 ]; then
    _kit_dial KIT_PUSH_GO
    [ "$_kd_mode" = "enforce" ] || return 0
    return 1
  fi
  _go_relayed=1
  _kit_dial KIT_PUSH_GO
  if [ "$_kd_mode" = "enforce" ]; then
    # [-n check] a predicate that fails closed with no stderr must not relay a bare prefix line.
    if [ -n "$1" ]; then
      printf '%s\n' "$1" | while IFS= read -r _go_line; do
        printf 'kit pre-push: %s\n' "$_go_line" >&2
      done
    fi
    printf 'kit pre-push:   remedy: record the design GO FOR THIS BRANCH through the ceremonial front\n' >&2
    printf 'kit pre-push:            door, then publish it (the lines above name the exact key):\n' >&2
    printf 'kit pre-push:            scripts/promotion-verify.sh record --gate design --scope branch/<name> \\\n' >&2
    printf 'kit pre-push:              --approved-sha <design-commit> --approved-by <human> --basis <design-doc>\n' >&2
    printf 'kit pre-push:            git push origin refs/notes/promotions\n' >&2
    printf '  override (deliberate): git push --no-verify\n' >&2
    return 1
  fi
  if [ -n "$1" ]; then
    printf '%s\n' "$1" | while IFS= read -r _go_line; do
      printf 'kit pre-push (observe): %s\n' "$_go_line" >&2
    done
  fi
  printf 'kit pre-push (observe):   dial: the DURABLE switch is KIT_PUSH_GO=enforce in .kit/dials.conf\n' >&2
  printf 'kit pre-push (observe):         (tracked, control-plane, effective at merge — no hook re-copy). An env\n' >&2
  printf 'kit pre-push (observe):         var of the same name can only ESCALATE, for this session.\n' >&2
  return 0
}

go_check_ref() { # local_ref local_sha remote_ref remote_sha
  _go_sha=$2
  _go_ref=$3
  # D1 — dispatch, inherited from the decl leg verbatim: skip anything this leg cannot grade.
  case "$_go_ref" in
    refs/heads/*) : ;;
    *) return 0 ;;                                  # tags, notes, etc. — not a branch push
  esac
  case "$_go_sha" in
    *[!0]*) : ;;
    *) return 0 ;;                                  # all-zero local_sha — a deletion
  esac
  case "$_go_ref" in
    refs/heads/main | refs/heads/master) return 0 ;; # trunk merges are graded at the PR, not here
  esac
  # Defense-in-depth (inherited): only a hex object id may reach any argv below.
  case "$_go_sha" in
    *[!0-9a-fA-F]*) return 0 ;;
  esac
  # D2 — degradation: an absent/unreadable predicate N/As SILENTLY (first-run-green on adopter trees).
  _go_pred="$ROOT/conformance/ceremony-binding.sh"
  [ -f "$_go_pred" ] && [ -r "$_go_pred" ] || return 0
  # [REV M2] VERSION SKEW — an OLDER ceremony-binding.sh answers `unknown arg '--pre-push'` on
  # stderr and exits 2, which this leg's fail-closed rule would relay as "record a design GO": an
  # instruction that cannot fix the real problem, on a push that is probably fine. PROBE the mode
  # and N/A with the REAL reason instead. Guaranteed on the PR that INTRODUCES the mode (the hook
  # is installed per-clone and can be newer than the checkout) and normal during an adopter upgrade
  # where hooks/ and conformance/ advance out of step. Precedent: ratification.yml's
  # `grep -q -- '--check-complete'` probe, same shape and same reasoning.
  if ! grep -q -- '--pre-push' "$_go_pred" 2>/dev/null; then
    printf 'kit pre-push (GO): this checkout of conformance/ceremony-binding.sh predates --pre-push, so the design-GO leg is N/A for this push (not a missing GO). Expected while the mode is being introduced, and during an adopter upgrade where hooks/ and conformance/ advance out of step.\n' >&2
    return 0
  fi
  # [SEC M1] THE LEDGER REF IS NOT AN OPERATOR DIAL. Δ1′ made this leg able to REFUSE, which turns
  # PROMOTION_NOTES_REF into a bypass CHEAPER than --no-verify: --no-verify at least announces
  # itself in the command line, whereas an exported env var repointing the reader at a ledger the
  # operator wrote is silent and sticky. So the hook PINS the ref to the default and passes it
  # EXPLICITLY to the predicate (below); a non-default value in the environment is an ANOMALY,
  # routed through this leg's own dial — loud under observe, refused under enforce.
  _go_notes=promotions
  if [ -n "${PROMOTION_NOTES_REF:-}" ] && [ "${PROMOTION_NOTES_REF}" != "$_go_notes" ]; then
    go_relay "PROMOTION_NOTES_REF='$PROMOTION_NOTES_REF' repoints the GO ledger away from refs/notes/$_go_notes.
  This leg reads the DEFAULT ledger only — an env-selected ledger would be a silent bypass of a
  refusing gate. Unset it (the predicate's own fixtures set it in throwaway repos, never here)."
    return $?
  fi
  # Δ2 — an ABSENT local ledger is N/A with ONE observe-line naming the fetch (never a refusal:
  # a fresh clone has no refs/notes/* and that is a normal state, not a missing ceremony).
  if ! git rev-parse -q --verify "refs/notes/$_go_notes" >/dev/null 2>&1; then
    printf "kit pre-push (GO): no local GO ledger (refs/notes/%s) - N/A. Fetch it: git fetch origin '+refs/notes/*:refs/notes/*'\n" "$_go_notes" >&2
    return 0
  fi
  # Δ3 — the class gate on the PUSHED change-set, via the single authority the kit's gates share
  # (promotion-readiness.sh --class). Fail-safe stays HIGH everywhere except the one measured
  # false-refusal surface: a diff that is MEASURED EMPTY vs merge-base cannot need a design GO.
  # [REV M1 lives in _push_class_listing now — the derivation is SHARED with the presence leg, and
  # this leg narrates the two disclosed states with its own `(GO)` prefix. The battery G0-G10 is the
  # regression oracle for that lift: it ran byte-identical, with no assertion edited.]
  _push_class_listing "$_go_sha"
  _go_cls=$_pc_cls
  if [ -n "$_pc_lst" ]; then rm -f "$_pc_lst"; _pc_lst=""; fi   # this leg needs the class, not the listing
  case "$_pc_status" in
    newline)
      printf 'kit pre-push (GO): a changed path carries a literal NEWLINE - refusing to classify a split change-set; the leg proceeds (fail-safe HIGH).\n' >&2 ;;
    empty)
      printf 'kit pre-push (GO): empty change-set vs merge-base - a design GO gates changes, and there are none; skipping this leg.\n' >&2
      return 0 ;;
  esac
  case "$_go_cls" in
    ordinary) return 0 ;;                           # only sensitive/control-plane proceed
    sensitive | control-plane) : ;;
    *) : ;;                                         # underivable -> fail-safe HIGH: proceed
  esac
  # The predicate itself — the same script CI runs, keyed on the branch instead of the PR number.
  # Stderr captured (its reasons); stdout (the OK verdict) is not this leg's business. </dev/null:
  # stdin isolation, the SEC MEDIUM-1 property inherited from the decl leg (this runs inside the
  # push-protocol read loop). PROMOTION_NOTES_REF is passed EXPLICITLY (SEC M1, pinned above).
  #
  # [REV M6] MEMOIZED for this push invocation. The predicate's answer depends only on the ambient
  # tree, the local ledger and the checked-out branch — none of which change between the ref-lines
  # of ONE `git push` — while the cost is linear in ledger size (measured ~1.7s per line on a
  # 107-record ledger), so a 2-branch push paid for the same answer twice. The CLASS gate above is
  # deliberately NOT memoized: it is derived per PUSHED SHA and genuinely differs per line.
  if [ "${_go_memo:-0}" -eq 0 ]; then
    if _go_memo_out=$(PROMOTION_NOTES_REF="$_go_notes" sh "$_go_pred" --pre-push 2>&1 >/dev/null </dev/null); then
      _go_memo_rc=0
    else
      _go_memo_rc=1
    fi
    _go_memo=1
  fi
  if [ "$_go_memo_rc" -eq 0 ]; then
    return 0                                        # rc 0: pass / N-A — silent
  fi
  # Nonzero (rc 1 WAITING and rc 2 anomaly alike — FAIL-CLOSED on could-not-evaluate, the B1-proven
  # D3 shape): observe prints and allows; enforce prints and refuses (go_relay).
  go_relay "$_go_memo_out"
  return $?
}

# cite_check_ref — the sixth dial's leg (D-240815-2d). Runs the SAME predicate the required
# `docs-links` context runs — `conformance/citation-live.sh`, with NO ARGUMENTS, over the WHOLE
# TRACKED TREE — and relays its verdict once per push.
# ⚠️ WHOLE-TREE IS THE DESIGN, NOT AN OVERSIGHT. Scoping this to the changed files would invert the
# detection model: the C11 hostage was a citation that DECAYED BECAUSE OF AN EDIT IN A DIFFERENT FILE
# — the citing document was untouched, and a changed-file scope would have graded everything except
# the document that had rotted.
# THE DIAL IS REPO-CARRIED, exactly as the two legs above (DIAL-DELIVERY Δ-A): `KIT_PUSH_CITE=enforce`
# (exact string) in the tracked, control-plane, export-ignored .kit/dials.conf refuses; an absent file
# — the adopter export's state — is observe; an env var of the same name may only ESCALATE. Read
# through _kit_dial, whose new case arm resolves this dial at most once per invocation.
# TWO CAPTURE CONVENTIONS ARE LOAD-BEARING HERE, and they DIFFER from the GO leg's (design vet C4):
#   · COMBINED output (2>&1), not stderr-only. citation-live prints its verdicts — the named decayed
#     SITES and the summary — on STDOUT. The GO leg's stderr-only idiom copied verbatim would relay a
#     refusal with no site named on it: "your push is refused, and no, I will not say why".
#   · stdin isolation (</dev/null), the SEC MEDIUM-1 property inherited from both legs above: this
#     runs inside the caller's `while read` loop over the git push protocol, and a predicate that
#     reads stdin would eat the remaining ref-lines before the guard leg ever saw them.
# MEASURED NOISE COST, since combined capture changes it: ONE line per push on a clean tree (the
# check's own OK summary, which is a stdout verdict). That is deliberate — the census is the useful
# half of a passing citation gate — and it is relayed under the MODE-NEUTRAL `(note)` prefix, never
# `(observe)`, which names the DIAL's state and would misreport an enforcing tree as switched off.
# CEILING — A SPEED BUMP, NOT A BOUNDARY (the ruling's own clause): `git push --no-verify`, a
# never-installed hook, a stale installed copy or an absent predicate script all bypass this leg. The
# BINDING layer is and remains the required `docs-links` context, which grades the same predicate on
# the merge candidate. This leg only moves the finding earlier and cheaper.
# DIVERGENCE, DISCLOSED NOT CLOSED (the B1-A2 disclosure the GO leg already carries): the predicate
# grades the AMBIENT TRACKED TREE, not the pushed SHA. A dirty worktree, or a push of an older commit,
# is graded against what is on disk now. CI grades the merge candidate; this leg is the speed bump.
cite_relay() {  # captured-combined-output — the leg's ONE verdict surface
  # ONE RELAY PER PUSH INVOCATION (the go_relay rule, same reason): the verdict is invocation-wide by
  # construction — it depends on the ambient tree and nothing else, and NOTHING about it changes
  # between the ref-lines of one push — so a second copy carries no information and buries the first.
  # The RC is still decided per ref-line, by the same exact-string dial test.
  if [ "${_cite_relayed:-0}" -eq 1 ]; then
    _kit_dial KIT_PUSH_CITE
    [ "$_kd_mode" = "enforce" ] || return 0
    return 1
  fi
  _cite_relayed=1
  _kit_dial KIT_PUSH_CITE
  if [ "$_kd_mode" = "enforce" ]; then
    # [-n check] a predicate that fails closed with nothing printed must not relay a bare prefix line.
    if [ -n "$1" ]; then
      printf '%s\n' "$1" | while IFS= read -r _cite_line; do
        printf 'kit pre-push: %s\n' "$_cite_line" >&2
      done
    fi
    printf 'kit pre-push:   remedy: re-cite by row identifier — see DEVELOPMENT-STANDARDS.md section 11\n' >&2
    printf 'kit pre-push:            ("Citation discipline"): a living document cites a row, heading or\n' >&2
    printf 'kit pre-push:            symbol, never a line number, and a superseded value is DE-LINED.\n' >&2
    printf 'kit pre-push:   (the named site may be OUTSIDE your diff: whole-tree grading is deliberate —\n' >&2
    printf 'kit pre-push:    a citation decays from an edit in a different file)\n' >&2
    printf '  override (deliberate): git push --no-verify\n' >&2
    return 1
  fi
  if [ -n "$1" ]; then
    printf '%s\n' "$1" | while IFS= read -r _cite_line; do
      printf 'kit pre-push (observe): %s\n' "$_cite_line" >&2
    done
  fi
  printf 'kit pre-push (observe):   dial: the DURABLE switch is KIT_PUSH_CITE=enforce in .kit/dials.conf\n' >&2
  printf 'kit pre-push (observe):         (tracked, control-plane, effective at merge — no hook re-copy). An env\n' >&2
  printf 'kit pre-push (observe):         var of the same name can only ESCALATE, for this session.\n' >&2
  return 0
}

cite_check_ref() { # local_ref local_sha remote_ref remote_sha
  _cite_sha=$2
  _cite_ref=$3
  # D1 — dispatch, inherited from the two legs above VERBATIM: skip anything this leg cannot grade.
  case "$_cite_ref" in
    refs/heads/*) : ;;
    *) return 0 ;;                                  # tags, notes, etc. — not a branch push
  esac
  case "$_cite_sha" in
    *[!0]*) : ;;
    *) return 0 ;;                                  # all-zero local_sha — a deletion
  esac
  case "$_cite_ref" in
    refs/heads/main | refs/heads/master) return 0 ;; # trunk merges are graded at the PR, not here
  esac
  # Defense-in-depth (inherited shape, not an active control here: this leg passes NO argv to the
  # predicate — the hex guard is kept for uniformity with the sibling legs, whose argv it protects).
  case "$_cite_sha" in
    *[!0-9a-fA-F]*) return 0 ;;
  esac
  # D2 — degradation: an absent/unreadable predicate N/As SILENTLY (first-run-green on adopter trees).
  _cite_pred="$ROOT/conformance/citation-live.sh"
  [ -f "$_cite_pred" ] && [ -r "$_cite_pred" ] || return 0
  # MEMOIZED for this push invocation. The predicate reads the ambient tree and nothing else, so its
  # answer cannot change between ref-lines, and it costs ~0.5s per call over the whole corpus.
  # ⚠️ READ THE CLAIM CAREFULLY, exactly as at DA7: the memo is claimed as DEFENCE IN DEPTH, not as a
  # mutant-killed assertion. The ref-line loop's status accumulator is STICKY, so under enforce the
  # first relay's refusal has already decided the exit code before a second ref-line is reached — a
  # mutant that de-memoised this call could not be caught by the rc of any case in this file. What the
  # battery below pins is the DIAL, which the rc does observe.
  if [ "${_cite_memo:-0}" -eq 0 ]; then
    if _cite_memo_out=$(sh "$_cite_pred" 2>&1 </dev/null); then
      _cite_memo_rc=0
    else
      _cite_memo_rc=1
    fi
    _cite_memo=1
  fi
  if [ "$_cite_memo_rc" -eq 0 ]; then
    # rc 0: PASS. The predicate's own words are relayed rather than dropped (the A2 lesson), under the
    # MODE-NEUTRAL `(note)` prefix, and ONCE — a per-ref-line copy would print the same census twice.
    if [ "${_cite_noted:-0}" -eq 0 ]; then
      _cite_noted=1
      if [ -n "$_cite_memo_out" ]; then
        printf '%s\n' "$_cite_memo_out" | while IFS= read -r _cite_line; do
          printf 'kit pre-push (note): %s\n' "$_cite_line" >&2
        done
      fi
    fi
    return 0
  fi
  # Nonzero (rc 1 decay/unresolvable AND rc 2 bad-usage alike — FAIL-CLOSED on could-not-evaluate, the
  # B1-proven D3 shape): observe prints and allows; enforce prints and refuses (cite_relay).
  cite_relay "$_cite_memo_out"
  return $?
}

# presence_check_ref — the BOARD-PRESENCE leg (design
# docs/architecture/2026-09-02-prepush-presence-design.md). It runs the SAME predicate the required
# `backlog-presence` context runs — `conformance/backlog-presence.sh` — keyed on the BRANCH instead
# of a PR number, because at push time no PR exists yet.
# WHY IT EXISTS: on two consecutive control-plane slices the board row was still In Progress at push
# time and the FIRST CI run reddened on exactly that — a full 11-41 minute run spent learning what a
# local predicate answers in a second. The operator's rule ("row to In Review naming the branch
# before the push") was prose, and prose gets relearned.
# Δ1 — THE BOARD IS GRADED AT THE PUSHED SHA, not in the working tree. That is the decl leg's
# founding principle (grade the identical SHA CI grades, so drift is impossible by construction) and
# it is also the only way to catch the miss that is actually made: board edited, NOT COMMITTED,
# pushed — green locally, red in CI. The extracted board is read by the predicate and nothing else.
# ⚠️ THE BRANCH KEY IS NOT DERIVED HERE. D11 forbids a second derivation site, so the key comes from
# `ceremony-binding.sh --print-scope-key` — a read-only print of prepush_scope_key, the single
# authority. The selftest's PP9 leg greps this file and REDS if a branch derivation ever appears.
# CEILING (Δ3, restated where the leg lives): A SPEED BUMP, NOT A BOUNDARY. `git push --no-verify`,
# a never-installed hook, a stale installed copy, an absent predicate — and a DETACHED-HEAD push
# (`git push origin HEAD:refs/heads/x`, N/A here by construction: no branch, no row key) — all bypass
# this leg. The binding layer is and remains the required `backlog-presence` CI context, which grades
# the merge candidate. This leg adds no authority; it moves the finding earlier and cheaper.
# FAIL POSTURE, disclosed: an underivable class proceeds (HIGH); an absent predicate is a silent N/A
# (first-run-green); and with jq absent the predicate itself fail-safes every change-set to `gated`,
# so under enforce it can refuse an ordinary push on a jq-less machine — the gate's verdict names jq
# as the cause, and installing jq is the remedy.
# NO BOARD WRITES, EVER. Auto-moving the row was considered and rejected: a hook that edits
# control-plane state during a push crosses the agents-propose / humans-ratify line.
presence_relay() {  # captured-combined-output — the leg's ONE verdict surface
  # ONE RELAY PER PUSH INVOCATION (the go_relay/cite_relay rule). The rc is still decided per
  # ref-line by the same exact-string dial test, so a dial mutant cannot hide on the quiet path.
  if [ "${_pres_relayed:-0}" -eq 1 ]; then
    _kit_dial KIT_PUSH_PRESENCE
    [ "$_kd_mode" = "enforce" ] || return 0
    return 1
  fi
  _pres_relayed=1
  _kit_dial KIT_PUSH_PRESENCE
  if [ "$_kd_mode" = "enforce" ]; then
    if [ -n "$1" ]; then
      printf '%s\n' "$1" | while IFS= read -r _pres_line; do
        printf 'kit pre-push: %s\n' "$_pres_line" >&2
      done
    fi
    # NO REMEDY LINES ARE ADDED HERE. Unlike the sibling legs, this leg's predicate already prints a
    # stranger-readable remedy (which row is probably yours, the exact board edit) and that prose is
    # graded where it lives, with the gate. A second remedy invented here would be the copy that
    # drifts.
    printf '  override (deliberate): git push --no-verify\n' >&2
    return 1
  fi
  if [ -n "$1" ]; then
    printf '%s\n' "$1" | while IFS= read -r _pres_line; do
      printf 'kit pre-push (observe): %s\n' "$_pres_line" >&2
    done
  fi
  printf 'kit pre-push (observe):   dial: the DURABLE switch is KIT_PUSH_PRESENCE=enforce in .kit/dials.conf\n' >&2
  printf 'kit pre-push (observe):         (tracked, control-plane, effective at merge — no hook re-copy). An env\n' >&2
  printf 'kit pre-push (observe):         var of the same name can only ESCALATE, for this session.\n' >&2
  return 0
}

presence_check_ref() { # local_ref local_sha remote_ref remote_sha
  _pr_sha=$2
  _pr_ref=$3
  # D1 — dispatch, inherited from the three legs above VERBATIM.
  case "$_pr_ref" in
    refs/heads/*) : ;;
    *) return 0 ;;                                  # tags, notes, etc. — not a branch push
  esac
  case "$_pr_sha" in
    *[!0]*) : ;;
    *) return 0 ;;                                  # all-zero local_sha — a deletion
  esac
  case "$_pr_ref" in
    refs/heads/main | refs/heads/master) return 0 ;; # trunk merges are graded at the PR, not here
  esac
  case "$_pr_sha" in
    *[!0-9a-fA-F]*) return 0 ;;                     # defense-in-depth: only a hex id reaches argv
  esac
  # D2 — degradation. An absent/unreadable predicate N/As SILENTLY (first-run-green on adopter trees).
  _pr_pred="$ROOT/conformance/backlog-presence.sh"
  [ -f "$_pr_pred" ] && [ -r "$_pr_pred" ] || return 0
  _pr_keyer="$ROOT/conformance/ceremony-binding.sh"
  [ -f "$_pr_keyer" ] && [ -r "$_pr_keyer" ] || return 0
  # VERSION SKEW, probed on BOTH predicates the GO leg's way (REV M2). The probe keys on the DISPATCH
  # ARM TOKEN `--print-scope-key)`, not the bare flag: this file's own header names the flag in prose,
  # so a bare-flag grep would be tautologically true on the real script and the probe would never
  # fire (design A1-1). Guaranteed to matter on the PR that introduces the mode (the hook is
  # installed per-clone and can be newer than the checkout) and during an adopter upgrade.
  if ! grep -q -- '--print-scope-key)' "$_pr_keyer" 2>/dev/null; then
    printf 'kit pre-push (presence): this checkout of conformance/ceremony-binding.sh predates --print-scope-key, so the board-presence leg is N/A for this push (version skew, not an unbound row).\n' >&2
    return 0
  fi
  # ...and the same for the gate's own branch mode: an older copy answers usage rc 2, which this
  # leg's fail-closed rule would relay as "your board row is missing" (A1-2).
  if ! grep -q -- '--branch)' "$_pr_pred" 2>/dev/null; then
    printf 'kit pre-push (presence): this checkout of conformance/backlog-presence.sh predates --branch, so the board-presence leg is N/A for this push (version skew, not an unbound row).\n' >&2
    return 0
  fi
  # MEMOIZED ON THE PUSHED SHA (design §3.2(6); reviewer R1). Everything below — the class gate, the
  # scope key, the board extraction and the predicate — depends ONLY on the pushed sha and the
  # ambient tree, so `git push origin a b` pointing both refs at ONE sha must pay for it ONCE, while
  # two DIFFERENT shas are two genuinely different questions. The rc is still decided per ref-line
  # (below), and the TEXT is relayed once per invocation by presence_relay.
  if [ "${_pres_sha:-}" != "$_pr_sha" ]; then
    _presence_evaluate "$_pr_sha"
    _pres_sha=$_pr_sha
  fi
  [ "${_pres_rc:-0}" -eq 0 ] && return 0
  presence_relay "$_pres_out"
  return $?
}

# _presence_evaluate <pushed-sha> — the leg's whole judgment for ONE sha. Sets `_pres_rc` (0 = allow
# silently: passed, or an N/A whose one-line note it has already printed) and `_pres_out` (the text
# to relay when _pres_rc is 1). It never relays and never decides the push's exit code: that stays
# with presence_check_ref, per ref-line.
# DISCLOSED COST (security LOW-4): `_push_class_listing` is NOT shared between the GO leg and this
# one — each calls it, so a single-line push derives the change-set twice (two `git diff` +
# `promotion-readiness.sh` runs). Accepted rather than cured: a cross-leg memo would couple two legs'
# lifecycles for a fraction of one diff, and the legs must stay independently deletable.
_presence_evaluate() {
  _pr_sha=$1
  _pres_rc=0; _pres_out=""
  # CLASS GATE — the SHARED derivation (see _push_class_listing). Ordinary changes need no board row;
  # everything else proceeds, including an underivable class (fail-safe HIGH, the GO leg's posture).
  _push_class_listing "$_pr_sha"
  _pr_cls=$_pc_cls
  _pr_lst=$_pc_lst
  _pc_lst=""                                        # ownership moves to this leg; it removes it below
  case "$_pc_status" in
    newline)
      printf 'kit pre-push (presence): a changed path carries a literal NEWLINE - refusing to classify a split change-set; the leg proceeds (fail-safe HIGH).\n' >&2 ;;
    empty)
      printf 'kit pre-push (presence): empty change-set vs merge-base - a board row binds changes, and there are none; skipping this leg.\n' >&2
      return 0 ;;
  esac
  # THE UNDERIVABLE NOTE (security S2). A class this leg could not derive is graded as if it were
  # gated — the fail-safe — and the refusal that follows would otherwise blame the operator's BOARD
  # for what is really a missing merge-base. Whatever is relayed below carries this line with it.
  _pr_undernote=""
  case "$_pc_status" in
    classified) : ;;
    *) _pr_undernote="  note: the change-class could not be derived locally (no merge-base with origin/main?) and was graded gated as a fail-safe — this may not be a gated change at all." ;;
  esac
  case "$_pr_cls" in
    ordinary) if [ -n "$_pr_lst" ]; then rm -f "$_pr_lst"; fi; return 0 ;;
    *) : ;;                                         # sensitive / control-plane / underivable proceed
  esac
  # SCOPE KEY — the ONE sanctioned consumer path (§3.1). The ONLY N/A is rc 1 WITH NOTHING ON STDERR:
  # a detached push carries no branch, so no row could be keyed to it, and CI keys on the PR instead.
  # ⚠️ rc 1 ALONE IS NOT ENOUGH (security S1). `ceremony-binding.sh` is `set -eu` and sources a
  # library: a preamble failure, an unreadable obligation-lib, a refused `CB_DESIGN_GLOB` — all exit
  # NON-ZERO with a REASON on stderr, and rc 1 among them. Keying the N/A on the rc alone would print
  # "detached HEAD" at an operator who is not detached and wave the push through on a broken
  # predicate. The DERIVATION's own rc-1 path prints nothing (it is a `return 1` with no output), so
  # "rc 1 and silent" is the signature of a genuine detached HEAD and nothing else.
  # EVERY other non-(rc 0 + key) outcome — rc 1 with a reason, rc 2 charset, rc 3 bad usage, any
  # other rc, empty stdout — is a COULD-NOT-EVALUATE anomaly routed through the dial (A1-1).
  _pr_kerr=$(mktemp 2>/dev/null) || _pr_kerr=""
  if [ -n "$_pr_kerr" ]; then
    _pr_key=$(sh "$_pr_keyer" --print-scope-key 2>"$_pr_kerr" </dev/null); _pr_krc=$?
    _pr_kmsg=$(cat "$_pr_kerr" 2>/dev/null)
    rm -f "$_pr_kerr"
  else
    _pr_key=$(sh "$_pr_keyer" --print-scope-key 2>/dev/null </dev/null); _pr_krc=$?
    _pr_kmsg=""
  fi
  if [ "$_pr_krc" -eq 1 ] && [ -z "$_pr_kmsg" ]; then
    printf 'kit pre-push (presence): detached HEAD - no branch to bind a board row to; N/A (CI keys the row on the PR).\n' >&2
    if [ -n "$_pr_lst" ]; then rm -f "$_pr_lst"; fi
    return 0
  fi
  case "$_pr_key" in
    branch/?*) : ;;
    *) _pr_key="" ;;
  esac
  if [ "$_pr_krc" -ne 0 ] || [ -z "$_pr_key" ]; then
    if [ -n "$_pr_lst" ]; then rm -f "$_pr_lst"; fi
    # R7 — say WHICH failure it was. "exited 0 but printed no key" and "exited 2" send the reader to
    # different places, and the second is not an inference the message should leave them to make.
    if [ "$_pr_krc" -eq 0 ]; then
      _pr_kwhy="it exited 0 but printed no key"
    else
      _pr_kwhy="it exited $_pr_krc"
    fi
    _pres_out="the branch key could not be derived (ceremony-binding.sh --print-scope-key: $_pr_kwhy):
$_pr_kmsg
  This leg cannot grade a board row without the key, and a gate that cannot evaluate must not
  pretend it did."
    _presence_add_note
    _pres_rc=1
    return 0
  fi
  _pr_branch=${_pr_key#branch/}
  # Δ1 — EXTRACT THE BOARD AT THE PUSHED SHA into a temp dir the predicate is pointed at.
  _pr_tmp=$(mktemp -d 2>/dev/null) || _pr_tmp=""
  if [ -z "$_pr_tmp" ]; then
    if [ -n "$_pr_lst" ]; then rm -f "$_pr_lst"; fi
    _pres_out="could not create a temporary directory to extract the pushed commit's board; the board-presence leg could not evaluate."
    _presence_add_note
    _pres_rc=1
    return 0
  fi
  for _pr_f in BACKLOG.md CLAUDE.md; do
    _pr_entry=$(git ls-tree "$_pr_sha" -- "$_pr_f" 2>/dev/null) || _pr_entry=""
    # ABSENT is not an error: the predicate's own semantics then apply (no CLAUDE.md => "no backlog
    # backend declared" => N/A), which is the right answer for a tree that carries no board.
    [ -n "$_pr_entry" ] || continue
    case "$_pr_entry" in
      120000\ *)
        # A SYMLINK at the pushed sha (A1-6): `git show` hands back the LINK TEXT, and the predicate
        # would grade a one-line file that is not a board. N/A, disclosed; CI grades it.
        printf 'kit pre-push (presence): %s is a symlink at the pushed commit - the board is graded by CI only; N/A here.\n' "$_pr_f" >&2
        rm -rf "$_pr_tmp"
        if [ -n "$_pr_lst" ]; then rm -f "$_pr_lst"; fi
        return 0 ;;
    esac
    if ! git show "$_pr_sha:$_pr_f" > "$_pr_tmp/$_pr_f" 2>/dev/null; then
      rm -rf "$_pr_tmp"
      if [ -n "$_pr_lst" ]; then rm -f "$_pr_lst"; fi
      _pres_out="could not read $_pr_f at the pushed commit $_pr_sha, although the tree lists it; the board-presence leg could not evaluate."
      _presence_add_note
      _pres_rc=1
      return 0
    fi
  done
  # Is the working-tree board DIFFERENT from the graded one? That is the likeliest cause of a
  # surprising refusal (edited, not committed), so the note names it. rc > 1 means the comparison
  # itself failed — said plainly, and never a block on its own.
  _pr_dirty=""
  if git diff --quiet "$_pr_sha" -- BACKLOG.md 2>/dev/null; then
    :
  else
    case $? in
      1) _pr_dirty="  note: the board was graded AT THE PUSHED COMMIT - your working-tree BACKLOG.md differs from it (an uncommitted edit?)." ;;
      *) _pr_dirty="  note: the board was graded AT THE PUSHED COMMIT; the comparison with your working tree could not be made." ;;
    esac
  fi
  # THE PREDICATE. `--pr 0`: no PR exists at push time, and the gate's branch binding is what makes a
  # row bindable before one does. COMBINED capture (2>&1), like the citation leg and unlike the GO
  # leg: this gate prints its verdict, its hint and its remedy on STDOUT, so a stderr-only capture
  # would relay a refusal carrying no verdict at all. </dev/null: stdin isolation (SEC MEDIUM-1) —
  # this runs inside the caller's read loop over the push protocol.
  # RUN FROM $ROOT (reviewer R6). The gate invokes its two classifier seams by RELATIVE path, so it
  # must be entered from the repository root and not from whatever directory git happened to hand
  # this hook. An absent listing (underivable class) is passed deliberately: the gate fail-safes an
  # unreadable change-set to `gated`, which is the HIGH posture this path wants.
  [ -n "$_pr_lst" ] || _pr_lst="$_pr_tmp/no-derivable-listing"
  _pr_out=$( cd "$ROOT" && sh "$_pr_pred" --dir "$_pr_tmp" --pr 0 --changed "$_pr_lst" --branch "$_pr_branch" 2>&1 </dev/null )
  _pr_rc=$?
  case "$_pr_lst" in
    "$_pr_tmp"/*) : ;;                              # goes with the temp dir below
    *) rm -f "$_pr_lst" ;;
  esac
  rm -rf "$_pr_tmp"
  if [ "$_pr_rc" -eq 0 ]; then
    return 0                                        # bound (or N/A) — silent
  fi
  # Nonzero: rc 1 (the genuine unbound-row wait) and rc 2 (a misconfigured board) alike — fail-closed
  # on could-not-evaluate, the D3 shape every sibling leg uses.
  # S4 — A REFUSAL MUST NEVER BE MUTE. If the gate exits non-zero having printed nothing (a crash, a
  # `set -e` abort), the relay would otherwise emit the honesty line alone: "your push is refused,
  # and no, there is no reason". Name what happened instead.
  if [ -z "$_pr_out" ]; then
    _pr_out="backlog-presence exited rc $_pr_rc with no verdict - the gate could not be evaluated (a crash or an aborted run, not a judgment about your board)."
  fi
  if [ -n "$_pr_dirty" ]; then
    _pr_out="$_pr_out
$_pr_dirty"
  fi
  _pres_out=$_pr_out
  _presence_add_note
  _pres_rc=1
  return 0
}

# _presence_add_note — append the underivable-class disclosure (S2) to whatever is about to be
# relayed. One helper, so every anomaly path carries it and none can quietly forget to.
_presence_add_note() {
  [ -n "$_pr_undernote" ] || return 0
  _pres_out="$_pres_out
$_pr_undernote"
  return 0
}

if [ "${1:-}" = "--selftest" ]; then
  fail=0
  Z=0000000000000000000000000000000000000000
  # Hermetic: build a throwaway 2-commit repo so ancestry (merge-base) is deterministic
  # regardless of the ambient checkout depth — a shallow CI clone has no usable history,
  # which would make a real fast-forward read as indeterminate (deny). Left in place
  # (no rm) per the guard-safe fixture convention.
  T=$(mktemp -d)
  ( cd "$T" && git init -q \
      && git -c user.email=t@kit -c user.name=kit commit -q --allow-empty -m c1 \
      && git -c user.email=t@kit -c user.name=kit commit -q --allow-empty -m c2 )
  HEAD=$(cd "$T" && git rev-parse HEAD)
  PREV=$(cd "$T" && git rev-parse HEAD~1)
  check() { # desc remote-ref local-sha remote-sha want  (merge-base runs in the temp repo)
    if ( cd "$T" && guard_check_push "$2" "$3" "$4" ) >/dev/null 2>&1; then got=allow; else got=deny; fi
    if [ "$got" = "$5" ]; then echo "PASS $5: $1"; else echo "FAIL (wanted $5): $1"; fail=1; fi
  }
  check "push to main"        refs/heads/main "$HEAD" "$Z"   deny
  check "delete main"         refs/heads/main "$Z"    "$HEAD" deny
  check "new feature branch"  refs/heads/feature/x "$HEAD" "$Z" allow
  check "fast-forward push"   refs/heads/feature/x "$HEAD" "$PREV" allow
  check "force (non-ff) push" refs/heads/feature/x "$PREV" "$HEAD" deny
  # Load-bearing negatives — the hook must REFUSE when its core cannot be sourced.
  # Re-invoke THIS file exactly as git does (remote + url in argv, push protocol on
  # stdin) with a core path that does not exist. rc 0 would mean the guard is disarmed
  # by deleting one file. The --selftest variant additionally proves the coreless
  # selftest is no longer vacuously green (it once returned 0 having tested nothing).
  case "$0" in /*) SELF="$0" ;; *) SELF="$PWD/$0" ;; esac
  # $0 does NOT always name this file — argv[0] belongs to the CALLER. Measured: read on
  # stdin (`sh -s -- --selftest < hooks/pre-push`) $0 is "sh", so SELF is $PWD/sh, every
  # re-invocation below exits 127, and each prints "PASS deny" having executed NOTHING
  # with the whole selftest green. (A PATH lookup does resolve $0 fully on macOS/dash/
  # bash — the class is real, that particular form is not the trigger.) Fail loudly.
  [ -f "$SELF" ] || { echo "FAIL: selftest cannot resolve \$0 (SELF=$SELF)"; fail=1; }
  assert_refused() { # desc rc output — rc alone is NOT enough: a crashing target (syntax
    # error before the refusal) also exits non-zero. Assert the REASON, and assert that a
    # fail-closed refusal never advertises the bypass (design item 1's first real test).
    if [ "$2" -eq 0 ]; then
      echo "FAIL (wanted deny): $1"; fail=1
    elif ! printf '%s' "$3" | grep -q 'REFUSING the push'; then
      echo "FAIL (non-zero but no refusal message — crashed?): $1"; fail=1
    elif printf '%s' "$3" | grep -q -e '--no-verify'; then
      echo "FAIL (fail-closed refusal advertises a bypass): $1"; fail=1
    else
      echo "PASS deny: $1"
    fi
  }
  refuses() { # desc arg...  (re-invocation with an absent core must refuse, and say why)
    desc=$1; shift
    # the absent path lives in this selftest's OWN disposable dir — a hardcoded /-rooted
    # probe is writable in a root CI container, and a core there defining guard_check_push
    # would send the child back into these same cases (unbounded recursion).
    out=$(KIT_GUARD_CORE="$T/no-such-core" sh "$SELF" "$@" </dev/null 2>&1); rc=$?
    assert_refused "$desc" "$rc" "$out"
  }
  refuses "absent core: push invocation refuses" origin "file:///dev/null"
  refuses "absent core: --selftest is not vacuously green" --selftest
  # A readable core defining NO matrix must refuse even when a PATH binary of that name
  # exists — `command -v` alone accepts the binary and the push to main was allowed.
  mkdir -p "$T/bin"
  printf '' > "$T/empty-core"
  printf '#!/bin/sh\nexit 0\n' > "$T/bin/guard_check_push"
  chmod +x "$T/bin/guard_check_push"
  out=$(printf 'refs/heads/main %s refs/heads/main %s\n' "$HEAD" "$Z" \
        | PATH="$T/bin:$PATH" KIT_GUARD_CORE="$T/empty-core" sh "$SELF" origin "file:///dev/null" 2>&1); rc=$?
  assert_refused "matrix-less core: a PATH binary named guard_check_push does not satisfy it" "$rc" "$out"

  # ---------------------------------------------------------------------------------------------
  # B1 — the entry-declaration leg (decl_check_ref). A permissive guard core isolates the guard
  # leg (always allow) so only decl_check_ref's own dispatch/mode/verdict logic is under test. The
  # predicate itself is a planted STUB conformance/loop-state.sh inside $T (scripted rc), never the
  # real script — the real predicate is proven where it lives (loop-state.sh --selftest).
  # ---------------------------------------------------------------------------------------------
  DECL_CORE="$T/decl-permissive-core.sh"
  printf '#!/bin/sh\nguard_check_push() { return 0; }\n' > "$DECL_CORE"

  decl_plant_stub() { # rc [record-file] — a scripted conformance/loop-state.sh stub inside $T
    mkdir -p "$T/conformance"
    _dps_rc=$1; _dps_rec=${2:-}
    {
      echo '#!/bin/sh'
      [ -n "$_dps_rec" ] && printf 'echo called >> "%s"\n' "$_dps_rec"
      echo 'echo "loop-state: stub declaration reason" >&2'
      echo 'echo "  stub remedy detail" >&2'
      printf 'exit %s\n' "$_dps_rc"
    } > "$T/conformance/loop-state.sh"
    chmod +x "$T/conformance/loop-state.sh"
  }

  decl_run() { # KIT_PUSH_DECL-value ref-line -> sets decl_out, decl_rc (re-invokes $SELF in $T)
    decl_out=$(cd "$T" && printf '%s\n' "$2" \
      | KIT_GUARD_CORE="$DECL_CORE" KIT_PUSH_DECL="$1" sh "$SELF" 2>&1); decl_rc=$?
  }

  decl_expect_rc() { # rc want(allow|refuse) desc
    if [ "$2" = allow ] && [ "$1" -eq 0 ]; then echo "PASS allow: $3"
    elif [ "$2" = refuse ] && [ "$1" -ne 0 ]; then echo "PASS refuse: $3"
    else echo "FAIL (wanted $2, rc=$1): $3"; fail=1
    fi
  }
  decl_expect_contains() { # desc needle haystack
    if printf '%s' "$3" | grep -qF -- "$2"; then echo "PASS contains '$2': $1"
    else echo "FAIL (missing '$2'): $1"; echo "  got: $3"; fail=1
    fi
  }
  decl_expect_not_invoked() { # desc record-file
    if [ -f "$2" ]; then echo "FAIL: $1 — the predicate must NOT have been invoked"; fail=1
    else echo "PASS: $1 — the predicate was not invoked"
    fi
  }

  # enforce + rc1 -> REFUSED with the discriminating enforce message.
  decl_plant_stub 1
  decl_run enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$decl_rc" refuse "enforce + failing predicate refuses the push"
  decl_expect_contains "enforce message uses the enforce prefix" "kit pre-push:" "$decl_out"
  decl_expect_contains "enforce message names the amend remedy" "amend" "$decl_out"
  decl_expect_contains "enforce message keeps the --no-verify honesty line" "--no-verify" "$decl_out"
  # [REV H2] Reason-relay: the stub emits TWO distinct stderr lines; both must survive the relay
  # loop verbatim. A mutant that deletes the enforce relay loop (while still printing the fixed
  # remedy/hint lines) passes every assertion above but fails these two.
  decl_expect_contains "enforce relays the predicate's first reason line" "stub declaration reason" "$decl_out"
  decl_expect_contains "enforce relays the predicate's second reason line" "stub remedy detail" "$decl_out"

  # observe (default) + rc1 -> ALLOWED, with the observe prefix and the escalation hint.
  decl_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$decl_rc" allow "observe + failing predicate still allows the push"
  decl_expect_contains "observe message uses the observe prefix" "kit pre-push (observe):" "$decl_out"
  decl_expect_contains "observe message hints the enforce dial" "KIT_PUSH_DECL=enforce" "$decl_out"
  # [REV H2] Same per-line relay proof, observe side (the mutant deletes both loops).
  decl_expect_contains "observe relays the predicate's first reason line" "stub declaration reason" "$decl_out"
  decl_expect_contains "observe relays the predicate's second reason line" "stub remedy detail" "$decl_out"

  # [REV M4] THE DIAL IS AN EXACT-STRING TEST, and this is the leg that proves it. Every case above
  # uses either "enforce" or the empty string, so the mutant `[ "$X" = "enforce" ]` -> `[ -n "$X" ]`
  # SURVIVED the whole suite (measured, review round 1): with it, any non-empty value escalates to a
  # refusal — the truthy-looking `KIT_PUSH_DECL=1` an operator would plausibly type would start
  # BLOCKING pushes that the documented dial says are observe-only. One case per leg kills it.
  decl_run 1 "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$decl_rc" allow "dial: KIT_PUSH_DECL=1 is NOT the exact string — stays observe"
  decl_expect_contains "dial: KIT_PUSH_DECL=1 prints the observe prefix" "kit pre-push (observe):" "$decl_out"

  # [REV H3] rc 2 (could-not-evaluate) must fail CLOSED in enforce mode exactly like rc 1 — the
  # leg's own comment is "D3 — nonzero (rc 1 AND rc 2 ...)"; a `-eq 1`-only check would silently
  # allow rc 2 through instead and this case would go red.
  decl_plant_stub 2
  decl_run enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$decl_rc" refuse "enforce + predicate rc 2 (could-not-evaluate) fails closed"
  decl_expect_contains "rc-2 enforce message uses the enforce prefix" "kit pre-push:" "$decl_out"
  decl_expect_contains "rc-2 enforce message names the amend remedy" "amend" "$decl_out"
  decl_expect_contains "rc-2 enforce message keeps the --no-verify honesty line" "--no-verify" "$decl_out"

  # rc 2, observe side — still allows, still prints (same non-zero handling as rc 1).
  decl_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$decl_rc" allow "observe + predicate rc 2 still allows the push"
  decl_expect_contains "rc-2 observe message uses the observe prefix" "kit pre-push (observe):" "$decl_out"

  # enforce + rc0 -> allowed. [A2 — B9 §10-A2, delivered by DIAL-DELIVERY Δ-A] A PASSING predicate
  # that nevertheless wrote to stderr must not have it SWALLOWED: the leg relayed nothing at all on
  # the rc-0 path, so a predicate's warning vanished. It is now relayed under the mode-neutral
  # `kit pre-push (note):` prefix (the leg's line discipline — a bare relay would break it) and the
  # push is still allowed. Measured noise cost on real passing heads: zero (3 heads, 0 stderr lines).
  decl_plant_stub 0
  decl_run enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$decl_rc" allow "enforce + passing predicate allows the push"
  decl_expect_contains "A2: rc-0 relays the predicate's first stderr line" "stub declaration reason" "$decl_out"
  decl_expect_contains "A2: rc-0 relays the predicate's second stderr line" "stub remedy detail" "$decl_out"
  # The prefix is the MODE-NEUTRAL `(note)`: this case runs with the dial ESCALATED to enforce, so a
  # relay under `(observe)` would misreport the dial's state to the operator (review round 1).
  decl_expect_contains "A2: the rc-0 relay carries the mode-neutral note prefix" "kit pre-push (note):" "$decl_out"
  case "$decl_out" in
    *'kit pre-push (observe):'*) echo "FAIL: the rc-0 pass-relay must NOT claim the observe mode on an enforcing dial"; fail=1 ;;
    *) echo "PASS: the rc-0 pass-relay does not misreport the dial as observe" ;;
  esac
  # ...and the relay is CONDITIONAL, not unconditional noise: a predicate that passes QUIETLY stays
  # silent (an unguarded relay would print a bare prefix line on every clean push).
  printf '#!/bin/sh\nexit 0\n' > "$T/conformance/loop-state.sh"; chmod +x "$T/conformance/loop-state.sh"
  decl_run enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$decl_rc" allow "enforce + quiet passing predicate allows the push"
  [ -z "$decl_out" ] && echo "PASS: a QUIETLY passing predicate is silent (A2 relay is conditional)" \
    || { echo "FAIL: a quietly passing predicate must be silent, got: $decl_out"; fail=1; }

  # Skip rules (D1) — the predicate must never be invoked on these ref-line shapes. A POSITIVE
  # control comes first: without it, decl_check_ref always returning early (an always-skip mutant)
  # would pass every negative below vacuously — same class of trap non-vacuity.sh itself polices.
  decl_plant_stub 0 "$T/decl-invoked"
  rm -f "$T/decl-invoked"
  decl_run enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  [ -f "$T/decl-invoked" ] && echo "PASS: a normal branch line invokes the predicate (record control)" \
    || { echo "FAIL: a normal branch line must invoke the predicate (record control)"; fail=1; }

  decl_plant_stub 1 "$T/decl-invoked"
  rm -f "$T/decl-invoked"
  decl_run enforce "refs/heads/feature/x $Z refs/heads/feature/x $HEAD"
  decl_expect_not_invoked "deletion line (zero local_sha)" "$T/decl-invoked"

  rm -f "$T/decl-invoked"
  decl_run enforce "refs/tags/v1 $HEAD refs/tags/v1 $Z"
  decl_expect_not_invoked "tag line (remote_ref not refs/heads/*)" "$T/decl-invoked"

  rm -f "$T/decl-invoked"
  decl_run enforce "refs/heads/main $HEAD refs/heads/main $Z"
  decl_expect_not_invoked "default-branch line (refs/heads/main)" "$T/decl-invoked"

  rm -f "$T/decl-invoked"
  decl_run enforce "refs/heads/master $HEAD refs/heads/master $Z"
  decl_expect_not_invoked "default-branch line (refs/heads/master)" "$T/decl-invoked"

  # Degradation (D2) — an absent predicate script N/As silently, never refuses.
  # [REV M3] Coverage is ABSENCE-only, deliberately: an unreadable-but-present predicate (e.g.
  # chmod 000) is NOT exercised here, because a selftest run as root (a normal CI-container
  # default) ignores file-mode read permission entirely — such a case would false-PASS in that
  # environment regardless of whether the D2 `[ -r ... ]` leg actually degrades correctly,
  # which is worse than not having the case (a green that proves nothing). The absent-file path
  # above is the portable, root-safe member of the same degradation family.
  rm -f "$T/conformance/loop-state.sh"
  decl_run enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$decl_rc" allow "absent predicate script allows the push"
  [ -z "$decl_out" ] && echo "PASS: absent predicate script is silent" \
    || { echo "FAIL: absent predicate script must be silent, got: $decl_out"; fail=1; }

  # ---------------------------------------------------------------------------------------------
  # [SEC MEDIUM-1] stdin isolation — a predicate must not be able to consume subsequent
  # push-protocol lines from the parent's stdin. Plant a stub that reads (and discards) ALL of
  # stdin before exiting 1; feed it TWO lines: line 1 a normal feature-branch push (the one this
  # leg grades), line 2 a push to refs/heads/main that the GUARD leg (guard_check_push, the real
  # core — not the permissive DECL_CORE) must refuse. KIT_PUSH_DECL is left unset (observe) so the
  # decl leg itself never forces a refusal — the only way this case can fail closed is if the
  # guard leg actually sees and evaluates line 2. Without the </dev/null fix, the stub's `cat`
  # swallows line 2 before the outer while-read loop can read it: the guard leg never runs on the
  # main-push line, and the whole push is wrongly ALLOWED — fail-open past the guard leg.
  # ---------------------------------------------------------------------------------------------
  mkdir -p "$T/conformance"
  {
    echo '#!/bin/sh'
    echo 'cat >/dev/null'
    echo 'exit 1'
  } > "$T/conformance/loop-state.sh"
  chmod +x "$T/conformance/loop-state.sh"
  stdin_leak_out=$(cd "$T" && printf 'refs/heads/feature/x %s refs/heads/feature/x %s\nrefs/heads/main %s refs/heads/main %s\n' \
      "$HEAD" "$Z" "$HEAD" "$Z" \
    | KIT_GUARD_CORE="$ROOT/.claude/hooks/guard-core.sh" sh "$SELF" 2>&1)
  stdin_leak_rc=$?
  if [ "$stdin_leak_rc" -ne 0 ] && printf '%s' "$stdin_leak_out" | grep -q 'pushing directly to main'; then
    echo "PASS: a stdin-eating predicate does not swallow the guard leg's own push-to-main line"
  else
    echo "FAIL: stdin leak — the guard leg's verdict on the second (main-push) line did not fire (rc=$stdin_leak_rc)"
    echo "  got: $stdin_leak_out"
    fail=1
  fi

  # ---------------------------------------------------------------------------------------------
  # B2 — the design-GO leg (go_check_ref). Same isolation pattern as the decl section above: the
  # permissive DECL_CORE isolates the guard leg, and the predicate is a planted STUB
  # conformance/ceremony-binding.sh (scripted rc), never the real script — the real predicate is
  # proven where it lives (ceremony-binding.sh --selftest legs P1-P7).
  # THE LEDGER REF. [SEC M1] the hook PINS the ref to `promotions` and refuses a non-default
  # PROMOTION_NOTES_REF (G13), so these fixtures can no longer redirect it: each case writes
  # refs/notes/promotions INSIDE ITS OWN THROWAWAY REPO ($T / $TG / $TN — a `git init` under
  # mktemp -d), never in the repository this hook is installed in. That is the same fixture
  # convention conformance/ceremony-binding.sh's selftest already uses (_mkfix/_mklink).
  # ---------------------------------------------------------------------------------------------
  rm -f "$T/conformance/loop-state.sh"   # keep the decl leg silently N/A (D2) for every GO case

  go_plant_stub() { # dir rc [record-file] — a scripted conformance/ceremony-binding.sh stub
    _gps_dir=$1; _gps_rc=$2; _gps_rec=${3:-}
    mkdir -p "$_gps_dir/conformance"
    {
      echo '#!/bin/sh'
      # The stub must ADVERTISE the mode: the leg probes for the literal `--pre-push` before
      # invoking (the version-skew guard, G0). A stub without it would N/A every case below —
      # vacuously green. G0 plants the stub that deliberately lacks it.
      echo '# supports --pre-push'
      [ -n "$_gps_rec" ] && printf 'echo called >> "%s"\n' "$_gps_rec"
      echo 'echo "ceremony-binding: stub GO reason" >&2'
      echo 'echo "  stub GO remedy detail" >&2'
      printf 'exit %s\n' "$_gps_rc"
    } > "$_gps_dir/conformance/ceremony-binding.sh"
    chmod +x "$_gps_dir/conformance/ceremony-binding.sh"
  }

  go_run() { # dir KIT_PUSH_GO-value ref-line(s) -> sets go_out, go_rc (re-invokes $SELF)
    go_out=$(cd "$1" && printf '%s\n' "$3" \
      | KIT_GUARD_CORE="$DECL_CORE" KIT_PUSH_GO="$2" sh "$SELF" 2>&1); go_rc=$?
  }

  # [round 3 — CI-CAUGHT, FIXTURE HERMETICITY] THE FIXTURE LEDGER IS BUILT WITH AN EXPLICIT IDENTITY,
  # AND ITS CREATION IS ASSERTED. Measured on CI (run 31185508364, job 92888909087, conformance-core):
  # every ledger write below was a bare `git notes --ref=promotions add ... 2>/dev/null` carrying NO
  # `-c user.email/-c user.name`, unlike every other git command in this selftest. A GitHub runner has
  # no configured git identity and cannot auto-detect one, so the note write FAILED, `2>/dev/null` ate
  # the reason, the throwaway repo ended up with NO refs/notes/promotions — and all of the GO cases
  # took the Δ2 absent-ledger N/A path. Green on the dev-clone (which HAS a global identity), red on
  # every runner: the FIXTURE-HERMETICITY class (B4's retro — "a selftest cell reading the ambient
  # tree's kit markers: green on dev, wrong on every export"), here reading the ambient git CONFIG.
  # Cure, both halves: (1) pass the identity explicitly like every other fixture commit, so the write
  # cannot depend on ambient config; (2) ASSERT the ref afterwards, so a fixture that fails to build
  # reds HERE with its real reason instead of silently N/A-ing every case downstream into a green
  # (before this assertion existed, a broken fixture produced 25 confusing failures and, in the
  # absent-ledger direction, could produce none at all).
  go_mkledger() { # dir — create refs/notes/promotions INSIDE the throwaway repo $1, hermetically
    _gml_err=$( (cd "$1" && git -c user.email=t@kit -c user.name=kit \
        notes --ref=promotions add -f -m "b2 selftest fixture" HEAD) 2>&1 ) || :
    if ( cd "$1" && git rev-parse -q --verify refs/notes/promotions >/dev/null 2>&1 ); then
      echo "PASS: fixture ledger built in the throwaway repo (no ambient identity, no ambient notes)"
    else
      echo "FAIL: fixture ledger was NOT built in $1 — every GO case below would vacuously N/A"
      echo "  got: $_gml_err"; fail=1
    fi
  }

  go_no_ledger() { # dir — assert the fixture repo has NO ledger (the deliberate absent-ledger case)
    if ( cd "$1" && git rev-parse -q --verify refs/notes/promotions >/dev/null 2>&1 ); then
      echo "FAIL: the absent-ledger fixture $1 HAS a ledger — the N/A case below would prove nothing"
      fail=1
    else
      echo "PASS: absent-ledger fixture really has no refs/notes/promotions (precondition)"
    fi
  }

  # G0 [REV M2] — VERSION SKEW. A conformance/ceremony-binding.sh that predates --pre-push must
  # N/A with the REAL reason, never be relayed as "record a design GO". Without the probe the old
  # script answers `unknown arg '--pre-push'` + rc 2, and this leg's fail-closed rule turns that
  # into an enforce REFUSAL telling the operator to record an approval that would not help.
  mkdir -p "$T/conformance"
  printf '#!/bin/sh\necho "ceremony-binding: unknown arg (old copy)" >&2\nexit 2\n' \
    > "$T/conformance/ceremony-binding.sh"
  chmod +x "$T/conformance/ceremony-binding.sh"
  go_run "$T" enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$go_rc" allow "GO leg: a checkout predating --pre-push is N/A even under enforce"
  decl_expect_contains "GO leg: version skew names the real reason" "predates --pre-push" "$go_out"

  # G1 — an ABSENT local ledger is N/A (rc 0) with ONE observe-line naming the fetch command, even
  # under enforce, and the predicate is NEVER invoked. First-run-green (design S4/Δ2): a fresh
  # clone fetches no refs/notes/* by default, and that must nudge, not block. [MUTANT-B target: an
  # absent-ref path that returns WAITING/refuses instead of N/A reds this case.]
  # THIS is the one deliberate absent-ledger case, and it is the reason the fixture PRECONDITION is
  # asserted on both sides: $T carries no notes ref until go_mkledger runs below, and if it ever did
  # (an ambient ledger leaking in, the mirror image of the round-3 defect) this case would pass while
  # testing the wrong path.
  go_no_ledger "$T"
  go_plant_stub "$T" 1 "$T/go-invoked"
  rm -f "$T/go-invoked"
  go_run "$T" enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$go_rc" allow "GO leg: absent ledger ref is N/A even under enforce"
  decl_expect_contains "GO leg: absent-ledger N/A names the fetch remedy" "+refs/notes/*:refs/notes/*" "$go_out"
  decl_expect_not_invoked "GO leg: absent ledger ref (predicate must not run)" "$T/go-invoked"

  # The fixture ledger for every case below — inside the throwaway repo $T, never the real one.
  go_mkledger "$T"

  # G2 — positive control: ledger present, predicate rc 0 => invoked, allowed, SILENT.
  go_plant_stub "$T" 0 "$T/go-invoked"
  rm -f "$T/go-invoked"
  go_run "$T" enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$go_rc" allow "GO leg: passing predicate allows the push"
  [ -f "$T/go-invoked" ] && echo "PASS: GO leg invokes the predicate on a normal branch line (record control)" \
    || { echo "FAIL: GO leg must invoke the predicate on a normal branch line (record control)"; fail=1; }
  [ -z "$go_out" ] && echo "PASS: GO leg passing predicate is silent" \
    || { echo "FAIL: GO leg passing predicate must be silent, got: $go_out"; fail=1; }

  # G3 — enforce + rc 1 (WAITING) => REFUSED, relaying the verdict, naming the BRANCH-SCOPED record
  # command (the hook's own fixed remedy line — MUTANT-C target) and keeping the honesty line.
  go_plant_stub "$T" 1
  go_run "$T" enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$go_rc" refuse "GO leg: enforce + WAITING predicate refuses the push"
  decl_expect_contains "GO leg enforce uses the enforce prefix" "kit pre-push:" "$go_out"
  decl_expect_contains "GO leg enforce relays the predicate's first reason line" "stub GO reason" "$go_out"
  decl_expect_contains "GO leg enforce relays the predicate's second reason line" "stub GO remedy detail" "$go_out"
  decl_expect_contains "GO leg enforce names the record command" "promotion-verify.sh record" "$go_out"
  # Δ1′: the remedy must name the BRANCH scope, not a bare `--gate design ...`. A record for the
  # wrong key satisfies nothing, so an operator told only "record a GO" cannot clear this refusal.
  decl_expect_contains "GO leg enforce names the branch scope in the record command" "--scope branch/" "$go_out"
  decl_expect_contains "GO leg enforce keeps the --no-verify honesty line" "--no-verify" "$go_out"

  # G4 — observe (default) + rc 1 => ALLOWED, observe prefix + the escalation hint + the relay.
  go_run "$T" "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$go_rc" allow "GO leg: observe + WAITING predicate still allows the push"
  decl_expect_contains "GO leg observe uses the observe prefix" "kit pre-push (observe):" "$go_out"
  decl_expect_contains "GO leg observe hints the enforce dial" "KIT_PUSH_GO=enforce" "$go_out"
  decl_expect_contains "GO leg observe relays the predicate's reason" "stub GO reason" "$go_out"

  # G4b [REV M4] — THE DIAL IS AN EXACT-STRING TEST. Every other case uses "enforce" or "", so the
  # mutant `[ "$X" = "enforce" ]` -> `[ -n "$X" ]` SURVIVED the whole suite (measured, review round
  # 1): under it the truthy-looking KIT_PUSH_GO=1 an operator would plausibly type starts BLOCKING
  # pushes the documented dial calls observe-only. This case is the kill.
  go_run "$T" 1 "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$go_rc" allow "dial: KIT_PUSH_GO=1 is NOT the exact string — stays observe"
  decl_expect_contains "dial: KIT_PUSH_GO=1 prints the observe prefix" "kit pre-push (observe):" "$go_out"

  # G5 — rc 2 (anomaly / could-not-evaluate) FAILS CLOSED under enforce, exactly like rc 1.
  # [MUTANT-A target: deleting the fail-closed handling of rc 2 reds this case.]
  go_plant_stub "$T" 2
  go_run "$T" enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$go_rc" refuse "GO leg: enforce + predicate rc 2 (anomaly) fails closed"
  decl_expect_contains "GO leg rc-2 enforce keeps the --no-verify honesty line" "--no-verify" "$go_out"

  # G6 — rc 2, observe side: allowed, LOUD (the anomaly is relayed, not swallowed).
  go_run "$T" "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$go_rc" allow "GO leg: observe + predicate rc 2 still allows the push"
  decl_expect_contains "GO leg rc-2 observe relays the anomaly" "stub GO reason" "$go_out"

  # G7 — dispatch (B1 D1 inherited): deletions, tags and the default branch never reach the predicate.
  go_plant_stub "$T" 1 "$T/go-invoked"
  rm -f "$T/go-invoked"
  go_run "$T" enforce "refs/heads/feature/x $Z refs/heads/feature/x $HEAD"
  decl_expect_not_invoked "GO leg: deletion line (zero local_sha)" "$T/go-invoked"
  rm -f "$T/go-invoked"
  go_run "$T" enforce "refs/tags/v1 $HEAD refs/tags/v1 $Z"
  decl_expect_not_invoked "GO leg: tag line (remote_ref not refs/heads/*)" "$T/go-invoked"
  rm -f "$T/go-invoked"
  go_run "$T" enforce "refs/heads/main $HEAD refs/heads/main $Z"
  decl_expect_not_invoked "GO leg: default-branch line (refs/heads/main)" "$T/go-invoked"

  # G13 [SEC M1] — PROMOTION_NOTES_REF IS NOT AN OPERATOR DIAL. With Δ1′ this leg can refuse, so an
  # env var that repoints the reader at a ledger the operator wrote would be a bypass CHEAPER than
  # --no-verify (silent, sticky, and it leaves no trace in the push command). It is an ANOMALY:
  # refused under enforce, loud under observe. The ledger and a PASSING predicate are both present,
  # so the only thing that can produce a refusal here is the env check itself.
  go_plant_stub "$T" 0 "$T/go-invoked"
  rm -f "$T/go-invoked"
  go_notes_out=$(cd "$T" && printf 'refs/heads/feature/x %s refs/heads/feature/x %s\n' "$HEAD" "$Z" \
    | KIT_GUARD_CORE="$DECL_CORE" PROMOTION_NOTES_REF=b2fix-elsewhere KIT_PUSH_GO=enforce sh "$SELF" 2>&1)
  go_notes_rc=$?
  decl_expect_rc "$go_notes_rc" refuse "GO leg: a non-default PROMOTION_NOTES_REF is refused under enforce"
  decl_expect_contains "GO leg: the ledger-ref refusal names the variable" "PROMOTION_NOTES_REF" "$go_notes_out"
  decl_expect_not_invoked "GO leg: non-default ledger ref (predicate must not run)" "$T/go-invoked"
  go_notes_out=$(cd "$T" && printf 'refs/heads/feature/x %s refs/heads/feature/x %s\n' "$HEAD" "$Z" \
    | KIT_GUARD_CORE="$DECL_CORE" PROMOTION_NOTES_REF=b2fix-elsewhere sh "$SELF" 2>&1)
  go_notes_rc=$?
  decl_expect_rc "$go_notes_rc" allow "GO leg: a non-default PROMOTION_NOTES_REF is loud but allowed under observe"
  decl_expect_contains "GO leg: the observe form is still disclosed" "kit pre-push (observe):" "$go_notes_out"
  # The DEFAULT value, explicitly set, is NOT an anomaly — it is what the hook itself passes down.
  go_plant_stub "$T" 0 "$T/go-invoked"
  rm -f "$T/go-invoked"
  go_notes_out=$(cd "$T" && printf 'refs/heads/feature/x %s refs/heads/feature/x %s\n' "$HEAD" "$Z" \
    | KIT_GUARD_CORE="$DECL_CORE" PROMOTION_NOTES_REF=promotions KIT_PUSH_GO=enforce sh "$SELF" 2>&1)
  go_notes_rc=$?
  decl_expect_rc "$go_notes_rc" allow "GO leg: PROMOTION_NOTES_REF=promotions (the default) is not an anomaly"
  [ -f "$T/go-invoked" ] && echo "PASS: GO leg still runs the predicate on the default ledger ref" \
    || { echo "FAIL: GO leg must still run the predicate on the default ledger ref"; fail=1; }

  # G14 [REV M6] — MEMOIZATION. Two branch ref-lines in ONE push invocation must consult the
  # predicate ONCE: its answer depends only on the ambient tree, the local ledger and the
  # checked-out branch, none of which change mid-push, and it costs ~1.7s per call on a
  # 107-record ledger. Counted through the record file (one `called` line per invocation).
  go_plant_stub "$T" 0 "$T/go-count"
  rm -f "$T/go-count"
  go_run "$T" enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z
refs/heads/feature/y $HEAD refs/heads/feature/y $Z"
  _go_calls=$(wc -l < "$T/go-count" 2>/dev/null | tr -d ' '); [ -n "$_go_calls" ] || _go_calls=0
  if [ "$_go_calls" = 1 ]; then
    echo "PASS: GO leg consults the predicate ONCE for a 2-branch push (memoized)"
  else
    echo "FAIL: GO leg invoked the predicate $_go_calls time(s) for a 2-branch push (want 1)"; fail=1
  fi

  # G14b [reviewer Minor 3, round 2] — ONE RELAY PER PUSH INVOCATION. G14 memoizes the predicate's
  # COST; the OUTPUT was still emitted per ref-line, so a 2-branch push printed the identical verdict
  # block twice (the second copy carries no new information and buries the first). The rc must not
  # change: every graded line still fails, so enforce still REFUSES and observe still allows.
  go_plant_stub "$T" 1
  go_run "$T" enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z
refs/heads/feature/y $HEAD refs/heads/feature/y $Z"
  _go_relays=$(printf '%s\n' "$go_out" | grep -c 'stub GO reason' || true)
  decl_expect_rc "$go_rc" refuse "GO leg: a 2-branch push under enforce still refuses"
  if [ "$_go_relays" = 1 ]; then
    echo "PASS: GO leg relays the verdict ONCE for a 2-branch push under enforce"
  else
    echo "FAIL: GO leg relayed the verdict $_go_relays time(s) for a 2-branch push under enforce (want 1)"; fail=1
  fi
  go_run "$T" "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z
refs/heads/feature/y $HEAD refs/heads/feature/y $Z"
  _go_relays=$(printf '%s\n' "$go_out" | grep -c 'stub GO reason' || true)
  decl_expect_rc "$go_rc" allow "GO leg: a 2-branch push under observe still allows"
  if [ "$_go_relays" = 1 ]; then
    echo "PASS: GO leg relays the verdict ONCE for a 2-branch push under observe"
  else
    echo "FAIL: GO leg relayed the verdict $_go_relays time(s) for a 2-branch push under observe (want 1)"; fail=1
  fi

  # G8 — the Δ3 empty-changeset skip: a push introducing NO changes vs merge-base cannot need a
  # design GO — skipped with one disclosed line, predicate not invoked (S5's false-refusal surface).
  go_plant_stub "$T" 1 "$T/go-invoked"
  ( cd "$T" && git update-ref refs/remotes/origin/main "$HEAD" )
  rm -f "$T/go-invoked"
  go_run "$T" enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$go_rc" allow "GO leg: empty change-set vs merge-base is skipped"
  decl_expect_contains "GO leg: empty-changeset skip is disclosed" "empty change-set" "$go_out"
  decl_expect_not_invoked "GO leg: empty change-set (predicate must not run)" "$T/go-invoked"
  ( cd "$T" && git update-ref -d refs/remotes/origin/main )

  # G9/G10 — the class gate: only sensitive/control-plane proceed. A repo with a REAL diff vs its
  # origin ref, a fixture ledger, and a scripted promotion-readiness.sh stub (the same single
  # authority the decl leg's predicate uses) deciding the class.
  TG=$(mktemp -d)
  ( cd "$TG" && git init -q \
      && git -c user.email=t@kit -c user.name=kit add -A 2>/dev/null; cd "$TG" \
      && printf 'one\n' > f.txt && git add f.txt \
      && git -c user.email=t@kit -c user.name=kit commit -q -m c1 \
      && printf 'two\n' >> f.txt \
      && git -c user.email=t@kit -c user.name=kit commit -q -am c2 \
      && git update-ref refs/remotes/origin/main HEAD~1 )
  go_mkledger "$TG"
  GHEAD=$(cd "$TG" && git rev-parse HEAD)
  go_plant_stub "$TG" 1 "$TG/go-invoked"
  printf '#!/bin/sh\necho ordinary\n' > "$TG/conformance/promotion-readiness.sh"
  rm -f "$TG/go-invoked"
  go_run "$TG" enforce "refs/heads/feature/x $GHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$go_rc" allow "GO leg: ordinary change-class skips the leg"
  decl_expect_not_invoked "GO leg: ordinary class (predicate must not run)" "$TG/go-invoked"
  printf '#!/bin/sh\necho control-plane\n' > "$TG/conformance/promotion-readiness.sh"
  rm -f "$TG/go-invoked"
  go_run "$TG" enforce "refs/heads/feature/x $GHEAD refs/heads/feature/x $Z"
  [ -f "$TG/go-invoked" ] && echo "PASS: GO leg proceeds on a derived control-plane class" \
    || { echo "FAIL: GO leg must proceed on a derived control-plane class"; fail=1; }

  # G10b [REV M1] — A NEWLINE IN A CHANGED PATH MUST NOT DOWNGRADE THE CLASS. With the bare
  # `--name-only` derivation the path split into fragments, each fragment classified separately,
  # and — because is_control_plane_path carries suffix-constrained patterns — NEITHER matched: the
  # class came back `ordinary` and this leg SKIPPED. That is fail-OPEN dressed as a fail-safe.
  # The fixture's promotion-readiness.sh stub answers `ordinary` unconditionally, so if the -z
  # detector is removed the leg skips and this case reds; with it, the class is never derived at
  # all and the fail-safe HIGH path runs the predicate.
  TN=$(mktemp -d)
  ( cd "$TN" && git init -q \
      && printf 'one\n' > f.txt && git add f.txt \
      && git -c user.email=t@kit -c user.name=kit commit -q -m c1 \
      && printf 'x\n' > "$(printf 'we\nird.txt')" && git add -A \
      && git -c user.email=t@kit -c user.name=kit commit -q -m c2 \
      && git update-ref refs/remotes/origin/main HEAD~1 )
  go_mkledger "$TN"
  NHEAD=$(cd "$TN" && git rev-parse HEAD)
  go_plant_stub "$TN" 1 "$TN/go-invoked"
  printf '#!/bin/sh\necho ordinary\n' > "$TN/conformance/promotion-readiness.sh"
  rm -f "$TN/go-invoked"
  go_run "$TN" "" "refs/heads/feature/x $NHEAD refs/heads/feature/x $Z"
  [ -f "$TN/go-invoked" ] && echo "PASS: GO leg does not let a newline-in-path downgrade the class to a skip" \
    || { echo "FAIL: a newline in a changed path downgraded the class and skipped the leg (fail-open)"; fail=1; }
  decl_expect_contains "GO leg: the newline fail-safe is disclosed" "literal NEWLINE" "$go_out"

  # G11 — stdin isolation (the SEC MEDIUM-1 property, inherited): a stdin-eating predicate must not
  # swallow the guard leg's own push-to-main line. Real core; observe mode so only the guard leg
  # can refuse — the only way this fails closed is if line 2 actually reached guard_check_push.
  {
    echo '#!/bin/sh'
    echo '# supports --pre-push'
    echo 'cat >/dev/null'
    echo 'exit 1'
  } > "$T/conformance/ceremony-binding.sh"
  chmod +x "$T/conformance/ceremony-binding.sh"
  go_leak_out=$(cd "$T" && printf 'refs/heads/feature/x %s refs/heads/feature/x %s\nrefs/heads/main %s refs/heads/main %s\n' \
      "$HEAD" "$Z" "$HEAD" "$Z" \
    | KIT_GUARD_CORE="$ROOT/.claude/hooks/guard-core.sh" sh "$SELF" 2>&1)
  go_leak_rc=$?
  if [ "$go_leak_rc" -ne 0 ] && printf '%s' "$go_leak_out" | grep -q 'pushing directly to main'; then
    echo "PASS: a stdin-eating GO predicate does not swallow the guard leg's own push-to-main line"
  else
    echo "FAIL: stdin leak — the guard leg's verdict on the second (main-push) line did not fire (rc=$go_leak_rc)"
    echo "  got: $go_leak_out"
    fail=1
  fi

  # ---------------------------------------------------------------------------------------------
  # DIAL-DELIVERY Δ-A — the REPO-CARRIED dial (.kit/dials.conf) and its ASYMMETRIC precedence.
  # Every case above drives the dial through the ENVIRONMENT, which is the escalate-only override,
  # not the durable mechanism. These cases drive the conf, and they are the only ones that source
  # the REAL guard-core (kit_dial_mode lives there) instead of the permissive DECL_CORE stub — so
  # the reader under test is the shipped one, not a fixture.
  #
  # FIXTURE HERMETICITY (design §3): every case here PINS its own dial state in $T. It never
  # inherits the ambient tree's — $ROOT re-derives per invocation and the fixtures run with cwd in
  # $T, so the kit's own enforce conf is out of reach. The cases above rely on that same property
  # (conf ABSENT in $T ⇒ observe), which is why they still read as observe-by-default.
  # ---------------------------------------------------------------------------------------------
  DIAL_CORE="$T/dial-core.sh"
  printf '#!/bin/sh\n. "%s"\nguard_check_push() { return 0; }\n' \
    "$ROOT/.claude/hooks/guard-core.sh" > "$DIAL_CORE"

  dial_plant() { # <conf-line>... | '-' to REMOVE the conf — pins $T's own dial state
    rm -f "$T/.kit/dials.conf"
    [ "$1" = "-" ] && return 0
    mkdir -p "$T/.kit"
    printf '%s\n' "$@" > "$T/.kit/dials.conf"
  }
  dial_run() { # env-value ref-line -> dial_out/dial_rc, with the REAL core sourced
    dial_out=$(cd "$T" && printf '%s\n' "$2" \
      | KIT_GUARD_CORE="$DIAL_CORE" KIT_PUSH_DECL="$1" KIT_PUSH_GO="$3" sh "$SELF" 2>&1); dial_rc=$?
  }

  decl_plant_stub 1                      # a FAILING declaration predicate for every DECL case below
  rm -f "$T/conformance/ceremony-binding.sh"   # keep the GO leg N/A for the DECL cases

  # DA1 — the conf ALONE refuses. No env var carries a VALUE (dial_run exports both names as empty
  # strings, and empty is indistinguishable from unset to the reader's `${NAME:-}`) — which is the
  # whole point of the slice: an env-var flip binds nothing, while repo-carried state binds without
  # anyone remembering to export.
  dial_plant 'KIT_PUSH_DECL=enforce'
  dial_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z" ""
  decl_expect_rc "$dial_rc" refuse "conf DECL=enforce refuses with NO env var set"
  decl_expect_contains "conf-driven refusal uses the enforce prefix" "kit pre-push:" "$dial_out"

  # DA2 — conf `observe` is observe (the liveness anchor's opposite: a reader that answered
  # `enforce` for any parseable conf would pass DA1 and fail here).
  dial_plant 'KIT_PUSH_DECL=observe'
  dial_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z" ""
  decl_expect_rc "$dial_rc" allow "conf DECL=observe allows"
  decl_expect_contains "conf observe prints the observe prefix" "kit pre-push (observe):" "$dial_out"

  # DA3 — ESCALATION is permitted: env `enforce` over a conf `observe` refuses.
  dial_plant 'KIT_PUSH_DECL=observe'
  dial_run enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z" ""
  decl_expect_rc "$dial_rc" refuse "env enforce ESCALATES a conf observe"

  # DA4 — DE-ESCALATION LOSES, LOUDLY. This is the owner-lens finding the whole precedence rule
  # exists for: env-wins would leave the flip one silent, sticky `export KIT_PUSH_DECL=observe`
  # from undone — a bypass cheaper than --no-verify, which at least announces itself per command.
  dial_plant 'KIT_PUSH_DECL=enforce'
  dial_run observe "refs/heads/feature/x $HEAD refs/heads/feature/x $Z" ""
  decl_expect_rc "$dial_rc" refuse "env observe CANNOT de-escalate a conf enforce"
  decl_expect_contains "the de-escalation attempt is announced" "cannot de-escalate" "$dial_out"
  decl_expect_contains "the anomaly line names the durable dial file" ".kit/dials.conf" "$dial_out"

  # DA5 — an ABSENT conf is observe (fail-safe; and the export ships no conf, so this IS the
  # adopter's first-run face). A garbage value is observe too — the exact-string rule, conf side.
  dial_plant -
  dial_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z" ""
  decl_expect_rc "$dial_rc" allow "absent conf = observe (fail-safe; the adopter export's face)"
  dial_plant 'KIT_PUSH_DECL=1'
  dial_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z" ""
  decl_expect_rc "$dial_rc" allow "conf DECL=1 is NOT the exact string — stays observe"
  # ...and a conf line for a DIFFERENT dial must not answer this one (a `grep enforce` reader would
  # pass every case above and refuse here).
  dial_plant 'KIT_PUSH_GO=enforce'
  dial_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z" ""
  decl_expect_rc "$dial_rc" allow "a conf entry for ANOTHER dial does not enforce this one"

  # DA6 — GUARD SKEW: a re-copied newer hook over an OLDER tree guard-core that lacks
  # kit_dial_mode must fall back to the bare env read QUIETLY (fail-open toward observe, the
  # acceptable direction) — never spray "command not found" and never refuse on the conf it
  # cannot read. DECL_CORE is exactly that older core: it defines guard_check_push and nothing else.
  dial_plant 'KIT_PUSH_DECL=enforce'
  decl_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$decl_rc" allow "skew: a guard-core without kit_dial_mode falls back to the env read"
  case "$decl_out" in
    *'not found'*) echo "FAIL: skew fallback sprayed a 'not found' diagnostic: $decl_out"; fail=1 ;;
    *) echo "PASS: skew fallback is quiet (no 'not found' spray)" ;;
  esac
  decl_run enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$decl_rc" refuse "skew: the env dial still works through the fallback"

  # DA7 — the GO leg reads the SAME conf (both go_relay branches). The fixture ledger exists in $T,
  # no origin ref does (deleted by G8), so the class is underivable => fail-safe HIGH => the
  # predicate runs and fails: the only thing deciding the rc here is the dial.
  rm -f "$T/conformance/loop-state.sh"          # decl leg N/A for the GO cases
  go_plant_stub "$T" 1
  dial_plant 'KIT_PUSH_GO=enforce'
  dial_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z" ""
  decl_expect_rc "$dial_rc" refuse "conf GO=enforce refuses with NO env var set"
  decl_expect_contains "conf-driven GO refusal names the record command" "promotion-verify.sh record" "$dial_out"
  dial_plant 'KIT_PUSH_GO=observe'
  dial_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z" ""
  decl_expect_rc "$dial_rc" allow "conf GO=observe allows"
  # ...and the 2-REF-LINE SHAPE. ⚠️ READ THE CLAIM CAREFULLY (corrected, review round 1): this case
  # does NOT discriminate the memoized branch's dial read. The push loop's `status` is STICKY (the
  # ref-line while-loop's status accumulator is set to 1 and never cleared), so under conf enforce the FIRST relay's `return 1` has
  # already decided the exit code before the memoized branch is reached — a mutant reverting that
  # branch to the bare env read SURVIVES every case in this file. What the case pins is the shape:
  # a multi-ref-line push under a conf-driven enforce still refuses, and still relays once. The
  # memoized site's conf read is therefore DEFENCE IN DEPTH against a future de-memoisation, not a
  # mutant-killed assertion — and since hooks/* is outside non-vacuity's sweep (target regex is
  # `conformance/*.sh`), hand-built mutant discrimination is the only substitute control, so a claim
  # it cannot support must not be made here. Design §10 amendment A4 records the correction.
  dial_plant 'KIT_PUSH_GO=enforce'
  dial_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z
refs/heads/feature/y $HEAD refs/heads/feature/y $Z" ""
  decl_expect_rc "$dial_rc" refuse "conf GO=enforce refuses on a 2-branch push (rc decided by the FIRST relay; memoized site rc-unobservable)"
  dial_plant -

  # ---------------------------------------------------------------------------------------------
  # DC — the SIXTH DIAL (KIT_PUSH_CITE, ruling D-240815-2d): the citation-liveness leg. Hand-built,
  # because hooks/pre-push is OUTSIDE non-vacuity.sh's mutation sweep (its target regex is
  # `conformance/[a-z0-9-]+\.sh`, measured — see the row comment in conformance/verify.sh), so
  # hand-run discrimination is the ONLY substitute control this leg gets. The battery therefore
  # mirrors DA1-DA7 case for case, plus the two capture conventions the design vet pinned (C4).
  # The predicate is a planted STUB conformance/citation-live.sh inside $T, never the real script —
  # the real one is proven where it lives (citation-live.sh --selftest).
  # ---------------------------------------------------------------------------------------------
  rm -f "$T/conformance/ceremony-binding.sh" "$T/conformance/loop-state.sh"   # both siblings N/A here

  cite_plant_stub() { # rc [record-file] — a scripted conformance/citation-live.sh stub inside $T.
    # ⚠️ IT PRINTS ITS VERDICT ON **STDOUT**, deliberately, because the real check does: the named
    # DECAYED sites and the summary are stdout verdicts, and only the dial hint/remedy this hook adds
    # is stderr. A leg that copied the GO leg's stderr-only capture would relay a refusal carrying no
    # site at all. The stub also writes one stderr line, so a capture that took stdout ALONE would be
    # equally visible. Two needles, one for each stream.
    mkdir -p "$T/conformance"
    _cps_rc=$1; _cps_rec=${2:-}
    {
      echo '#!/bin/sh'
      [ -n "$_cps_rec" ] && printf 'echo called >> "%s"\n' "$_cps_rec"
      echo 'echo "DECAYED  docs/a.md:7 cites stub-target.md:99 -- stub decayed site"'
      echo 'echo "citation-live: stub stderr line" >&2'
      printf 'exit %s\n' "$_cps_rc"
    } > "$T/conformance/citation-live.sh"
    chmod +x "$T/conformance/citation-live.sh"
  }
  cite_run() { # KIT_PUSH_CITE-value ref-line(s) -> sets cite_out, cite_rc; the REAL core is sourced
    cite_out=$(cd "$T" && printf '%s\n' "$2" \
      | KIT_GUARD_CORE="$DIAL_CORE" KIT_PUSH_CITE="$1" sh "$SELF" 2>&1); cite_rc=$?
  }

  # DC0 — POSITIVE CONTROL, first: without it an always-skip mutant satisfies every negative below.
  # A normal branch line must INVOKE the predicate, and a PASSING predicate's own words must reach the
  # operator under the MODE-NEUTRAL `(note)` prefix — never `(observe)`, which would report the dial
  # as off on a tree where this case has it ESCALATED to enforce.
  cite_plant_stub 0 "$T/cite-invoked"
  rm -f "$T/cite-invoked"
  cite_run enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$cite_rc" allow "CITE leg: a passing predicate allows the push"
  [ -f "$T/cite-invoked" ] && echo "PASS: CITE leg invokes the predicate on a normal branch line (record control)" \
    || { echo "FAIL: CITE leg must invoke the predicate on a normal branch line (record control)"; fail=1; }
  decl_expect_contains "CITE leg: the rc-0 relay carries the mode-neutral note prefix" "kit pre-push (note):" "$cite_out"
  case "$cite_out" in
    *'kit pre-push (observe):'*) echo "FAIL: the CITE rc-0 pass-relay must NOT claim observe on an enforcing dial"; fail=1 ;;
    *) echo "PASS: the CITE rc-0 pass-relay does not misreport the dial as observe" ;;
  esac

  # DC-C4a — THE CAPTURE IS **COMBINED**, and this is the case that proves it. The stub's verdict is
  # on STDOUT (as the real check's is); the stderr-only idiom copied from the GO leg would relay a
  # refusal with NO NAMED SITE on it. Both streams must survive the relay.
  cite_plant_stub 1
  cite_run enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$cite_rc" refuse "CITE leg: enforce + a decayed corpus refuses the push"
  decl_expect_contains "CITE leg relays the predicate's STDOUT verdict (combined capture, vet C4a)" "stub decayed site" "$cite_out"
  decl_expect_contains "CITE leg relays the predicate's stderr line too" "citation-live: stub stderr line" "$cite_out"
  decl_expect_contains "CITE leg enforce names the re-cite remedy" "re-cite by row identifier" "$cite_out"
  decl_expect_contains "CITE leg enforce names the doctrine's home" "DEVELOPMENT-STANDARDS.md section 11" "$cite_out"
  decl_expect_contains "CITE leg enforce keeps the --no-verify honesty line" "--no-verify" "$cite_out"

  # DC-rc2 — FAIL-CLOSED on could-not-evaluate: rc 2 refuses under enforce exactly like rc 1.
  cite_plant_stub 2
  cite_run enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$cite_rc" refuse "CITE leg: enforce + predicate rc 2 (could-not-evaluate) fails closed"
  decl_expect_contains "CITE leg rc-2 enforce keeps the --no-verify honesty line" "--no-verify" "$cite_out"

  # DC-observe — the env-driven observe side still prints (loud), and allows.
  cite_plant_stub 1
  cite_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$cite_rc" allow "CITE leg: observe + a decayed corpus still allows the push"
  decl_expect_contains "CITE leg observe uses the observe prefix" "kit pre-push (observe):" "$cite_out"
  decl_expect_contains "CITE leg observe hints the enforce dial" "KIT_PUSH_CITE=enforce" "$cite_out"
  decl_expect_contains "CITE leg observe still relays the named site" "stub decayed site" "$cite_out"

  # DC1 — THE CONF ALONE REFUSES, with NO env var carrying a value. The whole point of the repo-carried
  # dial: nobody has to remember to export anything.
  dial_plant 'KIT_PUSH_CITE=enforce'
  cite_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$cite_rc" refuse "conf CITE=enforce refuses with NO env var set"
  decl_expect_contains "conf-driven CITE refusal uses the enforce prefix" "kit pre-push:" "$cite_out"
  decl_expect_contains "conf-driven CITE refusal names the re-cite remedy" "re-cite by row identifier" "$cite_out"

  # DC2 — conf `observe` is observe (a reader answering `enforce` for any parseable conf passes DC1
  # and fails here).
  dial_plant 'KIT_PUSH_CITE=observe'
  cite_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$cite_rc" allow "conf CITE=observe allows"
  decl_expect_contains "conf CITE=observe prints the observe prefix" "kit pre-push (observe):" "$cite_out"

  # DC3 — ESCALATION is permitted: env `enforce` over a conf `observe` refuses.
  dial_plant 'KIT_PUSH_CITE=observe'
  cite_run enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$cite_rc" refuse "env enforce ESCALATES a conf observe (CITE)"

  # DC4 — DE-ESCALATION LOSES, LOUDLY. Env-wins would leave the flip one silent, sticky `export` from
  # undone — a bypass cheaper than --no-verify, which at least announces itself per command.
  dial_plant 'KIT_PUSH_CITE=enforce'
  cite_run observe "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$cite_rc" refuse "env observe CANNOT de-escalate a conf enforce (CITE)"
  decl_expect_contains "the CITE de-escalation attempt is announced" "cannot de-escalate" "$cite_out"
  decl_expect_contains "the CITE anomaly line names the durable dial file" ".kit/dials.conf" "$cite_out"

  # DC5 — an ABSENT conf is observe (fail-safe; the export ships no conf, so this IS the adopter's
  # first-run face for this dial).
  dial_plant -
  cite_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$cite_rc" allow "absent conf = observe for CITE (the adopter export's face)"

  # DC6 — THE EXACT-STRING RULE, conf side AND env side. This is the mutant that survived the whole
  # suite twice historically: `[ "$X" = "enforce" ]` -> `[ -n "$X" ]` turns the truthy-looking value an
  # operator would plausibly type into a REFUSAL for a dial the docs call observe-only.
  dial_plant 'KIT_PUSH_CITE=1'
  cite_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$cite_rc" allow "conf CITE=1 is NOT the exact string — stays observe"
  dial_plant -
  cite_run 1 "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$cite_rc" allow "dial: KIT_PUSH_CITE=1 is NOT the exact string — stays observe"
  decl_expect_contains "dial: KIT_PUSH_CITE=1 prints the observe prefix" "kit pre-push (observe):" "$cite_out"

  # DC7 — a conf entry for ANOTHER dial must not answer this one (a `grep enforce` reader would pass
  # every case above and refuse here).
  dial_plant 'KIT_PUSH_GO=enforce'
  cite_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$cite_rc" allow "a conf entry for ANOTHER dial does not enforce CITE"
  dial_plant 'KIT_PUSH_DECL=enforce'
  cite_run "" "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$cite_rc" allow "a conf entry for the DECL dial does not enforce CITE either"
  dial_plant -

  # DC8 — DISPATCH (D1, inherited verbatim): deletions, tags and the default branch never reach the
  # predicate; and D2 — an absent predicate script N/As SILENTLY (first-run-green on adopter trees).
  cite_plant_stub 1 "$T/cite-invoked"
  rm -f "$T/cite-invoked"
  cite_run enforce "refs/heads/feature/x $Z refs/heads/feature/x $HEAD"
  decl_expect_not_invoked "CITE leg: deletion line (zero local_sha)" "$T/cite-invoked"
  rm -f "$T/cite-invoked"
  cite_run enforce "refs/tags/v1 $HEAD refs/tags/v1 $Z"
  decl_expect_not_invoked "CITE leg: tag line (remote_ref not refs/heads/*)" "$T/cite-invoked"
  rm -f "$T/cite-invoked"
  cite_run enforce "refs/heads/main $HEAD refs/heads/main $Z"
  decl_expect_not_invoked "CITE leg: default-branch line (refs/heads/main)" "$T/cite-invoked"
  rm -f "$T/conformance/citation-live.sh"
  cite_run enforce "refs/heads/feature/x $HEAD refs/heads/feature/x $Z"
  decl_expect_rc "$cite_rc" allow "CITE leg: an absent predicate script allows the push"
  [ -z "$cite_out" ] && echo "PASS: CITE leg absent predicate script is silent (D2)" \
    || { echo "FAIL: CITE leg absent predicate must be silent, got: $cite_out"; fail=1; }

  # DC9 [SEC MEDIUM-1, vet C4b] — STDIN ISOLATION. A predicate that reads stdin must not swallow the
  # push-protocol lines the guard leg still has to grade. Real core; the CITE dial left unset (observe)
  # so this leg itself can never refuse — the ONLY way this case fails closed is if line 2 actually
  # reached guard_check_push.
  {
    echo '#!/bin/sh'
    echo 'cat >/dev/null'
    echo 'exit 1'
  } > "$T/conformance/citation-live.sh"
  chmod +x "$T/conformance/citation-live.sh"
  cite_leak_out=$(cd "$T" && printf 'refs/heads/feature/x %s refs/heads/feature/x %s\nrefs/heads/main %s refs/heads/main %s\n' \
      "$HEAD" "$Z" "$HEAD" "$Z" \
    | KIT_GUARD_CORE="$ROOT/.claude/hooks/guard-core.sh" sh "$SELF" 2>&1)
  cite_leak_rc=$?
  if [ "$cite_leak_rc" -ne 0 ] && printf '%s' "$cite_leak_out" | grep -q 'pushing directly to main'; then
    echo "PASS: a stdin-eating CITE predicate does not swallow the guard leg's own push-to-main line"
  else
    echo "FAIL: stdin leak — the guard leg's verdict on the second (main-push) line did not fire (rc=$cite_leak_rc)"
    echo "  got: $cite_leak_out"
    fail=1
  fi
  rm -f "$T/conformance/citation-live.sh"

  # ---------------------------------------------------------------------------------------------
  # PP — the BOARD-PRESENCE leg (presence_check_ref), the fourth dial KIT_PUSH_PRESENCE.
  # Same isolation pattern as every leg above: the permissive DECL_CORE (or DIAL_CORE for the conf
  # cases) isolates the guard leg, and BOTH predicates are planted STUBS inside the fixture — the
  # real ones are proven where they live (backlog-presence.sh --selftest, ceremony-binding.sh legs
  # P8a-d). What is under test here is the LEG: its dispatch, its skew probes, its class gate, its
  # Δ1 read of the board AT THE PUSHED SHA, its rc-partition handling of the scope-key surface, and
  # its dial.
  # ---------------------------------------------------------------------------------------------
  TP=$(mktemp -d)
  # c0 = the merge-base (origin/main). c1 carries board v1 — it is the sha the PP7 fixture PUSHES.
  # c2 (HEAD) carries board v2, and the working tree carries v3: three distinct boards, so a leg
  # reading HEAD or the worktree instead of the pushed sha is DISCRIMINATED rather than assumed.
  ( cd "$TP" && git init -q \
      && printf 'seed\n' > README.md && git add -A \
      && git -c user.email=t@kit -c user.name=kit commit -q -m c0 \
      && git update-ref refs/remotes/origin/main HEAD \
      && printf 'board v1\n' > BACKLOG.md \
      && printf '%s\n' '- **Backlog backend**: md' > CLAUDE.md \
      && printf 'one\n' > f.txt && git add -A \
      && git -c user.email=t@kit -c user.name=kit commit -q -m c1 \
      && printf 'board v2\n' > BACKLOG.md && git add -A \
      && git -c user.email=t@kit -c user.name=kit commit -q -m c2 \
      && printf 'board v3\n' > BACKLOG.md )
  PHEAD=$(cd "$TP" && git rev-parse HEAD)
  PONE=$(cd "$TP" && git rev-parse HEAD~1)
  go_mkledger "$TP"     # so the GO leg is quiet (it passes on the stub) rather than nudging a fetch

  # ⚠️ ONE STUB SERVES TWO LEGS, AND THAT IS WHY IT DISPATCHES ON ARGV. conformance/ceremony-binding.sh
  # is ALSO the GO leg's predicate, so a stub that answered unconditionally would make every case
  # below carry the GO leg's prose (measured on first write: PP2's silence assertion reddened on the
  # GO leg's version-skew note) or, worse, let a scripted rc meant for the scope key decide the GO
  # leg's verdict too. `--pre-push` therefore always passes silently here; only `--print-scope-key`
  # carries the scripted behaviour. A fixture ledger is created alongside, so the GO leg does not
  # print its absent-ledger nudge either.
  pp_plant_key() { # dir [--no-arm] — the ceremony-binding stub answering the scope key.
    # It advertises the dispatch ARM TOKEN (`--print-scope-key)`), because the leg's skew probe keys
    # on the arm, not the bare flag: the real file's HEADER names the flag in prose, so a bare-flag
    # grep would be tautologically true there and the probe would never fire (design A1-1).
    mkdir -p "$1/conformance"
    {
      echo '#!/bin/sh'
      echo 'case "$1" in --pre-push) exit 0 ;; esac'
      [ "${2:-}" = "--no-arm" ] \
        || echo 'case "$1" in --print-scope-key) printf "branch/feature/x\n"; exit 0 ;; esac'
      echo 'echo "ceremony-binding: unknown arg" >&2; exit 2'
    } > "$1/conformance/ceremony-binding.sh"
    chmod +x "$1/conformance/ceremony-binding.sh"
  }
  pp_plant_key_rc() { # dir rc [stderr-line] — a scope-key stub with a scripted rc
    mkdir -p "$1/conformance"
    {
      echo '#!/bin/sh'
      echo 'case "$1" in --pre-push) exit 0 ;; esac'
      echo 'case "$1" in --print-scope-key)'
      [ -n "${3:-}" ] && printf '  echo "%s" >&2\n' "$3"
      printf '  exit %s ;;\n' "$2"
      echo 'esac'
      echo 'echo "ceremony-binding: unknown arg" >&2; exit 2'
    } > "$1/conformance/ceremony-binding.sh"
    chmod +x "$1/conformance/ceremony-binding.sh"
  }
  pp_plant_pred() { # dir rc [record-file] [dir-record-file] [--no-arm]
    mkdir -p "$1/conformance"
    _ppp_rc=$2; _ppp_rec=${3:-}; _ppp_dr=${4:-}; _ppp_arm=${5:-}
    {
      echo '#!/bin/sh'
      [ "$_ppp_arm" = "--no-arm" ] || echo '#   --branch)'
      [ -n "$_ppp_rec" ] && printf 'echo called >> "%s"\n' "$_ppp_rec"
      # $2 is the --dir VALUE (argv is `--dir <d> --pr 0 --changed <l> --branch <b>`). The stub
      # records the board's CONTENT, not the directory: the leg removes its temp dir before
      # returning (as it must), so a recorded PATH is unreadable by the time the leg asserts on it
      # — measured on first write, PP7 read '' and could not tell a wrong board from a cleaned one.
      [ -n "$_ppp_dr" ] && printf 'cat "$2/BACKLOG.md" >> "%s" 2>/dev/null\n' "$_ppp_dr"
      # STDOUT, as the real gate prints its verdict — a stderr-only capture would relay a refusal
      # with no verdict line on it.
      echo 'echo "FAIL: backlog-presence — no board row bears branch (stub verdict)"'
      echo 'echo "  remedy: move your row to In Review and put the branch in its PR cell (stub)"'
      printf 'exit %s\n' "$_ppp_rc"
    } > "$1/conformance/backlog-presence.sh"
    chmod +x "$1/conformance/backlog-presence.sh"
  }
  pp_plant_class() { # dir class-word
    mkdir -p "$1/conformance"
    printf '#!/bin/sh\necho %s\n' "$2" > "$1/conformance/promotion-readiness.sh"
    chmod +x "$1/conformance/promotion-readiness.sh"
  }
  pp_run() { # dir KIT_PUSH_PRESENCE-value ref-line(s) -> pp_out, pp_rc
    pp_out=$(cd "$1" && printf '%s\n' "$3" \
      | KIT_GUARD_CORE="$DECL_CORE" KIT_PUSH_PRESENCE="$2" sh "$SELF" 2>&1); pp_rc=$?
  }

  # PP2 (POSITIVE CONTROL, first — without it every negative below passes vacuously against an
  # always-skip leg): a gated class + a PASSING predicate is allowed, SILENT, and the predicate was
  # actually INVOKED.
  pp_plant_key "$TP"; pp_plant_class "$TP" control-plane
  pp_plant_pred "$TP" 0 "$TP/pp-invoked"
  rm -f "$TP/pp-invoked"
  pp_run "$TP" enforce "refs/heads/feature/x $PHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" allow "PP2: enforce + a passing presence predicate allows the push"
  [ -f "$TP/pp-invoked" ] && echo "PASS: PP2 the presence predicate was invoked (record control)" \
    || { echo "FAIL: PP2 the presence predicate must be invoked on a gated branch line"; fail=1; }
  [ -z "$pp_out" ] && echo "PASS: PP2 a passing presence predicate is silent" \
    || { echo "FAIL: PP2 a passing presence predicate must be silent, got: $pp_out"; fail=1; }

  # PP1 — enforce + rc 1 REFUSES, relaying the gate's own STDOUT verdict and its remedy, and keeping
  # the honesty line. The remedy text is the GATE's (it is graded where it lives); the hook adds only
  # the prefix and the --no-verify disclosure.
  pp_plant_pred "$TP" 1
  pp_run "$TP" enforce "refs/heads/feature/x $PHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" refuse "PP1: enforce + an unbound board row refuses the push"
  decl_expect_contains "PP1 uses the enforce prefix" "kit pre-push:" "$pp_out"
  decl_expect_contains "PP1 relays the gate's STDOUT verdict" "no board row bears branch (stub verdict)" "$pp_out"
  decl_expect_contains "PP1 relays the gate's remedy line" "remedy:" "$pp_out"
  decl_expect_contains "PP1 keeps the --no-verify honesty line" "--no-verify" "$pp_out"

  # PP3 — observe + rc 1: allowed, loud, with the dial hint.
  pp_run "$TP" "" "refs/heads/feature/x $PHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" allow "PP3: observe + an unbound board row still allows the push"
  decl_expect_contains "PP3 uses the observe prefix" "kit pre-push (observe):" "$pp_out"
  decl_expect_contains "PP3 hints the enforce dial" "KIT_PUSH_PRESENCE=enforce" "$pp_out"
  decl_expect_contains "PP3 still relays the verdict" "no board row bears branch (stub verdict)" "$pp_out"
  # ...and the dial is an EXACT-STRING test, the mutant that has survived three other legs' batteries.
  pp_run "$TP" 1 "refs/heads/feature/x $PHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" allow "PP3b: KIT_PUSH_PRESENCE=1 is NOT the exact string — stays observe"

  # PP4 — an ORDINARY change-class never reaches the predicate.
  pp_plant_class "$TP" ordinary
  pp_plant_pred "$TP" 1 "$TP/pp-invoked"
  rm -f "$TP/pp-invoked"
  pp_run "$TP" enforce "refs/heads/feature/x $PHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" allow "PP4: an ordinary change-class allows the push"
  decl_expect_not_invoked "PP4: ordinary class (presence predicate must not run)" "$TP/pp-invoked"
  pp_plant_class "$TP" control-plane

  # PP5 — DETACHED HEAD is the leg's ONLY N/A among the scope-key outcomes: a detached push carries
  # no branch, so no board row could be keyed to it, and CI keys on the PR instead.
  pp_plant_key_rc "$TP" 1
  pp_plant_pred "$TP" 1 "$TP/pp-invoked"
  rm -f "$TP/pp-invoked"
  pp_run "$TP" enforce "refs/heads/feature/x $PHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" allow "PP5: a detached HEAD is N/A even under enforce"
  decl_expect_contains "PP5 names the detached state" "detached" "$pp_out"
  decl_expect_not_invoked "PP5: detached HEAD (presence predicate must not run)" "$TP/pp-invoked"

  # PP5b (A1-1, the HIGH) — rc 2 is NOT an N/A. It is a COULD-NOT-EVALUATE anomaly routed through the
  # dial: refused under enforce with the reason relayed, allowed-and-loud under observe. A leg that
  # collapsed rc 2 into the detached N/A would stop grading silently on every charset-out branch and,
  # worse, on every bad invocation (which shares rc 2 in the file's other modes).
  pp_plant_key_rc "$TP" 2 "ceremony-binding: the branch name is outside the scope charset"
  pp_run "$TP" enforce "refs/heads/feature/x $PHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" refuse "PP5b: a scope-key rc 2 is an anomaly, REFUSED under enforce"
  decl_expect_contains "PP5b relays the anomaly's reason" "outside the scope charset" "$pp_out"
  pp_run "$TP" "" "refs/heads/feature/x $PHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" allow "PP5b: the same anomaly is loud but allowed under observe"
  decl_expect_contains "PP5b observe still names the reason" "outside the scope charset" "$pp_out"

  # PP5c — rc 0 with EMPTY stdout is the same anomaly (a key that is not a key evaluates nothing),
  # and the relayed text must SAY which of the two it was (R7): "exited 2" and "exited 0 but printed
  # no key" send the reader to different places.
  pp_plant_key_rc "$TP" 0
  pp_run "$TP" enforce "refs/heads/feature/x $PHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" refuse "PP5c: rc 0 with no key printed is an anomaly, REFUSED under enforce"
  decl_expect_contains "PP5c names the empty-key failure precisely" "it exited 0 but printed no key" "$pp_out"

  # PP5d (security S1) — rc 1 WITH A REASON ON STDERR IS NOT A DETACHED HEAD. ceremony-binding.sh is
  # `set -eu` and sources a library, so a preamble failure exits non-zero WITH a reason, rc 1 among
  # them; the derivation's own detached path prints NOTHING. A leg keyed on the rc alone would print
  # "detached HEAD" at an operator who is not detached and allow the push on a broken predicate.
  pp_plant_key_rc "$TP" 1 "ceremony-binding: obligation-lib.sh: not found"
  pp_plant_pred "$TP" 1 "$TP/pp-invoked"
  rm -f "$TP/pp-invoked"
  pp_run "$TP" enforce "refs/heads/feature/x $PHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" refuse "PP5d: rc 1 WITH stderr is an anomaly, REFUSED under enforce (not a detached N/A)"
  decl_expect_contains "PP5d relays the real reason" "obligation-lib.sh: not found" "$pp_out"
  case "$pp_out" in
    *detached*) echo "FAIL: PP5d a broken predicate must not be reported as a detached HEAD"; fail=1 ;;
    *) echo "PASS: PP5d a broken predicate is not misreported as a detached HEAD" ;;
  esac
  pp_run "$TP" "" "refs/heads/feature/x $PHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" allow "PP5d: the same anomaly is loud but allowed under observe"
  decl_expect_contains "PP5d observe still names the reason" "obligation-lib.sh: not found" "$pp_out"

  # PP6 / PP6b — VERSION SKEW on EITHER predicate is an N/A naming the skew, never a refusal. An
  # older ceremony-binding.sh answers `unknown arg` rc 2 (which PP5b just made a refusal), and an
  # older backlog-presence.sh answers usage rc 2 for `--branch` — both would be relayed as "your
  # board row is missing", an instruction that cannot fix the real problem.
  pp_plant_key "$TP" --no-arm
  pp_plant_pred "$TP" 1 "$TP/pp-invoked"
  rm -f "$TP/pp-invoked"
  pp_run "$TP" enforce "refs/heads/feature/x $PHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" allow "PP6: a checkout predating --print-scope-key is N/A even under enforce"
  decl_expect_contains "PP6 names the real reason" "predates --print-scope-key" "$pp_out"
  decl_expect_not_invoked "PP6: scope-key skew (presence predicate must not run)" "$TP/pp-invoked"
  pp_plant_key "$TP"
  pp_plant_pred "$TP" 1 "$TP/pp-invoked" "" --no-arm
  rm -f "$TP/pp-invoked"
  pp_run "$TP" enforce "refs/heads/feature/x $PHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" allow "PP6b: a backlog-presence.sh predating --branch is N/A under enforce"
  decl_expect_contains "PP6b names the real reason" "predates --branch" "$pp_out"

  # PP7 (Δ1 + A1-3) — THE BOARD IS READ AT THE PUSHED SHA. The pushed line names c1 (board v1) while
  # HEAD is c2 (board v2) and the working tree holds v3. The gate must be pointed at a directory
  # whose BACKLOG.md is v1 — not HEAD's, not the tree's — and the divergence from the working tree
  # must be disclosed, because "board edited, not committed, pushed" is precisely the miss this leg
  # exists to catch and the operator needs to be told which board was graded.
  pp_plant_pred "$TP" 1 "" "$TP/pp-dir"
  rm -f "$TP/pp-dir"
  pp_run "$TP" enforce "refs/heads/feature/x $PONE refs/heads/feature/x $Z"
  _pp_board=$(head -1 "$TP/pp-dir" 2>/dev/null)
  if [ "$_pp_board" = "board v1" ]; then
    echo "PASS: PP7 the gate graded the board AT THE PUSHED SHA (v1), not HEAD's (v2) or the tree's (v3)"
  else
    echo "FAIL: PP7 the gate was pointed at a board reading '$_pp_board' (want 'board v1')"; fail=1
  fi
  decl_expect_contains "PP7 discloses that the working-tree board differs" "PUSHED COMMIT" "$pp_out"

  # PP7b (A1-6) — a SYMLINKED board at the pushed sha is N/A. `git show` would hand back the link
  # TEXT, and the gate would grade a one-line file that is not a board at all.
  TPL=$(mktemp -d)
  ( cd "$TPL" && git init -q \
      && printf 'seed\n' > README.md && git add -A \
      && git -c user.email=t@kit -c user.name=kit commit -q -m c0 \
      && git update-ref refs/remotes/origin/main HEAD \
      && ln -s elsewhere.md BACKLOG.md \
      && printf '%s\n' '- **Backlog backend**: md' > CLAUDE.md \
      && printf 'one\n' > f.txt && git add -A \
      && git -c user.email=t@kit -c user.name=kit commit -q -m c1 )
  LHEAD=$(cd "$TPL" && git rev-parse HEAD)
  go_mkledger "$TPL"
  pp_plant_key "$TPL"; pp_plant_class "$TPL" control-plane
  pp_plant_pred "$TPL" 1 "$TPL/pp-invoked"
  rm -f "$TPL/pp-invoked"
  pp_run "$TPL" enforce "refs/heads/feature/x $LHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" allow "PP7b: a symlinked board at the pushed sha is N/A"
  decl_expect_contains "PP7b names the symlink" "symlink" "$pp_out"
  decl_expect_not_invoked "PP7b: symlinked board (presence predicate must not run)" "$TPL/pp-invoked"

  # PP7c (A1-5) — mktemp FAILING is a could-not-evaluate anomaly, not a silent skip: without a temp
  # dir the board cannot be extracted at the pushed sha, and a leg that quietly returned 0 there
  # would stop grading on exactly the machines where something is already wrong.
  # ⚠️ THE FIXTURE IS A PATH SHIM, NOT AN UNWRITABLE TMPDIR. Measured on macOS: `TMPDIR=<missing>
  # mktemp -d` IGNORES the variable and succeeds in /var/folders (rc 0), while glibc's fails — a
  # TMPDIR fixture would therefore assert one thing on the dev machine and another on CI, the
  # fixture-hermeticity class this file has been bitten by before. A `mktemp` that exits 1, first on
  # PATH, fails identically everywhere.
  mkdir -p "$TP/nomktemp"
  printf '#!/bin/sh\nexit 1\n' > "$TP/nomktemp/mktemp"
  chmod +x "$TP/nomktemp/mktemp"
  pp_plant_pred "$TP" 0 "$TP/pp-invoked"
  rm -f "$TP/pp-invoked"
  pp_out=$(cd "$TP" && printf 'refs/heads/feature/x %s refs/heads/feature/x %s\n' "$PHEAD" "$Z" \
    | KIT_GUARD_CORE="$DECL_CORE" KIT_PUSH_PRESENCE=enforce PATH="$TP/nomktemp:$PATH" sh "$SELF" 2>&1)
  pp_rc=$?
  decl_expect_rc "$pp_rc" refuse "PP7c: a temp-dir failure is an anomaly, REFUSED under enforce"
  decl_expect_contains "PP7c names the temp-dir failure" "temporary directory" "$pp_out"

  # PP-S2 — AN UNDERIVABLE CLASS MUST NOT BLAME THE BOARD. With no origin ref there is no merge-base,
  # so the class cannot be derived and the change is graded gated as a fail-safe. The refusal that
  # follows says "no board row bears branch …", which is TRUE and MISLEADING on its own: the row may
  # be entirely beside the point. The disclosure travels with the verdict.
  TPU=$(mktemp -d)
  ( cd "$TPU" && git init -q \
      && printf 'seed\n' > README.md \
      && printf 'board\n' > BACKLOG.md \
      && printf '%s\n' '- **Backlog backend**: md' > CLAUDE.md \
      && git add -A \
      && git -c user.email=t@kit -c user.name=kit commit -q -m c0 )
  UHEAD=$(cd "$TPU" && git rev-parse HEAD)
  go_mkledger "$TPU"
  pp_plant_key "$TPU"; pp_plant_class "$TPU" control-plane
  pp_plant_pred "$TPU" 1
  pp_run "$TPU" enforce "refs/heads/feature/x $UHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" refuse "PP-S2: an underivable class still refuses under enforce (fail-safe HIGH)"
  decl_expect_contains "PP-S2 discloses that the class could not be derived" "the change-class could not be derived locally" "$pp_out"

  # PP-S4 — A REFUSAL IS NEVER MUTE. A predicate that exits non-zero having printed nothing must not
  # produce a bare honesty line with no reason above it.
  mkdir -p "$TP/conformance"
  {
    echo '#!/bin/sh'
    echo '#   --branch)'
    echo 'exit 2'
  } > "$TP/conformance/backlog-presence.sh"
  chmod +x "$TP/conformance/backlog-presence.sh"
  pp_run "$TP" enforce "refs/heads/feature/x $PHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" refuse "PP-S4: a silent non-zero predicate still refuses under enforce"
  decl_expect_contains "PP-S4 names the mute failure instead of refusing wordlessly" "with no verdict" "$pp_out"

  # PP8 — TWO ref-lines at the SAME sha: the predicate is consulted ONCE (design §3.2(6) — the whole
  # judgment depends only on the pushed sha and the ambient tree, and extracting a board plus running
  # the gate twice for one answer is pure cost), the verdict block appears ONCE (a second copy
  # carries no information and buries the first), and NOTHING is left behind under the fixture's
  # TMPDIR (A1-4: the shared listing and the extracted board are removed on every return path).
  mkdir -p "$TP/tmpcount"
  pp_plant_pred "$TP" 1 "$TP/pp-count"
  rm -f "$TP/pp-count"
  pp_out=$(cd "$TP" && printf 'refs/heads/feature/x %s refs/heads/feature/x %s\nrefs/heads/feature/y %s refs/heads/feature/y %s\n' \
      "$PHEAD" "$Z" "$PHEAD" "$Z" \
    | KIT_GUARD_CORE="$DECL_CORE" KIT_PUSH_PRESENCE=enforce TMPDIR="$TP/tmpcount" sh "$SELF" 2>&1)
  pp_rc=$?
  _pp_calls=$(wc -l < "$TP/pp-count" 2>/dev/null | tr -d ' '); [ -n "$_pp_calls" ] || _pp_calls=0
  if [ "$_pp_calls" = 1 ]; then
    echo "PASS: PP8 the presence predicate is consulted ONCE for two ref-lines at the same sha"
  else
    echo "FAIL: PP8 the presence predicate ran $_pp_calls time(s) for two ref-lines at one sha (want 1)"; fail=1
  fi
  _pp_relays=$(printf '%s\n' "$pp_out" | grep -c 'stub verdict' || true)
  decl_expect_rc "$pp_rc" refuse "PP8: a 2-branch push under enforce still refuses"
  if [ "$_pp_relays" = 1 ]; then
    echo "PASS: PP8 the presence verdict is relayed ONCE for a 2-branch push"
  else
    echo "FAIL: PP8 the presence verdict was relayed $_pp_relays time(s) for a 2-branch push (want 1)"; fail=1
  fi
  _pp_left=$(find "$TP/tmpcount" -mindepth 1 | wc -l | tr -d ' ')
  if [ "$_pp_left" = 0 ]; then
    echo "PASS: PP8 no temp file or directory is left behind after a full run"
  else
    echo "FAIL: PP8 $_pp_left temp entr(ies) left behind under the fixture TMPDIR"; fail=1
  fi

  # PP8b — THE MEMO IS KEYED ON THE SHA, NOT ON "already ran once". Two ref-lines at DIFFERENT shas
  # are two different questions (different boards, possibly different classes), and a memo that
  # answered the second from the first's cache would grade a commit nobody looked at. Without this
  # leg, an unconditional `[ "${_pres_done:-0}" -eq 1 ]` memo passes PP8 and silently under-grades.
  pp_plant_pred "$TP" 1 "$TP/pp-count2"
  rm -f "$TP/pp-count2"
  pp_out=$(cd "$TP" && printf 'refs/heads/feature/x %s refs/heads/feature/x %s\nrefs/heads/feature/y %s refs/heads/feature/y %s\n' \
      "$PHEAD" "$Z" "$PONE" "$Z" \
    | KIT_GUARD_CORE="$DECL_CORE" KIT_PUSH_PRESENCE=enforce sh "$SELF" 2>&1)
  _pp_calls2=$(wc -l < "$TP/pp-count2" 2>/dev/null | tr -d ' '); [ -n "$_pp_calls2" ] || _pp_calls2=0
  if [ "$_pp_calls2" = 2 ]; then
    echo "PASS: PP8b two ref-lines at DIFFERENT shas are graded separately (2 consultations)"
  else
    echo "FAIL: PP8b the presence predicate ran $_pp_calls2 time(s) for two DIFFERENT shas (want 2)"; fail=1
  fi

  # PP9 (A1-9) — THE SINGLE-DERIVATION RULE, BOUND BY A CHECK RATHER THAN BY A COMMENT. D11 forbids
  # this hook deriving a branch key of its own; the GO leg's header says so in prose, and prose is
  # what gets edited away. This grep is the lock.
  # The needles are SPLIT so this lock cannot match itself (measured: the first write reddened on
  # its own grep line — a self-matching self-grep proves nothing and cries wolf forever).
  # The needle SET is the point (S5/R5): git offers several spellings of "what branch am I on?", and
  # a lock naming only one of them teaches the next author which synonym to reach for. All six are
  # listed below, and NONE may be written out in prose anywhere in this file — a comment quoting a
  # needle makes the lock match itself (measured twice: first the grep line, then this comment).
  _pp9_a='symbolic''-ref'; _pp9_b='rev-parse --abbrev''-ref'
  _pp9_c='--show''-current'; _pp9_d='branch --''format'
  _pp9_e='for-each''-ref'; _pp9_f='.git/''HEAD'
  if grep -q -e "$_pp9_a" -e "$_pp9_b" -e "$_pp9_c" -e "$_pp9_d" -e "$_pp9_e" -e "$_pp9_f" "$SELF"; then
    echo "FAIL: PP9 hooks/pre-push derives a branch name itself — D11 forbids a second derivation site"
    fail=1
  else
    echo "PASS: PP9 the hook derives no branch key of its own (single-derivation lock)"
  fi

  # PP-conf — the DURABLE dial: the conf alone refuses, with NO env var carrying a value, and a conf
  # entry for another dial does not answer this one. The REAL core is sourced here (kit_dial_mode
  # lives there), exactly as the DA/DC batteries do.
  pp_plant_pred "$TP" 1
  mkdir -p "$TP/.kit"
  printf 'KIT_PUSH_PRESENCE=enforce\n' > "$TP/.kit/dials.conf"
  pp_conf_out=$(cd "$TP" && printf 'refs/heads/feature/x %s refs/heads/feature/x %s\n' "$PHEAD" "$Z" \
    | KIT_GUARD_CORE="$DIAL_CORE" sh "$SELF" 2>&1); pp_conf_rc=$?
  decl_expect_rc "$pp_conf_rc" refuse "conf KIT_PUSH_PRESENCE=enforce refuses with NO env var set"
  decl_expect_contains "the conf-driven refusal uses the enforce prefix" "kit pre-push:" "$pp_conf_out"
  printf 'KIT_PUSH_GO=enforce\n' > "$TP/.kit/dials.conf"
  pp_conf_out=$(cd "$TP" && printf 'refs/heads/feature/x %s refs/heads/feature/x %s\n' "$PHEAD" "$Z" \
    | KIT_GUARD_CORE="$DIAL_CORE" sh "$SELF" 2>&1); pp_conf_rc=$?
  decl_expect_rc "$pp_conf_rc" allow "a conf entry for ANOTHER dial does not enforce PRESENCE"
  rm -f "$TP/.kit/dials.conf"

  # PP-D1/D2 — dispatch and degradation, inherited verbatim from the three legs above.
  pp_plant_pred "$TP" 1 "$TP/pp-invoked"
  rm -f "$TP/pp-invoked"
  pp_run "$TP" enforce "refs/heads/feature/x $Z refs/heads/feature/x $PHEAD"
  decl_expect_not_invoked "PP: deletion line (zero local_sha)" "$TP/pp-invoked"
  rm -f "$TP/pp-invoked"
  pp_run "$TP" enforce "refs/tags/v1 $PHEAD refs/tags/v1 $Z"
  decl_expect_not_invoked "PP: tag line (remote_ref not refs/heads/*)" "$TP/pp-invoked"
  rm -f "$TP/pp-invoked"
  pp_run "$TP" enforce "refs/heads/main $PHEAD refs/heads/main $Z"
  decl_expect_not_invoked "PP: default-branch line (refs/heads/main)" "$TP/pp-invoked"
  rm -f "$TP/conformance/backlog-presence.sh"
  pp_run "$TP" enforce "refs/heads/feature/x $PHEAD refs/heads/feature/x $Z"
  decl_expect_rc "$pp_rc" allow "PP: an absent presence predicate allows the push"
  [ -z "$pp_out" ] && echo "PASS: PP an absent presence predicate is silent (D2, first-run-green)" \
    || { echo "FAIL: PP an absent presence predicate must be silent, got: $pp_out"; fail=1; }

  [ "$fail" -eq 0 ] && { echo "OK: pre-push selftest"; exit 0; } || { echo "FAIL: pre-push selftest"; exit 1; }
fi

# Normal invocation: git passes "<local-ref> <local-sha> <remote-ref> <remote-sha>" per line on stdin.
status=0
# shellcheck disable=SC2034  # local_ref is required by the git hook protocol (4-field stdin)
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  if reason=$(guard_check_push "$remote_ref" "$local_sha" "$remote_sha"); then
    :
  else
    echo "kit guard: $reason" >&2
    echo "  override (deliberate): git push --no-verify" >&2
    status=1
  fi
  decl_check_ref "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" || status=1
  go_check_ref "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" || status=1
  cite_check_ref "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" || status=1
  presence_check_ref "$local_ref" "$local_sha" "$remote_ref" "$remote_sha" || status=1
done
exit $status
