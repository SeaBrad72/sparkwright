deny  "R1 /./ scripts/dora.sh"       'printf x > scripts/./dora.sh'
deny  "R1 .. free cure"              'sed -i s/x/y/ x/../hooks/pre-push'
# Cure 2 (Route 2, redirect): a non-literal / glob / backslash target behind a read/kit-exec lead DENY.
deny  "R2 kit-exec > cmd-subst"      'sh conformance/verify.sh > $(echo hooks/pre-push)'
deny  "R2 reader > cmd-subst"        'cat conformance/verify.sh > $(echo hooks/pre-push)'
deny  "R2 kit-exec > \$OUT"          'sh conformance/verify.sh > $OUT'
deny  "R2 glob target *"             'printf x > hooks/pre-pus*'
deny  "R2 glob target [p]"           'printf x > hooks/[p]re-push'
deny  "R2 backslash target"          'printf x > hooks\/pre-push'
deny  "R2 reader > \$OUT (over-deny)" 'cat README.md > $OUT'
# Must-stay DENY (incl. the cd-composition refactor-regression pin) + must-stay ALLOW (no over-deny
# beyond the disclosed one: fd-dups, literal tmp targets, ordinary redundant-syntax paths, non-launder
# verbs to a var target all stay ALLOW).
deny  "R1/R2 clean hooks/pre-push"   'sed -i s/x/y/ hooks/pre-push'
deny  "R2 composed cd verify>pre-push" 'cd hooks && sh conformance/verify.sh > pre-push'
allow "R1 ordinary a//b (no CP)"     'printf x > a//b/c.txt'
allow "R2 fd-dup 2>&1"               'sh conformance/verify.sh 2>&1'
allow "R2 fd-dup >&2"                'sh conformance/verify.sh >&2'
allow "R2 reader > tmp literal"      'cat conformance/verify.sh > /tmp/out.txt'
allow "R2 make > \$OUT (not a launder verb)" 'make > $OUT'

# --- B2 Δ4(i): raw writes to the promotion GO ledger (refs/notes/promotions) are DENIED — the
# silent back door the D-240805-3 incident used. Deny the raw `git notes` WRITERS only; the
# ceremonial front door (scripts/promotion-verify.sh record), the ledger's own publish push, all
# reads, and fixture notes refs stay ALLOWED. Speed bump, honestly labeled: it closes the SILENT
# back door, not the front door — a note binds, it does not authenticate.
deny  "raw notes add to the ledger"   'git notes --ref=promotions add -f -F - HEAD'
deny  "raw notes add, spaced ref"     'git notes --ref promotions add -m forged HEAD'
deny  "raw notes add, quoted ref"     'git notes --ref="promotions" add -m forged HEAD'
deny  "raw notes add, full ref name"  'git notes --ref=refs/notes/promotions add -m forged HEAD'
# GUARD-HOOKSPATH-CASE-BYPASS (Fix 1, dual-review round): the ref-name leg folds case. On macOS
# loose refs are ordinary FILES, so `--ref=PROMOTIONS` writes the same real `.git/refs/notes/
# promotions` governance ledger the lowercase form protects — the security seat's proven route.
deny  "raw notes add, UPPERCASE ref"       'git notes --ref=PROMOTIONS add -m forged HEAD'
deny  "raw notes add, full ref UPPERCASE"  'git notes --ref=refs/notes/PROMOTIONS add -m forged HEAD'
# unrelated ref name — case-fold widens case coverage of the SAME token, never adds a NEW token: a
# ref that is not "promotions" under any case stays allowed, confirming the fold did not widen the
# match beyond the promotions token itself.
allow "unrelated ref, case-varied (not promotions)" 'git notes --ref=REVIEW add -m t HEAD'
deny  "raw notes edit"                'git notes --ref=promotions edit HEAD'
deny  "raw notes remove"              'git notes --ref promotions remove HEAD'
deny  "raw notes append"              'git notes --ref=promotions append -m more HEAD'
deny  "raw notes prune"               'git notes --ref=promotions prune'
allow "fixture notes ref write"       'git notes --ref=b2-selftest-x add -m t HEAD'
allow "default-ref notes (commits)"   'git notes add -m annotation HEAD'
allow "front door: record"            'sh scripts/promotion-verify.sh record --gate design --scope PR-1 --approved-sha abc1234 --approved-by Human --rung rc --class control-plane --token t'
allow "ledger read: show"             'git notes --ref=promotions show HEAD'
allow "ledger read: list"             'git notes --ref=promotions list'
allow "ledger publish push"           'git push origin refs/notes/promotions'
# ROUND 2 (sec L-new-1) — the two routes the ceiling's "COMPLETE MEASURED BYPASS SET" was MISSING,
# now entries 7 and 8 there. Pinned as MEASURED-UNCOVERED so the arm and its disclosure cannot drift
# apart in EITHER direction: if a later change makes one of these DENY, that is a coverage extension
# and this line goes RED — re-take it together with the numbered set and the deny message rather than
# deleting the case. (The FORCED spelling `+refs/notes/x:refs/notes/promotions` is denied by the
# unrelated force/mirror-push rule, which is not coverage by this arm.)
allow "push refspec onto the ledger"  'git push origin refs/notes/mine:refs/notes/promotions'
allow "symbolic-ref repoints ledger"  'git symbolic-ref refs/notes/promotions refs/notes/mine'
# RECORD-FETCHES-AND-PUSHES-LEDGER (2026-09-03): `record` is now a transaction — it FETCHES the
# ledger before writing and UNWINDS its own unpublished note with a compare-and-swap `update-ref`
# when the publish is rejected. Both shapes are ALLOW today (the notes deny arm needs the `notes`
# verb; `update-ref` on this ref is disclosed as uncovered plumbing at guard-core.sh:5131), and
# both are pinned here as MEASURED-UNCOVERED for the same reason as the two entries above: under
# `install-shims` every child `git` is graded, so a later coverage extension that made either DENY
# would DEADLOCK the ledger's own front door — silently, at the worst possible moment. This line
# goes RED first instead, and is re-taken together with the arm and its disclosure.
allow "ledger sync-in fetch"          'git fetch --no-tags origin refs/notes/promotions:refs/notes/promotions'
allow "ledger CAS unwind"             'git update-ref refs/notes/promotions abc1234 def5678'
# The third shape the transaction uses: the ledger fetched FORCED into a PID-scoped SCRATCH ref, to
# compare the two chains (divergence count, `log --unpushed`). The `+` is on the DESTINATION side of
# a throwaway ref under refs/kit/, never the ledger — the force rule this could trip matches `push`.
allow "ledger scratch force-fetch"    'git fetch --no-tags -f origin +refs/notes/promotions:refs/kit/notes-remote-1234'
# THE SENTINEL IS RUNTIME-SCOPED (round 2, sec L-new-1): the flat claim "an agent can prefix the same
# variable to a raw command" was over-stated. Under the hook / `kit-guard cmd` runtime the prefix
# arrives inside the command TEXT and this arm's own environment does not carry it, so the raw write
# is STILL DENIED. The ALLOW half — the prefix reaching the guard's ENVIRONMENT, which is what
# `install-shims` produces — is asserted just below.
deny  "sentinel prefix in cmd TEXT"   'KIT_PROMOTION_FRONT_DOOR=1 git notes --ref=promotions add -m forged HEAD'
# The FRONT-DOOR SENTINEL [B2 sec H1]: promotion-verify.sh exports KIT_PROMOTION_FRONT_DOOR=1 around
# its ONE note write, because under `kit-guard install-shims` the arm otherwise blocks the exact door
# its deny message points at (measured deadlock; conformance/shim-coverage.sh case 4 proves it end to
# end). Honest: the sentinel is AGENT-FORGEABLE and the arm's ceiling says so — Δ4(i)′ ships a DRIFT
# CONTROL (owner ruling D3′), not a boundary.
if KIT_PROMOTION_FRONT_DOOR=1 sh "$0" cmd 'git notes --ref=promotions add -f -F - HEAD' >/dev/null 2>&1; then
  echo "PASS allow: front-door sentinel (KIT_PROMOTION_FRONT_DOOR=1) permits promotion-verify's own write"
else
  echo "FAIL (wanted allow): front-door sentinel must permit promotion-verify's own note write"; fail=1
fi
# THE DENY MESSAGE MUST BE TRUE, and must not signpost its own off-switch (L2). Three properties:
# (a) it does NOT claim to cover DESTRUCTION — `update-ref -d` and `push origin :refs/notes/promotions`
#     are in the measured bypass set, and the first draft said "forges or destroys";
# (b) it names NO KIT_GUARD_SELFEDIT escape, unlike every other rule — this is the one rule whose
#     purpose is to stop record-minting, so closing with its own bypass would defeat it;
# (c) [round 2, sec L-new-1] it names the two routes the "COMPLETE SET" was missing — a PUSH refspec
#     whose destination is the ref, and `symbolic-ref` repointing it. A disclosure that enumerates
#     an incomplete set reads as coverage of everything it omits, which is the defect being fixed.
_notes_msg=$(sh "$0" cmd 'git notes --ref=promotions add -m forged HEAD' 2>&1 >/dev/null || true)
case "$_notes_msg" in
  *"forges or destroys"*)
    echo "FAIL: the notes deny message claims to stop DESTRUCTION, which it does not"; fail=1 ;;
  *KIT_GUARD_SELFEDIT*)
    echo "FAIL: the notes deny message signposts KIT_GUARD_SELFEDIT (L2) — the one rule that must not"; fail=1 ;;
  *"NOT covered"*"update-ref"*"PUSH refspecs"*"symbolic-ref"*)
    echo "PASS deny: the notes deny message states what it does NOT cover (incl. push refspecs onto the ref and symbolic-ref) and names no off-switch" ;;
  *)
    echo "FAIL: the notes deny message does not disclose the uncovered routes, got: $_notes_msg"; fail=1 ;;
esac

# --- GUARD-HOOKSPATH-CASE-BYPASS: config-key / secret-name matchers fold case (D-240813-1) ---
# §1: hooksPath — unconditional fold, no fork (git config keys are case-insensitive BY SPEC).
deny  "hooksPath control (camelCase)"        'git config core.hooksPath /tmp/n'
deny  "hooksPath lowercase"                  'git config core.hookspath /tmp/n'
deny  "hooksPath lowercase --global"         'git config --global core.hookspath /tmp/n'
deny  "hooksPath PascalCase"                 'git config core.HooksPath /tmp/n'
deny  "hooksPath uppercase"                  'git config core.HOOKSPATH /tmp/n'
allow "core.bare control (unrelated key)"    'git config core.bare false'

# §2/§7 condition 2: the secret-read arm — BOTH the verb leg (:1408, seat HIGH) and the filename leg
# (:1409) fold. `.env.example` stays ALLOW: the exclusion is by non-membership in the suffix
# alternation ("example" is never a listed suffix), so folding case cannot add it (design §4a).
deny  "secret read: CAT + .env (upper verb)"       'CAT .env'
deny  "secret read: cat + .ENV (upper file)"       'cat .ENV'
deny  "secret read: CAT + .ENV (both upper)"       'CAT .ENV'
deny  "secret read: cat + .env (regression, lower)" 'cat .env'
allow "secret read: cat .env.example (template)"    'cat .env.example'
allow "secret read: cat .ENV.EXAMPLE (uppercase template, shell arm)" 'cat .ENV.EXAMPLE'

# guard_check_read / guard_check_path (path-side .env/.pem/.key/... deny) — the `_under_temp`
# folded-second-arm add-only shape: arm 1 byte-identical and first; arm 2 folds and can only ADD.
rdeny  "Read: secret .ENV upper suffix"        "/repo/.ENV"
rdeny  "Read: secret .PEM upper suffix"        "/repo/key.PEM"
rdeny  "Read: secret .env lower (regression)"  "/repo/.env"
rallow "Read: .env.example (template, allow stays byte-literal)" "/repo/.env.example"
pdeny  "Write: secret .ENV upper suffix"       "/repo/.ENV"
pdeny  "Write: secret .PEM upper suffix"       "/repo/key.PEM"
pdeny  "Write: secret .env lower (regression)" "/repo/.env"
pallow "Write: .env.example (template, allow stays byte-literal)" "/repo/.env.example"
# `.ENV.EXAMPLE` disposition, asserted explicitly (design §4/§4a): the ALLOW list stays byte-literal
# (never folded), so an uppercase template name is NOT recognized as a template and falls through to
# the folded DENY glob — an accepted, stated over-deny, not a silent gap.
pdeny  "Write: .ENV.EXAMPLE uppercase template falls to folded deny (accepted over-deny)" "/repo/.ENV.EXAMPLE"
rdeny  "Read: .ENV.EXAMPLE uppercase template falls to folded deny (accepted over-deny)"  "/repo/.ENV.EXAMPLE"

# Symlink cloak, RESOLVED-side fold: an innocuous literal name that is a symlink to a real secret
# whose OWN name carries an uppercase suffix. Pre-fold this bypassed via the resolved-side check
# (byte-literal `*.env`/`*.pem` never matched the uppercase resolved target); folding the resolved
# arm closes it. Portable: pure string-matching post-resolution, independent of host FS case-folding.
GHCB_TMP=$(mktemp -d)
: > "$GHCB_TMP/SECRET.ENV"
ln -s "$GHCB_TMP/SECRET.ENV" "$GHCB_TMP/innocuous.txt"
rdeny "Read: symlink cloak -> real SECRET.ENV (folded resolved-side)" "$GHCB_TMP/innocuous.txt"
pdeny "Write: symlink cloak -> real SECRET.ENV (folded resolved-side)" "$GHCB_TMP/innocuous.txt"
rm -rf "$GHCB_TMP"

# The MIRROR isolation: a literal uppercase secret NAME symlinked to a target that carries no secret
# suffix at all. For a non-symlinked real path the literal and resolved strings are byte-identical
# (case preserved through `_resolve_physical`), so a fixture built on a plain non-existent path
# cannot tell the literal-side fold apart from the resolved-side fold — both arms agree on the same
# string. This fixture forces them apart: only the LITERAL-side fold can deny here (the resolved
# target has no secret-suffix at all), which is what makes it a real mutation-kill for that arm.
GHCB_TMP2=$(mktemp -d)
: > "$GHCB_TMP2/safe.txt"
ln -s "$GHCB_TMP2/safe.txt" "$GHCB_TMP2/SECRET.ENV"
rdeny "Read: literal SECRET.ENV (upper) -> non-secret target (isolates literal-side fold)"  "$GHCB_TMP2/SECRET.ENV"
pdeny "Write: literal SECRET.ENV (upper) -> non-secret target (isolates literal-side fold)" "$GHCB_TMP2/SECRET.ENV"
rm -rf "$GHCB_TMP2"

# --- GUARD-CP-HARDLINK-ALIAS: the CLI-surface subset of the hardlink deny/allow fixtures. HARDLINKS
# (not symlinks): a benign name sharing an inode with a control-plane or secret file. The tree carries
# a `.claude` marker so the secret half's nearest-boundary (capped below $HOME) derivation resolves; the CP half passes the
# root as $3 (relax OFF — the root is itself under temp, so condition 3 disables the affordance). ---
HLA_TMP=$(mktemp -d)
mkdir -p "$HLA_TMP/.claude/hooks" "$HLA_TMP/sec" "$HLA_TMP/tpl" "$HLA_TMP/tplok" "$HLA_TMP/ord"
printf 'cp\n'  > "$HLA_TMP/.claude/hooks/guard-core.sh"
ln "$HLA_TMP/.claude/hooks/guard-core.sh" "$HLA_TMP/benign.sh"        # CP hardlink
printf 'S=1\n' > "$HLA_TMP/sec/.env"
ln "$HLA_TMP/sec/.env" "$HLA_TMP/sec/notes.txt"                        # secret hardlink
printf 'S=1\n' > "$HLA_TMP/tpl/.env"
ln "$HLA_TMP/tpl/.env" "$HLA_TMP/tpl/.env.example"                     # the CLOAK
printf 'T=1\n' > "$HLA_TMP/tplok/.env.example"
ln "$HLA_TMP/tplok/.env.example" "$HLA_TMP/tplok/keep.txt"             # template + benign sibling
printf 'x\n'   > "$HLA_TMP/ord/a.txt"
ln "$HLA_TMP/ord/a.txt" "$HLA_TMP/ord/b.txt"                           # ordinary nlink>1
prdeny "Write: benign hardlink -> control-plane (names the CP file)" "$HLA_TMP/benign.sh" "$HLA_TMP"
pdeny  "Write: benign.txt hardlink -> real .env (secret, ungated)"   "$HLA_TMP/sec/notes.txt"
rdeny  "Read: benign.txt hardlink -> real .env (silent-exfil)"        "$HLA_TMP/sec/notes.txt"
pdeny  "Write: .env.example hardlink -> real .env (cloak, before allowlist)" "$HLA_TMP/tpl/.env.example"
rdeny  "Read: .env.example hardlink -> real .env (cloak, before allowlist)"  "$HLA_TMP/tpl/.env.example"
rallow "Read: control-plane hardlink stays legitimate"               "$HLA_TMP/benign.sh"
pallow "Write: hardlinked .env.example + benign sibling (template NOT over-denied)" "$HLA_TMP/tplok/.env.example"
pallow "Write: ordinary nlink>1, all-ordinary siblings (no over-deny)" "$HLA_TMP/ord/a.txt"
rm -rf "$HLA_TMP"

# §2 seat MEDIUM, characterized: `_cp8b_pathhit` (:864) is the one remaining byte-literal STRING-scan
# matcher. Folded in TWO TIERS, mirroring `is_control_plane_path`'s own established split (same file,
# same rationale): Tier 1 (kit-owned, unambiguous names) folds UNCONDITIONALLY; Tier 2 (generic
# directory prefixes skills/conformance/adapters, which collide with real adopter code on a
# case-sensitive FS — measured, is_control_plane_path's own comment) folds ONLY when this filesystem
# is case-insensitive. `.claude`/CODEOWNERS/`.git`/hooks-pre-push/etc are Tier 1; skills/conformance/
# adapters are Tier 2. Uses an unrecognized-verb interpreter to hide the substring from the (already
# case-folded) token-level checks, per the file's own P0 precedent comment at :860-862.
deny "pathhit Tier1 fold: interpreter hides HOOKS/PRE-PUSH case-variant" 'python3 -c "open(\"HOOKS/PRE-PUSH\",\"w\")"'
deny "pathhit Tier1 fold: interpreter hides .CLAUDE case-variant"       'python3 -c "open(\".CLAUDE/hooks/x\",\"w\")"'
if _fs_case_insensitive; then
  deny "pathhit Tier2 fold (case-insensitive FS): SKILLS/ case-variant" 'python3 -c "open(\"SKILLS/x.md\",\"w\")"'
else
  echo "SKIP (case-sensitive FS): pathhit Tier2 fold not exercised here — the fold is deliberately OFF"
fi

# --- GUARD-PATH-ENUMERATION-INCOMPLETE S1: membership by DERIVATION, through the CLI surface ---
# The CLI subset of the battery in conformance/agent-autonomy.sh. Eleven tracked governing paths
# measured guard-ALLOW at 9d29406e (AGENTS.md, .gitattributes, 9 scripts) because `scripts/` and the
# `.claude/` sub-paths were enumerated PER FILE. `scripts/*`, `profiles/*` and `.claude/*` are families
# now; AGENTS.md, REQUIRED-CHECKS.md and `.gitattributes` (every depth) join the curated root set.
# ⚠️ The `zz-*` names are in NO list and their directories do not exist — they are the derivation
# proof, and a change that makes them pass by NAMING them has defeated this row, not met it.
pdeny  "S1 publish-public.sh"        "scripts/publish-public.sh"
pdeny  "S1 branch-protection-apply"  "scripts/branch-protection-apply.sh"
pdeny  "S1 NEVER-listed new script"  "scripts/zz-fixture-new.sh"
pdeny  "S1 nested scripts segment"   "frontend/scripts/build.js"
pdeny  "S1 profiles adopter-gates"   "profiles/adopter-gates.yml"
pdeny  "S1 NEVER-listed new profile" "profiles/zz-new/ci.yml"
pdeny  "S1 .claude/commands (dir absent)" ".claude/commands/x.md"
pdeny  "S1 .claude/plugins (dir absent)"  ".claude/plugins/y.json"
pdeny  "S1 NEVER-listed .claude dir"      ".claude/newdir/x.md"
pdeny  "S1 AGENTS.md"                "AGENTS.md"
pdeny  "S1 REQUIRED-CHECKS.md"       "REQUIRED-CHECKS.md"
pdeny  "S1 .gitattributes (root)"    ".gitattributes"
pdeny  "S1 .gitattributes (nested)"  "docs/.gitattributes"
deny   "S1 redirect over a new script"   'echo x > scripts/zz-fixture-new.sh'
deny   "S1 sed -i a new profile"         'sed -i s/a/b/ profiles/zz-new/ci.yml'
deny   "S1 redirect over AGENTS.md"      'echo x > AGENTS.md'
deny   "S1 sed -i REQUIRED-CHECKS.md"    'sed -i s/a/b/ REQUIRED-CHECKS.md'
deny   "S1 redirect over .gitattributes" 'echo x > .gitattributes'
# THE BARE DIRECTORY — the fourth matcher (_ctm_match), the one the first cut of this slice missed.
# `is_control_plane_path`'s patterns are `profiles/*`, which a bare `profiles` never matches, so
# `mv profiles /tmp/x` ALLOWED while every file inside the family denied: the single command that
# relocates the whole directory was the one route left open. Sibling regression control included.
deny   "S1 relocate the profiles dir"    'mv profiles /tmp/x'
deny   "S1 chmod -R the profiles dir"    'chmod -R 777 profiles'
allow  "S1 relocate myprofiles (segment-anchored)" 'mv myprofiles /tmp/x'
deny   "S1 ctm control: skills dir unchanged"      'mv skills /tmp/x'
deny   "S1 ctm control: scripts dir unchanged"     'mv scripts /tmp/x'
# `.gitattributes` anchoring, both routes. The look-alike legs use an UNRECOGNIZED lead verb on
# purpose: a `printf x > foo.gitattributes` form is read-recognized and returns before pathhit runs,
# so it passes with the leg left unanchored and proves nothing about the anchor.
deny   "S1 gitattr corner: post-space"   'zzunknownverb .gitattributes'
deny   "S1 gitattr corner: nested"       'zzunknownverb docs/.gitattributes'
pallow "S1 gitattr look-alike path"      "foo.gitattributes"
pallow "S1 gitattr look-alike nested"    "docs/my.gitattributes"
allow  "S1 gitattr look-alike cmd"       'zzunknownverb foo.gitattributes'
allow  "S1 gitattr look-alike cmd nested" 'zzunknownverb docs/my.gitattributes'
# The re-anchored pathhit `.claude` leg: corner spellings must STILL deny. An UNRECOGNIZED lead verb is
# used on purpose — a read/printf lead with an ordinary redirect target is recognized as a read and
# returns before pathhit ever runs, so a reader-led fixture cannot test this leg at all.
deny   "S1 corner: interpreter form"  'python3 -c "open('"'"'.claude/settings.json'"'"','"'"'w'"'"')"'
deny   "S1 corner: double-quoted"     'zzunknownverb ".claude/settings.json"'
deny   "S1 corner: post-space"        'zzunknownverb .claude/settings.json'
deny   "S1 corner: post-equals"       'zzunknownverb --out=.claude/settings.json'
# SIBLING-FP RELIEF on BOTH routes (a path-only relief would green the criterion vacuously).
pallow "S1 sibling foo.claude"        "foo.claude/settings.json"
pallow "S1 sibling v2.claude"         "v2.claude/x"
allow  "S1 sibling pathhit v2.claude" 'zzunknownverb v2.claude/x'
allow  "S1 sibling pathhit foo dir"   'zzunknownverb foo.claude/settings.json'
# Load-bearing negatives: reads and kit-exec of a family member stay ALLOW (no new over-block).
pallow "S1 ordinary README"           "README.md"
pallow "S1 ordinary docs path"        "docs/x.md"
allow  "S1 read a family member"      'cat scripts/publish-public.sh'
allow  "S1 run a family member"       'sh scripts/publish-public.sh --dry-run'

# --- GUARD-CLAUDE-HOME-INSTRUMENTATION-FP: the agent's own workspace subtrees, through the CLI ---
# The CLI subset of the battery in conformance/agent-autonomy.sh (design
# docs/architecture/2026-08-17-guard-claude-home-fp-design.md). S1 made `*/.claude/*` a family, which
# also captured the HARNESS'S OWN HOME: `~/.claude/projects/<p>/memory/*.md` (agent memory) and
# `~/.claude/plans/*.md` (plan mode) measured DENY on the Edit and Write routes 2026-08-17, breaking
# the memory directive and plan mode in every session. The cure is a two-name relief arm placed
# FIRST in BOTH classifier tiers. ⚠️ Classifier-ONLY by owner ruling (C1 = option (b)): the pathhit
# regex legs are byte-untouched, so a non-read-verb shell spelling at a RELIEVED name still denies —
# a disclosed retained FP, pinned below. `/home/kituser` is synthetic and never under a temp root, so
# the dev-clone affordance cannot green a leg for the wrong reason.
pallow "HOME-FP memory file"          "/home/kituser/.claude/projects/p1/memory/x.md"
pallow "HOME-FP plans file"           "/home/kituser/.claude/plans/x.md"
pallow "HOME-FP nested memory dir"    "/home/kituser/.claude/projects/-Users-x-dev/memory/MEMORY.md"
pallow "HOME-FP case variant (fold)"  "/home/kituser/.CLAUDE/PLANS/x.md"
pallow "HOME-FP repo-relative plans"  ".claude/plans/x.md"
pallow "HOME-FP L1 nested-family shadow (recorded decision, design §4)" ".claude/projects/x/hooks/pre-push"
allow  "HOME-FP read-verb redirect"   'printf x > /home/kituser/.claude/plans/x.md'
# THE BRIGHT LINE, RETAINED — settings/hooks/agents/commands are permission + instrumentation
# surfaces and stay denied at home and in-repo, one leg per mutation form.
pdeny  "HOME-FP DENY home settings"   "/home/kituser/.claude/settings.json"
pdeny  "HOME-FP DENY home hooks"      "/home/kituser/.claude/hooks/x"
pdeny  "HOME-FP DENY home agents"     "/home/kituser/.claude/agents/y.md"
pdeny  "HOME-FP DENY home mcp-policy" "/home/kituser/.claude/mcp-policy.json"
pdeny  "HOME-FP DENY repo commands"   ".claude/commands/x.md"
deny   "HOME-FP DENY settings redir"  'echo x > /home/kituser/.claude/settings.json'
deny   "HOME-FP DENY settings sed -i" 'sed -i s/a/b/ /home/kituser/.claude/settings.json'
# vet-C2: the case-variant leg only KILLS a `_cpp_kitowned`-only relief-widening mutant on a
# case-SENSITIVE filesystem (CI). On macOS the conditional Tier-2 re-check still denies, so the
# mutant survives here — stated so the green is not over-read. The platform-independent lock is the
# both-tiers relief leg in conformance/promotion-readiness-wired.sh.
pdeny  "HOME-FP DENY home .Claude case" "/home/kituser/.Claude/settings.json"
# The retained FP, recorded: an interpreter spelling at a RELIEVED name is still denied under (b).
deny   "HOME-FP retained-FP interp plans" 'python3 -c "open('"'"'.claude/plans/x.md'"'"','"'"'w'"'"')"'
# `~` is never admitted to an allowlist (the shell decides what it means, not the guard), and a
# traversal through a relieved name still lands on the family target via the normalized form.
deny   "HOME-FP DENY tilde plans"     'echo x >> ~/.claude/plans/x.md'
deny   "HOME-FP DENY bare-dir move"   'mv ~/.claude/projects /tmp'
pdeny  "HOME-FP DENY traversal"       "/home/kituser/.claude/plans/../hooks/x"

# --- K-LOG-*: GUARD-DENY-LOG, the closure instrument (D-240828-4 PR 4a) --------------------------
# These live HERE rather than in conformance/agent-autonomy.sh deliberately: that file is inside the
# conformance mass budget and this file is not, and the budget's whole point is to make the cheap
# path cheap. Nothing is lost — the log is a property of the CLI surface, which is what this selftest
# owns, and agent-autonomy's --delta leg is about VERDICTS, which this slice does not move at all.
# Every cell runs in its own throwaway git repo so the developer's real .kit-run is never touched.
KLOG_TMP=$(mktemp -d /tmp/kit-guard-log.XXXXXX) || { echo "FAIL: mktemp"; exit 1; }
klog_cleanup() { chmod -R u+w "$KLOG_TMP" 2>/dev/null || :; rm -rf "$KLOG_TMP" 2>/dev/null || :; }
trap klog_cleanup EXIT INT TERM
klog_ok()   { echo "PASS log:   $1"; }
klog_bad()  { echo "FAIL (log): $1"; fail=1; }
klog_check(){ if [ "$2" = "$3" ]; then klog_ok "$1"; else klog_bad "$1 (wanted [$3], got [$2])"; fi; }
# A throwaway repo: `git rev-parse --show-toplevel` from inside it is the log's root, so the cells
# exercise the SAME root-resolution the live surface uses (PROTECTED_ROOT is empty off the hook).
KLOG_REPO="$KLOG_TMP/repo"
mkdir -p "$KLOG_REPO" && ( cd "$KLOG_REPO" && git init -q . 2>/dev/null ) || { echo "FAIL: git init"; exit 1; }
KLOG_FILE="$KLOG_REPO/.kit-run/guard-denials.ndjson"
# `|| :` INSIDE the function: a deny exits 1 and this file runs under `set -e`, so a bare call would
# abort the selftest at the first cell (measured — it did). The cells that care about the verdict
# assert it explicitly with `klog_verdict`.
klog_run() { ( cd "$KLOG_REPO" && KIT_GUARD_LOG="${KLOG_LOG:-1}" KIT_SESSION_ID="${KLOG_SESS:-s-test}" sh "$KG_SELF" cmd "$1" ) >/dev/null 2>&1 || :; }
klog_verdict() { ( cd "$KLOG_REPO" && KIT_GUARD_LOG="${KLOG_LOG:-1}" KIT_SESSION_ID="${KLOG_SESS:-s-test}" sh "$KG_SELF" cmd "$1" ) >/dev/null 2>&1; }
# klog_stderr: the same invocation, but stderr CAPTURED (stdout dropped) — for the "no shell
# diagnostic leaks out of the logger" cell. The guard's own reason goes to stderr too, so the cell
# that uses this filters for the shell's `cannot create`/`Permission denied` shapes specifically.
# shellcheck disable=SC2069  # ORDER IS DELIBERATE: `2>&1 >/dev/null` duplicates stderr onto the
# original stdout (the capture) and THEN sends stdout to /dev/null — i.e. capture stderr ONLY, which
# is exactly what this cell asserts on. The order SC2069 recommends would capture stdout instead.
klog_stderr() { ( cd "$KLOG_REPO" && KIT_GUARD_LOG=1 KIT_SESSION_ID=s-test sh "$KG_SELF" cmd "$1" ) 2>&1 >/dev/null || :; }
# klog_timeout <secs> <cmd...> — a portable timeout. ⚠️ `timeout(1)` IS NOT ON macOS (measured:
# "command not found"), and the FIFO cell below is worthless without one: before the C1 fix that
# invocation blocks FOREVER, so an unwrapped cell would hang the whole selftest instead of failing
# it. Poll-and-kill in POSIX sh; returns 124 on expiry, like timeout(1).
klog_timeout() {
  _kt_s=$1; shift
  ( "$@" ) >/dev/null 2>&1 & _kt_p=$!
  _kt_n=0
  while kill -0 "$_kt_p" 2>/dev/null; do
    _kt_n=$((_kt_n + 1))
    if [ "$_kt_n" -gt "$_kt_s" ]; then kill -9 "$_kt_p" 2>/dev/null || :; wait "$_kt_p" 2>/dev/null || :; return 124; fi
    sleep 1
  done
  _kt_r=0
  wait "$_kt_p" 2>/dev/null || _kt_r=$?
  return "$_kt_r"   # the COMMAND's status, so a cell can still assert deny-vs-allow
}
KG_SELF="$SELF_DIR/$(basename -- "$0")"

# 1. A DENY writes EXACTLY ONE well-formed line, with the fields the reason string carries.
klog_run 'sed -i s/a/b/ .claude/hooks/guard-core.sh'
klog_check "deny writes exactly one line" "$( (wc -l < "$KLOG_FILE" 2>/dev/null || echo 0) | tr -d ' ')" "1"
klog_check "arm is the reason's numeric tag" "$(sed -n 's/.*"arm":"\([^"]*\)".*/\1/p' "$KLOG_FILE" 2>/dev/null)" "13"
klog_check "surface is kit-guard"            "$(sed -n 's/.*"surface":"\([^"]*\)".*/\1/p' "$KLOG_FILE" 2>/dev/null)" "kit-guard"
klog_check "session is KIT_SESSION_ID"       "$(sed -n 's/.*"session":"\([^"]*\)".*/\1/p' "$KLOG_FILE" 2>/dev/null)" "s-test"
klog_check "ts is UTC ISO-8601"              "$(sed -n 's/.*"ts":"\([0-9-]*T[0-9:]*Z\)".*/ok/p' "$KLOG_FILE" 2>/dev/null)" "ok"
# THE PRIVACY PROPERTY, load-bearing: the full command is NEVER in the file. `s/a/b/` is in the
# offending segment legitimately; the canary below is a token-shaped argument that must not appear.
klog_run 'echo KLOGCANARYTOKEN; sed -i s/a/b/ .claude/hooks/guard-core.sh'
if grep -q 'KLOGCANARYTOKEN' "$KLOG_FILE" 2>/dev/null; then klog_bad "no full command in the log"; else klog_ok "no full command in the log"; fi
# 2. read_shaped — DERIVED FROM THE REASON, not recomputed (reviewer H1/H2, round 1). All three of
# these were WRONG in the first cut, and the middle one is the one that mattered: the bit was
# computed on the `]`-TRUNCATED segment, so a WRITE whose segment merely contained a `]` was logged
# as a refused read and would have inflated the very metric 4b is measured against.
klog_rs() { sed -n 's/.*"read_shaped":\([01]\).*/\1/p' "$KLOG_FILE" 2>/dev/null; }
: > "$KLOG_FILE"
# R10 of the escape card: an interpreter `-c` carrying a pure read is KEPT-DENIED (the arguments of
# an interpreter are code), and it is exactly the shape the closure metric must count as "a READ was
# refused". A `sed -n <n>,<m>p <cp>` would NOT do here — lane 2 already relieved it, so it ALLOWs.
klog_run "sh -c 'grep x conformance/verify.sh'"
klog_check "R10 refused READ is read_shaped=1" "$(klog_rs)" "1"
: > "$KLOG_FILE"
klog_run 'rm -rf .claude/hooks/guard-core.sh'
klog_check "a refused WRITE is read_shaped=0" "$(klog_rs)" "0"
# THE REGRESSION THE REVIEW FOUND: a `]` inside the segment used to truncate it before the predicate
# ran, and the stub `cat 'x` looked read-shaped. It is a REDIRECT TO A CONTROL-PLANE PATH — a write.
: > "$KLOG_FILE"
klog_run "cat 'x]y' > conformance/verify.sh"
klog_check "write whose segment contains ] is read_shaped=0" "$(klog_rs)" "0"
# The other direction: a loop head the message tier DID judge read-shaped used to log 0, because the
# recomputation never got the raw command the tier keys that face on.
: > "$KLOG_FILE"
klog_run 'for p in conformance/*.sh; do wc -l "$p"; done'
klog_check "loop-head read the tier judged read is read_shaped=1" "$(klog_rs)" "1"
# 3. An ALLOW writes NOTHING. (If this ever fails the log stops being a deny log.)
rm -f "$KLOG_FILE"
klog_run 'npm test'
if [ -s "$KLOG_FILE" ]; then klog_bad "an ALLOW writes no line"; else klog_ok "an ALLOW writes no line"; fi
# 4. THE FAIL-SAFE, both spellings: logging can never change a verdict. An unwritable .kit-run and
# KIT_GUARD_LOG=0 must each leave the deny/allow EXIT CODE byte-identical and write nothing.
# ⚠️ L4 (review round 1): root IGNORES mode 000, so the chmod cell would silently assert nothing in
# a container that runs as uid 0. Skip it loudly rather than print a green that means nothing.
if [ "$(id -u 2>/dev/null || echo 1)" = "0" ]; then
  echo "SKIP log:   unwritable .kit-run cells — running as uid 0, which ignores mode 000 (cell would be vacuous)"
else
  rm -rf "$KLOG_REPO/.kit-run"; mkdir -p "$KLOG_REPO/.kit-run"; chmod 000 "$KLOG_REPO/.kit-run" 2>/dev/null || :
  if klog_verdict 'rm -rf /tmp/x'; then klog_bad "unwritable .kit-run: verdict unchanged (deny)"; else klog_ok "unwritable .kit-run: verdict unchanged (deny)"; fi
  if klog_verdict 'npm test'; then klog_ok "unwritable .kit-run: verdict unchanged (allow)"; else klog_bad "unwritable .kit-run: verdict unchanged (allow)"; fi
  # reviewer M1: `2>/dev/null` on a simple command does NOT suppress the shell's own failed-redirect
  # diagnostic. The guard's REASON legitimately goes to stderr; a shell "cannot create"/"Permission
  # denied" from the logger must not.
  KLOG_ERR=$(klog_stderr 'rm -rf /tmp/x')
  if printf '%s' "$KLOG_ERR" | grep -Eq 'cannot create|Permission denied|No such file or directory'; then
    klog_bad "unwritable .kit-run leaks no shell diagnostic to stderr"
  else
    klog_ok "unwritable .kit-run leaks no shell diagnostic to stderr"
  fi
  chmod 755 "$KLOG_REPO/.kit-run" 2>/dev/null || :
fi
rm -f "$KLOG_FILE"
# ⚠️ M4 (review round 1): a `VAR=x func` prefix PERSISTS in POSIX sh when the command is a FUNCTION
# (unlike an external command), so a bare `KLOG_LOG=0 klog_verdict …` silently disabled logging for
# every cell that followed — measured, and it presented three cells later as an "escaping bug". A
# SUBSHELL per cell scopes it properly; the manual reset it replaces was a workaround, not a fix.
if ( KLOG_LOG=0; klog_verdict 'rm -rf /tmp/x' ); then klog_bad "KIT_GUARD_LOG=0: verdict unchanged (deny)"; else klog_ok "KIT_GUARD_LOG=0: verdict unchanged (deny)"; fi
if [ -s "$KLOG_FILE" ]; then klog_bad "KIT_GUARD_LOG=0 writes nothing"; else klog_ok "KIT_GUARD_LOG=0 writes nothing"; fi

# 4b. THE PLANTED-NODE FAMILY (security C1/C2, round 1). Each of these was a LIVE finding.
# K-LOG-FIFO — `mkfifo` at the log path made the next deny block forever in the `>>`, so the
# PreToolUse hook HUNG instead of denying: a DoS on the agent's own tool loop from one allowed
# command. The timeout wrapper is the assertion: without the fix this cell never returns.
rm -rf "$KLOG_REPO/.kit-run"; mkdir -p "$KLOG_REPO/.kit-run"
if command -v mkfifo >/dev/null 2>&1 && mkfifo "$KLOG_FILE" 2>/dev/null; then
  if klog_timeout 10 klog_verdict 'rm -rf /tmp/x'; then
    klog_bad "K-LOG-FIFO: a FIFO at the log path must not hang the verdict (it returned ALLOW)"
  else
    # 1 = denied and returned promptly (correct); 124 = the wrapper had to kill it (the bug).
    if [ $? = 124 ]; then klog_bad "K-LOG-FIFO: HUNG on a planted FIFO (timed out)"; else klog_ok "K-LOG-FIFO: a planted FIFO neither hangs nor changes the verdict"; fi
  fi
  rm -f "$KLOG_FILE"
else
  echo "SKIP log:   K-LOG-FIFO — mkfifo unavailable on this platform"
fi
# K-LOG-SYMLINK-FILE — a symlink at the log path turned the logger into an APPEND PRIMITIVE onto
# whatever it pointed at. The victim here is a NON-control-plane file (the point is the primitive,
# not the target's class): it must be byte-identical after a deny.
rm -f "$KLOG_FILE"
KLOG_VICTIM="$KLOG_TMP/victim.txt"
printf 'victim-contents-must-not-change\n' > "$KLOG_VICTIM"
KLOG_VICTIM_BEFORE=$(cksum < "$KLOG_VICTIM")
if ln -s "$KLOG_VICTIM" "$KLOG_FILE" 2>/dev/null; then
  klog_run 'rm -rf /tmp/x'
  klog_check "K-LOG-SYMLINK-FILE: symlinked log leaves its target byte-identical" "$(cksum < "$KLOG_VICTIM")" "$KLOG_VICTIM_BEFORE"
  rm -f "$KLOG_FILE"
else
  echo "SKIP log:   K-LOG-SYMLINK-FILE — cannot create a symlink here"
fi
# K-LOG-HARDLINK (MED-2, round 2) — the primitive that survived BOTH round-1 tests. `ln <victim>
# .kit-run/guard-denials.ndjson` is ALLOWED for a non-CP victim, and the result is a REGULAR,
# NON-SYMLINK file: `-f` passes, `-L` fails, and the append landed in the victim (measured live).
# Only the link count distinguishes it.
rm -f "$KLOG_FILE"
KLOG_HVICTIM="$KLOG_TMP/hardvictim.txt"
printf 'hardlink-victim-must-not-change\n' > "$KLOG_HVICTIM"
KLOG_HBEFORE=$(cksum < "$KLOG_HVICTIM")
if ln "$KLOG_HVICTIM" "$KLOG_FILE" 2>/dev/null; then
  klog_run 'rm -rf /tmp/x'
  klog_check "K-LOG-HARDLINK: hardlinked log leaves its target byte-identical" "$(cksum < "$KLOG_HVICTIM")" "$KLOG_HBEFORE"
  rm -f "$KLOG_FILE"
else
  echo "SKIP log:   K-LOG-HARDLINK — cannot create a hardlink here"
fi
# K-LOG-MODE (HIGH-2, round 2) — a FIRST-CREATE lands 0600, not the 0644 the process umask gives.
if [ "$(id -u 2>/dev/null || echo 1)" = "0" ]; then
  echo "SKIP log:   K-LOG-MODE — uid 0 (mode assertions are not meaningful)"
else
  rm -f "$KLOG_FILE"
  klog_run 'rm -rf /tmp/x'
  klog_check "K-LOG-MODE: a freshly created log is mode 600" \
    "$(stat -c %a "$KLOG_FILE" 2>/dev/null || stat -f %Lp "$KLOG_FILE" 2>/dev/null || echo '?')" "600"
fi
# K-LOG-SYMLINK-DIR — the same primitive one level up: `.kit-run` itself a symlink to a directory.
rm -rf "$KLOG_REPO/.kit-run"
KLOG_DECOY="$KLOG_TMP/decoydir"
mkdir -p "$KLOG_DECOY"
if ln -s "$KLOG_DECOY" "$KLOG_REPO/.kit-run" 2>/dev/null; then
  klog_run 'rm -rf /tmp/x'
  if [ -e "$KLOG_DECOY/guard-denials.ndjson" ]; then klog_bad "K-LOG-SYMLINK-DIR: wrote through a symlinked .kit-run"; else klog_ok "K-LOG-SYMLINK-DIR: a symlinked .kit-run is refused"; fi
  rm -f "$KLOG_REPO/.kit-run"
else
  echo "SKIP log:   K-LOG-SYMLINK-DIR — cannot create a symlink here"
fi
mkdir -p "$KLOG_REPO/.kit-run"

# 4c. REDACTION (security H1, round 1). For a ONE-SEGMENT command the offending segment IS the
# command, so these were all logged verbatim before the fix. One cell per shape: the raw secret must
# be ABSENT and `<redacted>` PRESENT. Best-effort masking, never a guarantee — see the prose.
klog_redact_cell() { # <label> <command> <secret-literal>
  : > "$KLOG_FILE"
  klog_run "$2"
  if grep -q "$3" "$KLOG_FILE" 2>/dev/null; then klog_bad "redaction $1: raw secret is ABSENT from the line"
  elif grep -q '<redacted>' "$KLOG_FILE" 2>/dev/null; then klog_ok "redaction $1: masked (<redacted> present, raw secret absent)"
  else klog_bad "redaction $1: no <redacted> marker in the line"; fi
}
klog_redact_cell "NAME=VALUE prefix"  'GHTOKEN=ghp_klogsecretvalue sed -i s/a/b/ conformance/verify.sh' 'ghp_klogsecretvalue'
klog_redact_cell "Authorization/Bearer" "curl -H 'Authorization: Bearer ghp_klogbearervalue' -o conformance/verify.sh https://x" 'ghp_klogbearervalue'  # gitleaks:allow — a CANARY the redactor must mask, not a credential
klog_redact_cell "url userinfo"       'psql postgres://kituser:klogpwvalue@db.example/x -f conformance/verify.sh' 'klogpwvalue'
klog_redact_cell "password="          'sed -i s/a/b/ conformance/verify.sh --password=klogpwquery' 'klogpwquery'
klog_redact_cell "api_key="           'sed -i s/a/b/ conformance/verify.sh --api_key=klogapivalue' 'klogapivalue'
klog_redact_cell "token="             'sed -i s/a/b/ conformance/verify.sh --token=klogtokenvalue' 'klogtokenvalue'
# MED-3 (round 2): five more measured shapes. The first is the one that mattered — the old rule
# masked only the FIRST assignment, so a secret in the SECOND position of a leading run leaked.
klog_redact_cell "multi-assignment run" 'A=x SECRETTOKEN=klogrunvalue B=y sed -i s/a/b/ conformance/verify.sh' 'klogrunvalue'
klog_redact_cell "curl -u user:pw"      "curl -u kituser:klogcurluser -o conformance/verify.sh https://x" 'klogcurluser'  # gitleaks:allow — canary
klog_redact_cell "-p<value> (mysql)"    'mysql -pklogmysqlpw -e "x" conformance/verify.sh' 'klogmysqlpw'
klog_redact_cell "-p <value> (psql)"    'psql -p klogpsqlpw -f conformance/verify.sh' 'klogpsqlpw'
klog_redact_cell "x-api-key header"     "curl -H 'x-api-key: klogxapikey' -o conformance/verify.sh https://x" 'klogxapikey'  # gitleaks:allow — canary
# ⚠️ The JSON rule is FOUR rules, one per key: BSD sed has no `\|` alternation in BRE, so the single
# combined rule matched NOTHING on macOS while reading as correct. This cell is what catches that.
klog_redact_cell "JSON \"token\" value" 'sed -i "s/{\"token\": \"klogjsontok\"}/x/" conformance/verify.sh' 'klogjsontok'
# NEGATIVE: redaction must not eat ordinary flags. `-n` is not a password argument.
: > "$KLOG_FILE"
klog_run 'sed -i s/a/b/ -n conformance/verify.sh'
if grep -q -- '-n conformance/verify.sh' "$KLOG_FILE" 2>/dev/null; then klog_ok "redaction leaves ordinary flags intact"; else klog_bad "redaction leaves ordinary flags intact"; fi
# 5. ESCAPING/STRIPPING: a segment carrying `"`, `\` and a control byte must leave the line parseable
# (one `{`…`}`, eight fields) with the control byte GONE and both metacharacters escaped.
: > "$KLOG_FILE"
KLOG_CTRL=$(printf 'a\002b')
klog_run "sed -i 's/x\"y\\z${KLOG_CTRL}/q/' .claude/hooks/guard-core.sh"
klog_check "escaped line is still one NDJSON record" "$( (wc -l < "$KLOG_FILE" 2>/dev/null || echo 0) | tr -d ' ')" "1"
klog_check "escaped line still has 8 fields" "$(tr ',' '\n' < "$KLOG_FILE" 2>/dev/null | grep -c ':')" "8"
if LC_ALL=C grep -q '[[:cntrl:]]' "$KLOG_FILE" 2>/dev/null; then klog_bad "control byte stripped from segment"; else klog_ok "control byte stripped from segment"; fi
if grep -q '\\"' "$KLOG_FILE" 2>/dev/null; then klog_ok "double-quote escaped in segment"; else klog_bad "double-quote escaped in segment"; fi
# M1 (security, round 1): the first cut's `tr -d` SPARED \011 \012 \015. A TAB or CR is not legal
# literal JSON inside a string, and a raw NEWLINE SPLIT ONE RECORD INTO TWO — i.e. an
# attacker-influenced segment could FORGE an extra NDJSON line. All three in one segment here.
: > "$KLOG_FILE"
KLOG_WS=$(printf 'a\tb\rc\nd')
klog_run "sed -i 's/${KLOG_WS}/q/' conformance/verify.sh"
klog_check "TAB/CR/LF in a segment still yield ONE record" "$( (wc -l < "$KLOG_FILE" 2>/dev/null || echo 0) | tr -d ' ')" "1"
if LC_ALL=C grep -q '[[:cntrl:]]' "$KLOG_FILE" 2>/dev/null; then klog_bad "TAB/CR/LF stripped from the record"; else klog_ok "TAB/CR/LF stripped from the record"; fi
if command -v jq >/dev/null 2>&1; then
  if jq -e . "$KLOG_FILE" >/dev/null 2>&1; then klog_ok "record parses as JSON (jq -e .)"; else klog_bad "record parses as JSON (jq -e .)"; fi
else
  # jq-absent fallback: the kit's own reader must read it, and the byte check above already ran.
  klog_check "record parses via the awk reader (jq absent)" "$(sh "$KG_SELF" --denials --file "$KLOG_FILE" 2>&1 | sed -n 's/.*(+\([0-9]*\) malformed.*/\1/p')" ""
fi
# M2 (security, round 1): `cut -c1-160` counts CHARACTERS. A multibyte segment produced a 448-byte
# line against a field the docs call "≤160 bytes". LC_ALL=C at the log site makes the claim true.
: > "$KLOG_FILE"
# ⚠️ A THREE-BYTE CHARACTER, and that is load-bearing, not decoration. `é` is TWO bytes and the clamp
# is 160, which divides evenly — so an `é` string ALWAYS cuts on a character boundary and the cell
# passes whether or not the boundary trim exists. Measured against a mutant with the trim deleted:
# the `é` line came out valid UTF-8 anyway. `→` is three bytes, 160/3 is not whole, so the raw cut
# lands MID-CHARACTER and the trim is what makes the line valid.
KLOG_WIDE=$(awk 'BEGIN{s="";for(i=0;i<200;i++)s=s "→";print s}')
# ⚠️ THE `x` PAD IS ALSO LOAD-BEARING. The clamp is 160 bytes and the segment's ASCII prefix
# (`sed -i 's/`) is 10, leaving 150 — divisible by 3, so an unpadded 3-byte-character run STILL cuts
# on a boundary and the cell passes against a mutant with the trim deleted. Measured across pads
# 0..3: only 1 and 2 discriminate. One byte of padding puts the cut mid-character.
klog_run "sed -i 's/x${KLOG_WIDE}/q/' conformance/verify.sh"
KLOG_BYTES=$( (LC_ALL=C wc -c < "$KLOG_FILE" 2>/dev/null || echo 99999) | tr -d ' ')
if [ "$KLOG_BYTES" -le 400 ]; then klog_ok "a 200-char multibyte segment yields a byte-clamped line ($KLOG_BYTES b)"; else klog_bad "multibyte segment overran the byte clamp ($KLOG_BYTES b)"; fi
# MED-1 (round 2): the byte clamp used to cut THROUGH a multibyte character, and macOS awk then
# ABORTED (exit 2, empty stdout) on the whole file — one truncated `é` voided the entire harvest
# while the reader claimed malformed lines were "counted, never dropped". Three assertions: the
# segment field is ≤160 bytes, the line is valid UTF-8, and `--denials` still reports it.
KLOG_SEGB=$( (sed -n 's/.*"segment":"\(.*\)","read_shaped".*/\1/p' "$KLOG_FILE" | LC_ALL=C wc -c 2>/dev/null || echo 99999) | tr -d ' ')
if [ "$KLOG_SEGB" -le 161 ]; then klog_ok "multibyte segment field is byte-clamped to <=160 ($KLOG_SEGB b incl. newline)"; else klog_bad "multibyte segment field overran 160 bytes ($KLOG_SEGB b)"; fi
if command -v iconv >/dev/null 2>&1; then
  if iconv -f UTF-8 -t UTF-8 < "$KLOG_FILE" >/dev/null 2>&1; then klog_ok "truncated multibyte line is valid UTF-8 (iconv)"; else klog_bad "truncated multibyte line is NOT valid UTF-8 (iconv)"; fi
else
  # iconv-absent fallback: no trailing partial sequence — the last byte must not be a continuation
  # byte, and must not be a lead byte left dangling.
  if LC_ALL=C sed -n 's/.*"segment":"\(.*\)","read_shaped".*/\1/p' "$KLOG_FILE" | LC_ALL=C grep -q "[$(printf '\200')-$(printf '\277')]\$"; then
    klog_bad "truncated multibyte line ends on a continuation byte (byte check)"
  else klog_ok "truncated multibyte line ends on a character boundary (byte check)"; fi
fi
klog_check "--denials still reads a multibyte log (macOS awk does not abort)" \
  "$(sh "$KG_SELF" --denials --file "$KLOG_FILE" 2>&1 | sed -n 's/^kit-guard --denials: \([0-9]*\) denial.*/\1/p')" "1"
# 5b. THE PRETOOLUSE SURFACE (reviewer M2, round 1). Everything above drives `kit-guard cmd`; the
# hook is the OTHER wired surface and it is the one C1b is about — the decision must reach stdout
# even when the logger cannot write at all. Drives .claude/hooks/guard.sh with real hook JSON.
# ⚠️ THE HOOK IS COPIED INTO THE FIXTURE REPO, and that is load-bearing rather than tidiness:
# guard.sh derives PROTECTED_ROOT from ITS OWN path (`$0/../..`), so running the dev-clone's copy
# would log into the DEV-CLONE's .kit-run no matter what directory the cell cd's to. Measured: the
# first draft of these cells asserted against the fixture file, found it empty, and the
# "unwritable" leg was passing VACUOUSLY — it had chmod'd a directory the logger never touched.
KLOG_HOOK="$KLOG_REPO/.claude/hooks/guard.sh"
KLOG_HOOK_IN='{"tool_name":"Bash","tool_input":{"command":"sed -i s/a/b/ conformance/verify.sh"}}'
mkdir -p "$KLOG_REPO/.claude/hooks"
cp "$SELF_DIR/../.claude/hooks/guard.sh" "$SELF_DIR/../.claude/hooks/guard-core.sh" "$KLOG_REPO/.claude/hooks/" 2>/dev/null || :
if [ -f "$KLOG_HOOK" ] && command -v jq >/dev/null 2>&1; then
  # (a) logger DEAD (unwritable .kit-run): exactly one line of decision JSON, and it says deny.
  if [ "$(id -u 2>/dev/null || echo 1)" = "0" ]; then
    echo "SKIP log:   pretooluse unwritable-.kit-run cell — uid 0 ignores mode 000"
  else
    rm -rf "$KLOG_REPO/.kit-run"; mkdir -p "$KLOG_REPO/.kit-run"; chmod 000 "$KLOG_REPO/.kit-run" 2>/dev/null || :
    KLOG_HOOK_OUT=$( cd "$KLOG_REPO" && printf '%s' "$KLOG_HOOK_IN" | KIT_GUARD_LOG=1 sh "$KLOG_HOOK" 2>/dev/null || : )
    klog_check "pretooluse emits exactly one line with a dead logger" "$(printf '%s\n' "$KLOG_HOOK_OUT" | grep -c .)" "1"
    klog_check "pretooluse still DENIES with a dead logger" "$(printf '%s' "$KLOG_HOOK_OUT" | jq -r '.hookSpecificOutput.permissionDecision' 2>/dev/null)" "deny"
    chmod 755 "$KLOG_REPO/.kit-run" 2>/dev/null || :
  fi
  # (b) logger ALIVE: one log line, and it is attributed to the pretooluse surface.
  rm -rf "$KLOG_REPO/.kit-run"; mkdir -p "$KLOG_REPO/.kit-run"
  # ⚠️ KIT_GUARD_LOG=1 EXPLICITLY on both hook legs: the battery above `export`s it to 0, which the
  # hook inherits. Without this both legs were VACUOUS — the "unwritable" one chmod'd a directory a
  # disabled logger was never going to touch, and printed green. Measured.
  KLOG_HOOK_OUT=$( cd "$KLOG_REPO" && printf '%s' "$KLOG_HOOK_IN" | KIT_GUARD_LOG=1 sh "$KLOG_HOOK" 2>/dev/null || : )
  klog_check "pretooluse writes exactly one log line" "$( (wc -l < "$KLOG_FILE" 2>/dev/null || echo 0) | tr -d ' ')" "1"
  klog_check "pretooluse line carries surface=pretooluse" "$(sed -n 's/.*"surface":"\([^"]*\)".*/\1/p' "$KLOG_FILE" 2>/dev/null)" "pretooluse"
  klog_check "pretooluse line carries the tool name" "$(sed -n 's/.*"tool":"\([^"]*\)".*/\1/p' "$KLOG_FILE" 2>/dev/null)" "Bash"
else
  echo "SKIP log:   pretooluse cells — guard.sh or jq unavailable"
fi

# 6. `--denials` reports the right counts over a KNOWN 3-line fixture (2 read-shaped, 2 sessions).
KLOG_FIX="$KLOG_TMP/fixture.ndjson"
cat > "$KLOG_FIX" <<'KLOG_FIXTURE_EOF'
{"ts":"2026-08-29T01:00:00Z","surface":"kit-guard","tool":"Bash","arm":"13","trigger":"pathhit","segment":"grep -n a conformance/verify.sh","read_shaped":1,"session":"s1"}
{"ts":"2026-08-29T02:00:00Z","surface":"pretooluse","tool":"Bash","arm":"13","trigger":"-","segment":"sed -n 1,5p hooks/pre-push","read_shaped":1,"session":"s1"}
{"ts":"2026-08-29T03:00:00Z","surface":"pretooluse","tool":"Write","arm":"13","trigger":"redir-nonliteral","segment":"rm -rf conformance","read_shaped":0,"session":"s2"}
KLOG_FIXTURE_EOF
KLOG_OUT=$(sh "$KG_SELF" --denials --file "$KLOG_FIX" 2>&1) || klog_bad "--denials exits 0"
klog_check "--denials total"        "$(printf '%s' "$KLOG_OUT" | sed -n 's/^kit-guard --denials: \([0-9]*\) denial.*/\1/p')" "3"
klog_check "--denials read-shaped"  "$(printf '%s' "$KLOG_OUT" | sed -n 's/.*read-shaped.*: \([0-9]*\) of 3/\1/p')" "2"
klog_check "--denials lists the read-shaped segments" "$(printf '%s\n' "$KLOG_OUT" | grep -c '^    \[')" "2"
klog_check "--denials per-trigger pathhit"  "$(printf '%s\n' "$KLOG_OUT" | sed -n 's/^    pathhit  *\([0-9]*\)$/\1/p')" "1"
klog_check "--denials per-session s1"       "$(printf '%s\n' "$KLOG_OUT" | sed -n 's/^    s1  *\([0-9]*\)$/\1/p')" "2"
klog_check "--denials --since filters"      "$(sh "$KG_SELF" --denials --file "$KLOG_FIX" --since 2026-08-29T02:00:00Z 2>&1 | sed -n 's/^kit-guard --denials: \([0-9]*\) denial.*/\1/p')" "2"
klog_check "--denials --last filters"       "$(sh "$KG_SELF" --denials --file "$KLOG_FIX" --last 1 2>&1 | sed -n 's/^kit-guard --denials: \([0-9]*\) denial.*/\1/p')" "1"
# A malformed line is REPORTED, never silently dropped (a summary that hides what it could not read
# would let a corrupted log look like a quiet one — the exact failure the instrument exists to avoid).
printf 'not json at all\n' >> "$KLOG_FIX"
klog_check "--denials reports malformed lines" "$(sh "$KG_SELF" --denials --file "$KLOG_FIX" 2>&1 | sed -n 's/.*(+\([0-9]*\) malformed.*/\1/p')" "1"
klog_check "--denials on an absent log is 0, not an error" "$(sh "$KG_SELF" --denials --file "$KLOG_TMP/nope.ndjson" 2>&1 | grep -c '0 denials recorded')" "1"
klog_cleanup; trap - EXIT INT TERM

[ "$fail" -eq 0 ] && { echo "OK: kit-guard denies the battery through the CLI"; exit 0; } || { echo "FAIL: kit-guard selftest"; exit 1; }
