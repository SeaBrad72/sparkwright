{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin feature/*:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(sh conformance/*:*)",
      "Bash(sh scripts/promotion-verify.sh record:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(brew install:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(npm publish:*)",
      "WebFetch",
      "Edit(.env)",
      "Edit(/.claude/**)",
      "Edit(/hooks/**)",
      "Edit(/.kit/**)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.git/hooks/**)",
      "Edit(./.git/config)",
      "Edit(./.git/modules/*/hooks/**)",
      "Edit(./.git/modules/*/config)",
      "Edit(./.git/config.worktree)",
      "Edit(./.mcp.json)",
      "Edit(./.vscode/**)",
      "Edit(./.idea/**)",
      "Edit(./**/.envrc)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude.json)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/commands/**)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/plugins/**)",
      "Edit(~/Library/LaunchAgents/**)",
      "Edit(~/.config/systemd/user/**)",
      "Edit(~/.config/autostart/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zshenv)",
      "Edit(~/.zprofile)",
      "Edit(~/.zlogin)",
      "Edit(~/.zlogout)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.bash_login)",
      "Edit(~/.bash_logout)",
      "Edit(~/.profile)",
      "Edit(~/.config/fish/**)",
      "Edit(~/.inputrc)",
      "Edit(~/.gitconfig)",
      "Edit(~/.config/git/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/.config/direnv/**)",
      "Edit(~/.cargo/env)",
      "Edit(~/.cargo/bin/**)",
      "Edit(~/go/bin/**)",
      "Edit(~/.rustup/toolchains/**)",
      "Edit(~/.cache/pre-commit/**)",
      "Edit(~/.cache/p10k-*)",
      "Edit(~/.cache/gitstatus/**)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./**/secrets/**)",
      "Read(./**/secret/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.config/op/**)",
      "Read(~/.password-store/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.claude/settings.json)",
      "Read(~/.claude/settings.local.json)",
      "Read(~/.claude/settings.json.*)",
      "Read(~/.claude/settings.local.json.*)",
      "Read(~/.sparkwright-canary/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com"
      ],
      "allowLocalBinding": false,
      "allowUnixSockets": []
    },
    "filesystem": {
      "allowWrite": [
        "/private/tmp",
        "/tmp",
        "/private/var/folders",
        "/var/folders",
        "~/.npm",
        "~/.cache",
        "~/go",
        "~/.gradle",
        "~/.m2",
        "~/.cargo",
        "~/.rustup",
        "~/.nuget",
        "~/Library/Caches"
      ],
      "denyWrite": [
        "./.claude",
        "./hooks",
        "./.kit",
        "./.git/hooks",
        "./.git/config",
        "./.git/modules/*/hooks",
        "./.git/modules/*/config",
        "./.git/config.worktree",
        "./.mcp.json",
        "./.vscode",
        "./.idea",
        "./.claude/settings.local.json",
        "**/.envrc",
        "~/.claude/settings.json",
        "~/.claude/settings.local.json",
        "~/.claude.json",
        "~/.claude/hooks",
        "~/.claude/agents",
        "~/.claude/skills",
        "~/.claude/commands",
        "~/.claude/CLAUDE.md",
        "~/.claude/plugins",
        "~/Library/LaunchAgents",
        "~/.config/systemd/user",
        "~/.config/autostart",
        "~/.zshrc",
        "~/.zshenv",
        "~/.zprofile",
        "~/.zlogin",
        "~/.zlogout",
        "~/.bashrc",
        "~/.bash_profile",
        "~/.bash_login",
        "~/.bash_logout",
        "~/.profile",
        "~/.config/fish",
        "~/.inputrc",
        "~/.gitconfig",
        "~/.config/git",
        "~/.ssh",
        "~/.config/direnv",
        "~/.cargo/env",
        "~/.cargo/bin",
        "~/go/bin",
        "~/.rustup/toolchains",
        "~/.cache/pre-commit",
        "~/.cache/p10k-*",
        "~/.cache/gitstatus"
      ],
      "denyRead": [
        "**/.env",
        "**/.env.*",
        "**/*.pem",
        "**/*.key",
        "**/id_rsa*",
        "**/secrets/**",
        "**/secret/**",
        "~/.ssh",
        "~/.aws",
        "~/.config/gcloud",
        "~/.azure",
        "~/.kube",
        "~/.docker/config.json",
        "~/.netrc",
        "~/.git-credentials",
        "~/.npmrc",
        "~/.pypirc",
        "~/.config/op",
        "~/.password-store",
        "~/.gnupg",
        "~/.claude/.credentials.json",
        "~/.claude.json",
        "~/.claude/settings.json",
        "~/.claude/settings.local.json",
        "~/.claude/settings.json.*",
        "~/.claude/settings.local.json.*",
        "~/.sparkwright-canary"
      ],
      "allowRead": [
        "**/.env.example",
        "**/.env.sample"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "[ -r \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\" ] && sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\" || { rc=$?; [ \"$rc\" = 2 ] || printf '%s\\n' \"agent-guard: the guard hook did not return a decision (rc $rc) - blocked; stop and tell the human (usual cause: the session was not started in the repository root; see docs/operations/runtime-guards.md, Is the guard loaded?)\" >&2; exit 2; }" }
        ]
      }
    ]
  }
}
